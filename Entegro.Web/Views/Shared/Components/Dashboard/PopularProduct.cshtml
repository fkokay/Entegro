@model PopularProductViewModel

<div class="col-md-12 col-xl-12 mb-4">
    <div class="card h-100">
        <div class="card-header d-flex justify-content-between">
            <div class="card-title m-0 me-2">
                <h5 class="m-0 me-2">Popüler Ürünler</h5>
                <small class="text-muted">Toplam 10,4 bin Ziyaretçi</small>
            </div>
            <div class="dropdown">
                <button class="btn p-0"
                        type="button"
                        id="popularProduct"
                        data-bs-toggle="dropdown"
                        aria-haspopup="true"
                        aria-expanded="false">
                    <i class="ti ti-dots-vertical ti-sm text-muted"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="popularProduct">
                    <a class="dropdown-item" href="javascript:void(0);">Aylık</a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <ul class="p-0 m-0">
                @foreach (var item in Model.Products)
                {
                    <li class="d-flex mb-4 pb-1">
                        <div class="me-3">
                            <img src="@(item.MainPicture != null ? item.MainPicture.Url : "/images/default.png")"
                                 alt="User"
                                 class="rounded"
                                 width="46" />
                        </div>
                        <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                                <h6 class="mb-0">@item.Name</h6>
                                <small class="text-muted d-block">Kodu: @item.Code</small>
                            </div>
                            <div class="user-progress d-flex align-items-center gap-1">
                                <p class="mb-0 fw-semibold">
                                    @string.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:N2} ₺", item.Price)
                                </p>
                            </div>

                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>