@model StatisticsViewModel

<div class="col-xl-8 mb-4 col-lg-7 col-12">
    <div class="card h-100">
        <div class="card-header">
            <div class="d-flex justify-content-between mb-3">
                <h5 class="card-title mb-0">İstatistikler</h5>
                <small class="text-muted">1 ay önce güncellendi</small>
            </div>
        </div>
        <div class="card-body">
            <div class="row gy-3">
                <div class="col-md-3 col-6">
                    <div class="d-flex align-items-center">
                        <div class="badge rounded-pill bg-label-primary me-3 p-2">
                            <i class="ti ti-chart-pie-2 ti-sm"></i>
                        </div>
                        <div class="card-info">
                            <h5 class="mb-0"> @string.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:N2} ₺", Model.TotalOrderPrice)</h5>
                            <small>Satış</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="d-flex align-items-center">
                        <div class="badge rounded-pill bg-label-info me-3 p-2">
                            <i class="ti ti-users ti-sm"></i>
                        </div>
                        <div class="card-info">
                            <h5 class="mb-0">@Model.CustomerCount</h5>
                            <small>Müşteriler</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="d-flex align-items-center">
                        <div class="badge rounded-pill bg-label-danger me-3 p-2">
                            <i class="ti ti-shopping-cart ti-sm"></i>
                        </div>
                        <div class="card-info">
                            <h5 class="mb-0">@Model.ProductCount</h5>
                            <small>Ürünler</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="d-flex align-items-center">
                        <div class="badge rounded-pill bg-label-success me-3 p-2">
                            <i class="ti ti-currency-dollar ti-sm"></i>
                        </div>
                        <div class="card-info">
                            <h5 class="mb-0">@Model.CompleteOrderStatusCount</h5>
                            <small>Teslim Edilen Sipariş Sayısı</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>