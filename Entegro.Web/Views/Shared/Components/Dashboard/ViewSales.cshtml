@model ViewSalesViewModel
<div class="col-xl-4 mb-4 col-lg-5 col-12">
    <div class="card">
        <div class="d-flex align-items-end row">
            <div class="col-7">
                <div class="card-body text-nowrap">
                    <h5 class="card-title mb-0">Congratulations John! 🎉</h5>
                    <p class="mb-2"></p>
                    <h4 class="text-primary mb-1"> @string.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:N2} ₺", Model.TotalOrderPrice)</h4>
                    <a href="/Order/List?orderStatusId=4" class="btn btn-primary">Satış Detay Gör</a>
                </div>
            </div>
            <div class="col-5 text-center text-sm-left">
                <div class="card-body pb-0 px-0 px-md-4">
                    <img src="../../assets/img/illustrations/card-advance-sale.png"
                         height="140"
                         alt="view sales" />
                </div>
            </div>
        </div>
    </div>
</div>