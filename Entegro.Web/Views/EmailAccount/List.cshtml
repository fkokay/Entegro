@{
    ViewData["Title"] = "Mail Entegrasyonu";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="card">
        <div class="row card-header flex-column flex-md-row border-bottom mx-0 px-3">
            <div class="d-md-flex justify-content-between align-items-center dt-layout-start col-md-auto me-auto mt-0">
                <h5 class="card-title mb-0 text-md-start text-center pb-md-0 pb-6">Mail Entegrasyonu</h5>
            </div>
            <div class="d-md-flex justify-content-between align-items-center dt-layout-end col-md-auto ms-auto mt-0"></div>
        </div>
        <div class="card-datatable table-responsive">
            <table id="EmailAccountTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                <thead>
                    <tr>
                        <th></th>
                        <th>Id</th>
                        <th>E-posta Adresi</th>
                        <th>E-mail görüntüleme adı</th>
                        <th>Host</th>
                        <th>Port</th>
                        <th>Kullanıcı</th>
                        <th>Varsayılan e-posta hesabıdır</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>



@section Scripts {
    <script src="/assets/js/entegro.mailaccount.list.js"></script>
    <script>
        $(function () {
            Entegro.emailaccount.list.init();
        });
    </script>
}
