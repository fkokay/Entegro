@model EmailAccountModel
@{
    ViewData["Title"] = "Mail Entegrasyon Bilgisi";
}


<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="Edit" id="emailaccount-form">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">Entegrasyon bilgilerini düzenle</h4>
                <p class="mb-0">Entegrasyon bilgilerini düzenle</p>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("List")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                    <button type="button" id="btnDeleteAccount"  class="btn btn-danger d-grid w-100 waves-effect waves-light">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-trash ti-xs me-1"></i> Sil
                        </span>
                    </button>
                </div>
                <button type="submit" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>

        <div class="row">
            <partial name="_CreateOrUpdate" />
        </div>
    </form>
</div>

@section Scripts {
    <script src="/assets/js/entegro.mailaccount.js"></script>
    <script>
        $(function () {

            Entegro.emailaccount.initUpdateForm({
                formSelector: '#emailaccount-form',
                postUrl: '@Url.Action("Edit", "EmailAccount")',
                redirectUrl: '@Url.Action("List", "EmailAccount")'
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#btnDeleteAccount').on('click', function () {
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu kayıt silinecek.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Evet, sil!',
                    cancelButtonText: 'Hayır, iptal et',
                    customClass: {
                        confirmButton: 'btn btn-danger me-2',
                        cancelButton: 'btn btn-secondary'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("Delete", "EmailAccount")',
                            type: 'POST',
                            data: { id: @Model.Id },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire({
                                        title: 'Silindi!',
                                        text: 'Kayıt başarıyla silindi.',
                                        icon: 'success',
                                        confirmButtonText: 'Tamam',
                                        customClass: {
                                            confirmButton: 'btn btn-success'
                                        },
                                        buttonsStyling: false
                                    }).then(() => {
                                        window.location.href = '@Url.Action("List", "EmailAccount")';
                                    });
                                } else {
                                    Swal.fire({
                                        title: 'Hata!',
                                        text: response.message || 'Silme işlemi başarısız oldu.',
                                        icon: 'error',
                                        confirmButtonText: 'Tamam',
                                        customClass: {
                                            confirmButton: 'btn btn-danger'
                                        },
                                        buttonsStyling: false
                                    });
                                }
                            },
                            error: function (xhr) {
                                Swal.fire({
                                    title: 'Hata!',
                                    text: xhr.responseText || 'İşlem sırasında bir hata oluştu.',
                                    icon: 'error',
                                    confirmButtonText: 'Tamam',
                                    customClass: {
                                        confirmButton: 'btn btn-danger'
                                    },
                                    buttonsStyling: false
                                });
                            }
                        });
                    }
                });
            });
        });
    </script>

}
