@model MarketplaceListViewModel
@{
    ViewData["Title"] = "Pazaryeri Entegrasyonları";
    var logoUrls = new Dictionary<string, string>
    {
        { "Smartstore", "https://smartstore.com/Themes/HP/images/smartstore-logo-black.svg" },
        { "Trendyol", "https://cdn.dsmcdn.com/web/logo/ty-web.svg" },
        { "N11", "https://n11scdn.akamaized.net/a1/org/25/03/18/89/65/01/31/94/13/25/13/93/66889250221518075393.svg" },
        { "Pazarama", "https://pazarama.zendesk.com/hc/theming_assets/01HZM66YT318FSGD6MQKD8N1W2" },
        { "Idefix", "https://images.idefix.com/mpstatics/banner/test-67bdca5fb68de.svg" },
        { "CicekSepeti", "https://cdn03.ciceksepeti.com/Themes/Ciceksepeti/Assets/images/ciceksepeti-logo-146.png" },
        { "HepsiBurada", "https://images.seeklogo.com/logo-png/44/1/hepsiburada-logo-png_seeklogo-442312.png" },
    };
}

<div class="flex-grow-1 container-p-y container-fluid">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light"></span> Pazaryeri Entegrasyonu Ekle</h4>
    <div class="row">
        <div class="col-3">
            <div class="card mb-3">
                <div class="row g-0">
                    <div class="col-md-4 d-flex align-items-center justify-content-center">
                        <img class="card-img card-img-left w-75" src="https://cdn.dsmcdn.com/web/logo/ty-web.svg" alt="Card image">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">Trendyol</h5>
                            <p class="card-text">
                                Trendyol yazılım ürünleri ile entegre çalışabilmektedir.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row p-3">
                    <div class="mb-0">
                        <button type="button" class="btn btn-success w-100" onclick="Entegro.marketplace.SelectMarketplace('Trendyol')">
                            <i class="ti ti-plus me-1"></i>
                            <span class="align-middle"> Entegrasyon Ekle</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card mb-3">
                <div class="row g-0">
                    <div class="col-md-4 d-flex align-items-center justify-content-center">
                        <img class="card-img card-img-left w-75" src="https://pazarama.zendesk.com/hc/theming_assets/01HZM66YT318FSGD6MQKD8N1W2" alt="Card image">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">Pazarama</h5>
                            <p class="card-text">
                                Pazarama yazılım ürünleri ile entegre çalışabilmektedir.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row p-3">
                    <div class="mb-0">
                        <button type="button" class="btn btn-success w-100" onclick="Entegro.marketplace.SelectMarketplace('Pazarama')">
                            <i class="ti ti-plus me-1"></i>
                            <span class="align-middle"> Entegrasyon Ekle</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card mb-3">
                <div class="row g-0">
                    <div class="col-md-4 d-flex align-items-center justify-content-center">
                        <img class="card-img card-img-left w-75" src="https://n11scdn.akamaized.net/a1/org/25/03/18/89/65/01/31/94/13/25/13/93/66889250221518075393.svg" alt="Card image">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">N11</h5>
                            <p class="card-text">
                                N11 yazılım ürünleri ile entegre çalışabilmektedir.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row p-3">
                    <div class="mb-0">
                        <button type="button" class="btn btn-success w-100" onclick="Entegro.marketplace.SelectMarketplace('N11')">
                            <i class="ti ti-plus me-1"></i>
                            <span class="align-middle"> Entegrasyon Ekle</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card mb-3">
                <div class="row g-0">
                    <div class="col-md-4 d-flex align-items-center justify-content-center">
                        <img class="card-img card-img-left w-75" src="https://images.idefix.com/mpstatics/banner/test-67bdca5fb68de.svg" alt="Card image">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">Idefix</h5>
                            <p class="card-text">
                                Idefix yazılım ürünleri ile entegre çalışabilmektedir.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row p-3">
                    <div class="mb-0">
                        <button type="button" class="btn btn-success w-100" onclick="Entegro.marketplace.SelectMarketplace('Idefix')">
                            <i class="ti ti-plus me-1"></i>
                            <span class="align-middle"> Entegrasyon Ekle</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card mb-3">
                <div class="row g-0">
                    <div class="col-md-4 d-flex align-items-center justify-content-center">
                        <img class="card-img card-img-left w-75" src="https://cdn03.ciceksepeti.com/Themes/Ciceksepeti/Assets/images/ciceksepeti-logo-146.png" alt="Card image">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">Çiçek Sepeti</h5>
                            <p class="card-text">
                                Çiçek Sepeti yazılım ürünleri ile entegre çalışabilmektedir.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row p-3">
                    <div class="mb-0">
                        <button type="button" class="btn btn-success w-100" onclick="Entegro.marketplace.SelectMarketplace('CicekSepeti')">
                            <i class="ti ti-plus me-1"></i>
                            <span class="align-middle"> Entegrasyon Ekle</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card mb-3">
                <div class="row g-0">
                    <div class="col-md-4 d-flex align-items-center justify-content-center">
                        <img class="card-img card-img-left w-75" src="https://images.seeklogo.com/logo-png/32/2/hepsiburada-com-logo-png_seeklogo-326595.png" alt="Card image">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">HepsiBurada</h5>
                            <p class="card-text">
                                HepsiBurada yazılım ürünleri ile entegre çalışabilmektedir.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row p-3">
                    <div class="mb-0">
                        <button type="button" class="btn btn-success w-100" onclick="Entegro.marketplace.SelectMarketplace('HepsiBurada')">
                            <i class="ti ti-plus me-1"></i>
                            <span class="align-middle"> Entegrasyon Ekle</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model != null)
    {
        <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light"></span> Pazaryeri Entegrasyonlarım</h4>
        <div class="row">
            @foreach (var marketPlace in Model.MarketplaceList)
            {
                if (!logoUrls.ContainsKey(marketPlace.MarketplaceType))
                {
                    continue;
                }

                var logoUrl = logoUrls[marketPlace.MarketplaceType];
                <div class="col-4">
                    <div class="card mb-3">
                        <div class="row g-0">
                            <div class="col-md-4 d-flex align-items-center justify-content-center">
                                <img class="card-img card-img-left w-75" src="@logoUrl" alt="Card image">
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">@marketPlace.Name</h5>
                                    <p class="card-text">
                                        @marketPlace.Description
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="row p-3">
                            <div class="mb-0 d-flex">
                                <a type="button" asp-action="MarketplaceSettings" asp-asp-controller="Settings" asp-route-integrationSystemId="@marketPlace.Id" class="btn btn-success waves-effect waves-light w-50">
                                    <i class="ti ti-settings me-1"></i>
                                    <span class="align-middle">Ayarla</span>
                                </a>
                                <a href="javascript:void(0);" type="button" onclick="Entegro.marketplace.iptalEt(@marketPlace.Id)" class="btn btn-danger waves-effect waves-light w-50 ms-2">
                                    <i class="ti ti-eraser me-1"></i>
                                    <span class="align-middle">Sil</span>
                                </a>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@await Html.PartialAsync("_MarketplaceAdd", new MarketplaceIntegrationSystemViewModel())

@section Scripts {
    <script src="/assets/js/entegro.marketplace.js" asp-append-version="true"></script>
    <script>

        $(function () {
            Entegro.marketplace.initFormSubmit();
        });
    </script>
}