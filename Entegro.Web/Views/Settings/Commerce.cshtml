@model CommerceListModel
@{
    ViewData["Title"] = "E-Ticaret Entegrasyonları";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light"></span> E-Ticaret Entegrasyonu Ekle</h4>
    <div class="row">
        <div class="col-4">
            <div class="card mb-3">
                <div class="row g-0">
                    <div class="col-md-4 d-flex align-items-center justify-content-center">
                        <img class="card-img card-img-left w-75" src="https://smartstore.com/Themes/HP/images/smartstore-logo-black.svg" alt="Card image">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">Smartstore</h5>
                            <p class="card-text">
                                Smartstore yazılım ürünleri ile entegre çalışabilmektedir.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row p-3">
                    <div class="mb-0">
                        <button type="button" class="btn btn-success w-100" onclick="Entegro.commerce.SelectCommerce('Smartstore')">
                            <i class="ti ti-plus me-1"></i>
                            <span class="align-middle"> Entegrasyon Ekle</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.CommerceList != null)
    {
        <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light"></span> E-Ticaret Entegrasyonlarım</h4>
        <div class="row">
            @foreach (var commerce in Model.CommerceList)
            {
                <div class="col-4">
                    <div class="card mb-3">
                        <div class="row g-0">
                            <div class="col-md-4 d-flex align-items-center justify-content-center">
                                <img class="card-img card-img-left w-75" src="https://smartstore.com/Themes/HP/images/smartstore-logo-black.svg" alt="Card image">
                            </div>

                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">@commerce.Name</h5>
                                    <p class="card-text mb-0">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span>@commerce.Description</span>
                                            <input class="form-check-input" type="checkbox" @(commerce.Active ? "checked" : "") title="Yayında" disabled>
                                        </div>
                                    </p>
                                </div>
                            </div>

                           
                        </div>
                        <div class="row p-3">
                            <div class="mb-0 d-flex">
                                <a asp-action="CommerceSettings" asp-asp-controller="Settings" asp-route-integrationSystemId="@commerce.Id" class="btn btn-success waves-effect waves-light w-50">
                                    <i class="ti ti-settings me-1"></i>
                                    <span class="align-middle">Ayarla</span>
                                </a>
                                <a href="javascript:void(0);" onclick="Entegro.commerce.iptalEt(@commerce.Id)" class="btn btn-danger waves-effect waves-light w-50 ms-2">
                                    <i class="ti ti-eraser me-1"></i>
                                    <span class="align-middle">Sil</span>
                                </a>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>


@await Html.PartialAsync("_CommerceAdd", new CommerceIntegrationSystemModel())

@section Scripts {
    <script src="/assets/js/entegro.commerce.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.commerce.initFormSubmit();
        });
    </script>

}