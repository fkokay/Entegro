@model CicekSepetiMarketplaceSettingsModel
@{
    ViewData["Title"] = "ÇiçekSepeti Pazaryeri Entegrasyonu Ayarları";
}


<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="MarketplaceParameterCicekSepeti" id="marketplace-setting-ciceksepeti-form">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">@ViewData["Title"]</h4>
                <p class="mb-0">@ViewData["Title"]</p>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("Marketplace", "settings")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                </div>
                <button type="button" id="connectionTestBtn" onclick="connectionTest()" class="btn btn-success d-grid waves-effect waves-light">
                    <span class="d-flex align-items-center justify-content-center text-nowrap">
                        <i class="ti ti-flag ti-xs me-1"></i>Test Et
                    </span>
                </button>
                <button type="submit" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>
        @Html.HiddenFor(m => m.IntegrationSystemId)
        @Html.HiddenFor(m => m.MarketplaceType)
        @Html.HiddenFor(m => m.IntegrationSystemTypeId)
        @Html.HiddenFor(m => m.Id)

        <div class="row">
            <div class="col-lg-12 col-12 mb-lg-0 mb-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Mağaza Bilgileri</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-6">
                            <label class="form-label" for="basic-default-fullname">Adı</label>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                        </div>
                        <div class="mb-6">
                            <label class="form-label" for="basic-default-fullname">Açıklaması</label>
                            @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <h4 class="fw-bold py-3 mb-4 mt-3"><span class="text-muted fw-light"></span>Ayarlar</h4>
            <div class="col-lg-12 col-12 mb-lg-0 mb-4">
                <div class="card">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Pazaryeri Entegrasyon Ayarları</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-6">
                                <label class="form-label" for="basic-default-fullname">API Kullanıcı Adı</label>
                                @Html.TextBoxFor(m => m.ApiUser, new { @class = "form-control", required = "required" })
                            </div>
                            <div class="mb-6">
                                <label class="form-label" for="basic-default-fullname">Satıcı Numarası </label>
                                @Html.TextBoxFor(m => m.SupplierId, new { @class = "form-control", required = "required" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>