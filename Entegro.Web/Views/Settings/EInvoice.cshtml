@model EInvoiceListModel
@{
    ViewData["Title"] = "E-Ticaret Entegrasyonları";
    var logoUrls = new Dictionary<string, string>
    {
        { "TrendyolEFaturam", "https://magenty.com/wp-content/uploads/trendyol-e-faturam-768x512.jpg" },
        { "QNB E-Finans", "https://www.qnbesolutions.com.tr/Content/images/logos/logo.svg" },
    };
}

<div class="flex-grow-1 container-p-y container-fluid">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light"></span> E-Fatura Ekle</h4>
    <div class="row">
        <div class="col-3">
            <div class="card mb-3">
                <div class="row g-0">
                    <div class="col-md-4 d-flex align-items-center justify-content-center">
                        <img class="card-img card-img-left w-75" src="https://magenty.com/wp-content/uploads/trendyol-e-faturam-768x512.jpg" alt="Card image">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">Trendyol E-Faturam</h5>
                            <p class="card-text">
                                Trendyol E-Faturam yazılım ürünleri ile entegre çalışabilmektedir.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row p-3">
                    <div class="mb-0">
                        <button type="button" class="btn btn-success w-100" onclick="Entegro.einvoice.SelectEInvoice('TrendyolEFaturam')">
                            <i class="ti ti-plus me-1"></i>
                            <span class="align-middle"> Entegrasyon Ekle</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card mb-3">
                <div class="row g-0">
                    <div class="col-md-4 d-flex align-items-center justify-content-center">
                        <img class="card-img card-img-left w-75" src="https://www.qnbesolutions.com.tr/Content/images/logos/logo.svg" alt="Card image">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title">QNB E-Finans</h5>
                            <p class="card-text">
                                QNB E-Finans yazılım ürünleri ile entegre çalışabilmektedir.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="row p-3">
                    <div class="mb-0">
                        <button type="button" class="btn btn-success w-100" onclick="Entegro.einvoice.SelectEInvoice('QNB E-Finans')">
                            <i class="ti ti-plus me-1"></i>
                            <span class="align-middle"> Entegrasyon Ekle</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.EInvoiceList != null)
    {
        <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light"></span> E-Faturalarım</h4>
        <div class="row">
            @foreach (var invoice in Model.EInvoiceList)
            {
                if (!logoUrls.ContainsKey(invoice.EInvoiceType))
                {
                    continue;
                }

                var logoUrl = logoUrls[invoice.EInvoiceType];

                <div class="col-3">
                    <div class="card mb-3">
                        <div class="row g-0">
                            <div class="col-md-4 d-flex align-items-center justify-content-center">
                                <img class="card-img card-img-left w-75" src="@logoUrl" alt="Card image">
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">@invoice.Name</h5>
                                    <p class="card-text">
                                        @invoice.Description
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="row p-3">
                            <div class="mb-0 d-flex">
                                <a type="button" asp-action="EInvoiceSettings" asp-asp-controller="Settings" asp-route-integrationSystemId="@invoice.Id" class="btn btn-success waves-effect waves-light w-50">
                                    <i class="ti ti-settings me-1"></i>
                                    <span class="align-middle">Ayarla</span>
                                </a>
                                <a href="javascript:void(0);" type="button" onclick="Entegro.einvoice.iptalEt(@invoice.Id)" class="btn btn-danger waves-effect waves-light w-50 ms-2">
                                    <i class="ti ti-eraser me-1"></i>
                                    <span class="align-middle">Sil</span>
                                </a>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@await Html.PartialAsync("_EInvoiceAdd", new EInvoiceIntegrationSystemModel())

@section Scripts {

    <script src="/assets/js/entegro.einvoice.js" asp-append-version="true"></script>
    <script>
                $(function () {
            Entegro.einvoice.initFormSubmit();
        });
    </script>



}