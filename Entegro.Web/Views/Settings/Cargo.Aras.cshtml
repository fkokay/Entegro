@using Entegro.Web.Models.Integration.Cargo
@model ArasCargoSettingsModel
@{
    ViewData["Title"] = "Aras Kargo Entegrasyonu Ayarları";
}
<div class="flex-grow-1 container-p-y container-fluid">

    <form asp-action="CargoParameterAras" id="cargo-setting-aras-form">
        @Html.HiddenFor(m => m.IntegrationSystemId)
        @Html.HiddenFor(m => m.CargoType)
        @Html.HiddenFor(m => m.IntegrationSystemTypeId)
        @Html.HiddenFor(m => m.Id)

        <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light"></span> @ViewData["Title"]</h4>
        <div class="row">
            <div class="col-lg-9 col-12 mb-lg-0 mb-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Mağaza Bilgileri</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-6">
                            <label class="form-label" for="basic-default-fullname">Adı</label>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                        </div>
                        <div class="mb-6">
                            <label class="form-label" for="basic-default-fullname">Açıklaması</label>
                            @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-12 cargo-setting-aras-actions">
                <div class="card mb-4">
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary d-grid w-100 mb-2 waves-effect waves-light">
                            <span class="d-flex align-items-center justify-content-center text-nowrap"><i class="ti ti-check ti-xs me-1"></i>Kaydet</span>
                        </button>
                        <a href="/settings/cargo" class="btn btn-label-secondary d-grid w-100 waves-effect">İptal Et</a>
                    </div>
                </div>
            </div>
        </div>

        <h4 class="fw-bold py-3 mb-4 mt-3"><span class="text-muted fw-light"></span>Ayarlar</h4>
        <div class="row">
            <div class="col-lg-9 col-12 mb-lg-0 mb-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Kargo Entegrasyon Ayarları</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-6">
                            <label class="form-label" for="basic-default-fullname">Kullanıcı Adı</label>
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", required = "required" })
                        </div>
                        <div class="mb-6">
                            <label class="form-label" for="basic-default-fullname">Şifre</label>
                            @Html.TextBoxFor(m => m.Password, new { @class = "form-control", required = "required" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
       
    </form>
</div>



