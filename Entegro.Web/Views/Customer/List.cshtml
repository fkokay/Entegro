@{
    ViewData["Title"] = "Müşteriler";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="card">
        <div class="row card-header flex-column flex-md-row border-bottom mx-0 px-3">
            <div class="d-md-flex justify-content-between align-items-center dt-layout-start col-md-auto me-auto mt-0">
                <h5 class="card-title mb-0 text-md-start text-center pb-md-0 pb-6">Müşteriler</h5>
            </div>
            <div class="d-md-flex justify-content-between align-items-center dt-layout-end col-md-auto ms-auto mt-0"></div>
        </div>

        <div class="card-datatable table-responsive">
            <table id="CustomerTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                <thead>
                    <tr>
                        <th></th>
                        <th>Id</th>
                        <th>Ünvanı</th>
                        <th>E-Posta</th>
                        <th>Kayıt tarihi</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>


<div class="modal fade" id="addressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="addressModalContent">
        </div>
    </div>
</div>


@section Scripts {
    <script src="/assets/js/entegro.customer.list.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.customer.list.init();
        });
    </script>
}
