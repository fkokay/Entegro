@model CustomerModel

<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="Edit" id="customer-form">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">Müşteri Bilgileri Düzenle</h4>
                <p class="mb-0">Müşteri Bilgileri Düzenle</p>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("List")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                    <button type="button" id="btnDeleteCustomer" class="btn btn-danger d-grid w-100 waves-effect waves-light">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-trash ti-xs me-1"></i> Sil
                        </span>
                    </button>
                </div>
                <button type="submit" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>

        <div class="row">
            <partial name="_CreateOrUpdate" />
        </div>
    </form>
</div>

<div class="modal fade" id="createAddressModal" tabindex="-1" aria-labelledby="createAddressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-center">Yeni Adres Oluştur</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="createAddressModalBody">
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="/assets/js/entegro.customer.js"></script>
    <script>
        $(function () {
            Entegro.customer.initUpdateForm({
                formSelector: '#customer-form',
                postUrl: '/Customer/Edit',
                redirectUrl: '/Customer/List'
            });

             Entegro.customer.initDeleteCustomer({
                deleteUrl: '/Customer/Delete',
                redirectUrl: '/Customer/List',
                id: '@Model.Id'
            });

       
           var customerId = @Model.Id;
             if (customerId > 0) {
                 Entegro.customer.loadCustomerAddresses(customerId, '#customer-address-container');
             }

              Entegro.customer.initDeleteAddress();
             Entegro.customer.initCreateAddressModal();
        });

    </script>
   

    
}