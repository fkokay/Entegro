@model CustomerModel

<div class="col-lg-12 col-12 mb-lg-0 mb-4">
    <div class="card mb-3">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" id="customer-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#customer-general" type="button" role="tab">Müşteri Bilgileri</button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#customer-address" type="button" role="tab">
                        Müşteri Adresleri
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="customer-general" role="tabpanel">
                <div class="row g-3 p-3">
                    @Html.HiddenFor(m => m.Id)

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Name">Ad Soyad / Şirket Adı</label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @id = "Name" })

                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Email">Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @type = "email", @id = "Email" })

                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="PhoneNumber">Telefon</label>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", @id = "PhoneNumber" })

                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="City">Şehir</label>
                        @Html.TextBoxFor(m => m.City, new { @class = "form-control", @id = "City" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="District">İlçe</label>
                        @Html.TextBoxFor(m => m.District, new { @class = "form-control", @id = "District" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Town">Mahalle</label>
                        @Html.TextBoxFor(m => m.Town, new { @class = "form-control", @id = "Town" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Street">Cadde / Sokak</label>
                        @Html.TextBoxFor(m => m.Street, new { @class = "form-control", @id = "Street" })
                    </div>

                    

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="CustomerType">Müşteri Tipi</label>
                        @Html.DropDownListFor(m => m.CustomerType, new SelectList(new[] {
                        new { Value = 0, Text = "Bireysel" },
                                                new { Value = 1, Text = "Kurumsal" }
                                                }, "Value", "Text"), new { @class = "form-control", @id = "CustomerType" })
                    </div>

                    <div class="col-md-6">
                        <div class="row">
                            <label class="form-label text-sm-start" for="TaxOffice">Vergi Dairesi</label>
                            <div class="">
                                @Html.TextBoxFor(m => m.TaxOffice, new { @class = "form-control", @id = "TaxOffice" })
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row">
                            <label class="form-label text-sm-start" for="TaxNumber">Vergi Numarası</label>
                            <div class="">
                                @Html.TextBoxFor(m => m.TaxNumber, new { @class = "form-control", @id = "TaxNumber" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label text-sm-start" for="Address">Adres</label>
                        @Html.TextAreaFor(m => m.Address, new { @class = "form-control", @id = "Address", rows = "3" })
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="customer-address" role="tabpanel">
                @if (Model.Id > 0)
                {
                    <div class="flex-grow-1 container-p-y container-fluid">
                        <div class="d-flex flex-column justify-content-center">
                            <h4 class="mb-3">Müşteri Adresleri</h4>
                        </div>
                        <div class="row card-header flex-column flex-md-row border-bottom mx-0 px-3">
                            <div class="d-md-flex justify-content-between align-items-center dt-layout-start col-md-auto me-auto mt-0">
                                <h5 class="card-title mb-0 text-md-start text-center pb-md-0 pb-6">Filtreler</h5>
                            </div>
                            <div class="d-md-flex justify-content-between align-items-center dt-layout-end col-md-auto ms-auto mt-0"></div>
                        </div>
                        <table id="CustomerAddressTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Id</th>
                                    <th>Adres Başlığı</th>
                                    <th></th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        Müşteriye adres eklemek için önce müşteriyi kaydetmeniz gerekmektedir.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
