
@{
    ViewData["Title"] = "Kargodakiler";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>
    <div class="card">
        <div class="card-datatable">
            <table id="CargoTable" class="table">
                <thead class="border-top">
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Sipariş Id</th>
                        <th>Kargo Firması</th>
                        <th>Kodu</th>
                        <th>Kapıda Ödeme Mi?</th>
                        <th>Ödeyen</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/assets/js/entegro.cargo.list.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.cargo.list.initList();
        });
    </script>

}