@model SpecificationAttributeViewModel

<div class="row g-3 p-3">
    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-primary btn-sm" onclick="Entegro.specificationattribute.SpecificationAttributeOptionCreatePopup(@Model.Id)">
            @Model.Name Özelliğine Değer Ekle
        </button>
    </div>

    <table class="table table-bordered" id="SpecificationAttributeOptionTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Özellik Değer Adı</th>
                <th>Sırası</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        @if (Model.SpecificationAttributeOptions.Any())
        {
            <tbody class="table-border-bottom-3">
                @foreach (var item in Model.SpecificationAttributeOptions)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.DisplayOrder</td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm btn-deleteOption" data-mapping-id="@item.Id">
                                Sil
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        }
    </table>

</div>