@model SpecificationAttributeOptionModel

<form id="specificationAttributeOptionForm" class="row g-3" onsubmit="return false">
    @Html.HiddenFor(m => m.SpecificationAttributeId)

    <div class="col-md-12 mt-3">
        <label class="form-label text-sm-start" for="OptionName">Adı</label>
        <input asp-for="Name" id="OptionName" type="text" class="form-control" placeholder="Özellik değeri adı giriniz" required />
    </div>

    <div class="col-md-12 mt-3">
        <label class="form-label text-sm-start" for="DisplayOrder">Sıra</label>
        <input asp-for="DisplayOrder" type="number" class="form-control" placeholder="Gösterim sırası" required />
    </div>

    <div class="col-12 text-center mt-3">
        <button type="button" id="btnSaveSpecificationAttributeOption" class="btn btn-success me-sm-3 me-1">
            <i class="bi bi-check-circle me-1"></i> Kaydet
        </button>
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Kapat
        </button>
    </div>
</form>
