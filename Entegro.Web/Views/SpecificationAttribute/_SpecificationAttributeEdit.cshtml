    <div class="col-md-12">
        <div class="row">
            <label class="col-sm-3 col-form-label text-sm-start" for="Name">Adı</label>
            <div class="col-sm-9">
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
            </div>
        </div>
    </div>
</div>