@model SpecificationAttributeModel

<form id="specificationAttributeForm" class="row g-3" onsubmit="return false">
    <div class="col-md-12 mt-3">
        <label class="form-label text-sm-start" for="Name">Özellik Adı</label>
        <input asp-for="Name" type="text" class="form-control" placeholder="Özellik adı giriniz" required />
    </div>

    <div class="col-12 text-center mt-3">
        <button type="button" id="btnSaveSpecificationAttribute" class="btn btn-success me-sm-3 me-1">
            <i class="bi bi-check-circle me-1"></i> Kaydet
        </button>
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Kapat
        </button>
    </div>
</form>

