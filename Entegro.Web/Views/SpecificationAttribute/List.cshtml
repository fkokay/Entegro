@{
    ViewData["Title"] = "Ürün Özellikleri";
}
<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>
    <div class="card">
        <div class="row card-header flex-column flex-md-row border-bottom mx-0 px-3">
            <div class="d-md-flex justify-content-between align-items-center dt-layout-start col-md-auto me-auto mt-0">
                <h5 class="card-title mb-0 text-md-start text-center pb-md-0 pb-6">Filtreler</h5>
            </div>
            <div class="d-md-flex justify-content-between align-items-center dt-layout-end col-md-auto ms-auto mt-0">
            </div>
        </div>

        <div class="card-datatable table-responsive">
            <table id="SpecificationAttributeTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                <thead>
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Adı</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>


<div class="modal fade" id="SpecificationAttributePopup" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Modal Header -->
            <div class="modal-header p-0 position-relative" style="height: 80px;">
                <div class="d-flex justify-content-center align-items-center w-100 h-100">
                    <h5 class="modal-title m-0">Ürün Özelliği Ekle</h5>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-4 py-4">
                <div id="SpecificationAttributePopupContent">
                </div>
            </div>

        </div>
    </div>
</div>




@section Scripts {
    <script src="/assets/js/entegro.specificationattribute.list.js" asp-append-version="true"></script>
    <script src="/assets/js/entegro.specificationattribute.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.specificationAttribute.SpecificationAttributeList.initList();
            Entegro.specificationattribute.init();
        });
    </script>
}