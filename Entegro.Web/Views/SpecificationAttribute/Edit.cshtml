@model SpecificationAttributeModel


<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="Edit" id="specificationattribute-form">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">Ürün Özellik Yönetimi</h4>
                <p class="mb-0">Ürün Özelliği</p>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("List")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                </div>
               
                <button type="submit" id="save-btn" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>
      
        <div class="row">
            <div class="col-lg-12 col-12 mb-lg-0 mb-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <ul class="nav nav-tabs card-header-tabs" id="specificationattribute-tabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#form-tabs-attribute" type="button" role="tab">Ürün Özelliği</button>
                            </li>

                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#form-tabs-attributeOption" type="button" role="tab">Ürün Özellik Değerleri</button>
                            </li>
                        </ul>
                    </div>

                    <div class="tab-content">

                        <div class="tab-pane fade show active" id="form-tabs-attribute" role="tabpanel">
                            @await Html.PartialAsync("_SpecificationAttributeEdit", new SpecificationAttributeModel { Id = Model.Id, Name = Model.Name })
                        </div>
                        <div class="tab-pane fade" id="form-tabs-attributeOption" role="tabpanel">
                            @if (Model.Id > 0)
                            {
                                @await Html.PartialAsync("_SpecificationAttributeOptionList", Model)
                            }
                            else
                            {
                                <div class="alert alert-danger">
                                    Bu ürün özelliğe değer eklemek için önce özelliği kaydetmeniz gerekmektedir.
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
            
        </div>

    </form>
</div>
<div class="modal fade" id="SpecificationAttributeOptionPopup" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Modal Header -->
            <div class="modal-header p-0 position-relative" style="height: 80px;">
                <div class="d-flex justify-content-center align-items-center w-100 h-100">
                    <h5 class="modal-title m-0">Ürün Özellik Değeri Ekle</h5>
                </div>
            </div>

            <div class="modal-body px-4 py-4">
                <div id="SpecificationAttributeOptionPopupContent">
                </div>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script src="/assets/js/entegro.specificationattribute.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.specificationattribute.init();
            Entegro.specificationattribute.SpecificationAttributeUpdateFormValidationInit();
        });
    </script>
}