@{
    ViewData["Title"] = "Loglar";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>
    <div class="card">
        <div class="card-header border-bottom">
            <h5 class="card-title">Filtreler</h5>
            <div class="row pt-4 gap-6 gap-md-0 g-md-6">
                <div class="col-md-2 filterLevel"></div>
            </div>
        </div>

        <div class="card-datatable table-responsive">
            <table id="LogTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Seviye</th>
                        <th>Kısa Mesaj</th>
                        <th>Oluşturma Tarihi</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/assets/js/entegro.log.list.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.log.list.init();
        });
    </script>
}
