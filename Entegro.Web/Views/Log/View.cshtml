
@model LogViewModel
@{
    ViewData["Title"] = "View";
}
<div class="container-fluid flex-grow-1 container-p-y">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
        <div class="d-flex flex-column justify-content-center">
            <h4 class="mb-1">Hata Kayıtları</h4>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-4">
            <div class="d-flex gap-4">
                <a href="@Url.Action("List", "Log")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-circle-x ti-xs me-1"></i> Geri Dön
                    </span>
                </a>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-lg-12 col-12 mb-lg-0 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Hata Kaydı</h5>
                </div>

                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Seviye</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-@GetLevelColor(Model.Level)">
                                @Model.Level
                            </span>
                        </dd>

                        <dt class="col-sm-3">Mesaj</dt>
                        <dd class="col-sm-9 text-break">
                            <pre class="bg-light border p-3 text-danger" style="white-space:pre-wrap">@Model.Message</pre>
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.MessageTemplate))
                        {
                            <dt class="col-sm-3">Mesaj Şablonu</dt>
                          
                            <dd class="col-sm-9">
                                <pre class="bg-light border p-3 text-danger" style="white-space:pre-wrap">@Model.MessageTemplate</pre>
                            </dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.Exception))
                        {
                            <dt class="col-sm-3">Hata</dt>
                            <dd class="col-sm-9">
                                <pre class="bg-light border p-3 text-danger" style="white-space:pre-wrap">@Model.Exception</pre>
                            </dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.Properties))
                        {
                            <dt class="col-sm-3">Özellikler</dt>
                            <dd class="col-sm-9">
                                <pre class="bg-light border p-3 text-muted" style="white-space:pre-wrap">@Model.Properties</pre>
                            </dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.LogEvent))
                        {
                            <dt class="col-sm-3">Log Event</dt>
                            <dd class="col-sm-9 text-break">@Model.LogEvent</dd>
                        }

                        <dt class="col-sm-3">Zaman</dt>
                        <dd class="col-sm-9">@Model.TimeStamp.ToString("dd.MM.yyyy HH:mm:ss")</dd>
                    </dl>

                </div>
            </div>
        </div>
    </div>

</div>


@functions {
    string GetLevelColor(string level)
    {
        return level?.ToLower() switch
        {
            "trace" => "dark",
            "debug" => "secondary",
            "information" => "info",
            "warning" => "warning",
            "error" => "danger",
            "critical" => "danger",
            "none" => "danger",
            _ => "dark"
        };
    }
}
