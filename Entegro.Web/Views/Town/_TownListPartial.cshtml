@model List<TownModel>


<div class="table-responsive text-nowrap">
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>İlçe Adı</th>
                <th>Yayınlandı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody class="table-border-bottom-0">
            @if (Model != null && Model.Any())
            {
                foreach (var town in Model)
                {
                    <tr>
                        <td>@town.Id</td>
                        <td>@town.Name</td>
                        <td class="@(town.Published ? "text-success" : "text-danger")">
                            @(town.Published ? "Yayında" : "Yayında Değil")
                        </td>
                        <td>
                            <button type="button"
                                    class="btn btn-warning btn-createorupdate-town"
                                    data-town-id="@town.Id"
                                    data-createorupdate-url="@Url.Action("CreateOrUpdateTown", "Town", new { id = town.Id,cityId=town.CityId })"
                                    data-bs-toggle="modal"
                                    data-bs-target="#createOrUpdateTownModal">
                                <span class="d-flex justify-content-center text-nowrap">
                                    <i class="ti ti-edit ti-xs me-1"></i>
                                </span>
                            </button>

                            <button type="button"
                                    class="btn btn-danger btn-delete-town"
                                    data-town-id="@town.Id"
                                    data-delete-url="@Url.Action("DeleteTown", "Town")">
                                <span class="d-flex justify-content-center text-nowrap">
                                    <i class="ti ti-trash ti-xs me-1"></i>
                                </span>
                            </button>

                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">İlçe bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
