@{
    ViewData["Title"] = "Kategoriler";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>
    <div class="card">
        <div class="card-header border-bottom">
            <h5 class="card-title mb-0">Filtreler</h5>
            <div class="row pt-4 gap-6 gap-md-0 g-md-6">
                <div class="col-md-2 categoryFilterName"></div>
                <div class="col-md-2 categoryFilterPublished"></div>
                <div class="col-md-2 categoryFilterParent"></div>
            </div>
        </div>

        <div class="card-datatable">
            <table id="CategoryTable" class="table">
                <thead class="border-top">
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Id</th>
                        <th>ParentId</th>
                        <th>Kategori adı</th>
                        <th>Görüntüleme sırası</th>
                        <th>Güncellenme tarihi</th>
                        <th>Yayınlandı</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/assets/js/entegro.category.list.js" asp-append-version="true"></script>
    <script>
        $(function() {
             Entegro.category.list.init();
        });
    </script>
}
