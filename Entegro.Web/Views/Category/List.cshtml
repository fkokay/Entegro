@{
    ViewData["Title"] = "Kategoriler";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="card">
        <div class="card-header border-bottom">
            <h5 class="card-title mb-0">Kategoriler</h5>
            <div class="d-flex justify-content-between align-items-center row pt-4 gap-6 gap-md-0 g-md-6">
                <div class="col-md-4 categoryFilterParent"></div>
            </div>
        </div>

        <div class="card-datatable">
            <table id="CategoryTable" class="table">
                <thead class="border-top">
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Id</th> <!-- gizli, backend için -->
                        <th>Kategori adı</th>
                        <th>Üst Kategori adı</th>
                        <th>Görüntüleme sırası</th>
                        <th>Kayıt tarihi</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/assets/js/entegro.category.list.js"></script>
    <script>
        $(function() {
             Entegro.Category.List.init();
        });
    </script>
}
