@model CategoryModel
@{
    ViewData["Title"] = "Yeni Bir Kategori Ekle";
}

<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="Create" id="category-form">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">Yeni Bir Kategori Ekle</h4>
                <p class="mb-0">Yeni Bir Kategori Ekle</p>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("List")" class="btn btn-label-secondary d-grid w-100 waves-effect">Vazgeç</a>
                </div>
                <button type="submit" class="btn btn-primary waves-effect waves-light">Kaydet</button>
            </div>
        </div>

        <div class="row">
            <partial name="_CreateOrUpdate" model="Model" />
        </div>
    </form>
</div>



@section scripts {
    <script src="/assets/js/entegro.category.js"></script>
    <script>
        $(function () {
            Entegro.category.init('create', '/category/create');
        });
    </script>
}