@model CategoryModel
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Kategori Bilgilerini Düzenle - " + Model.Name;
}

<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="Edit" id="category-form">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">Kategori Bilgilerini Düzenle</h4>
                <p class="mb-0">Kategori Bilgilerini Düzenle</p>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("List")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                    <button type="button" id="btnDeleteCategory" data-id="@Model.Id" class="btn btn-danger d-grid w-100 waves-effect waves-light">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-trash ti-xs me-1"></i> Sil
                        </span>
                    </button>
                </div>
                <button type="submit" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>

        <div class="row">
            <partial name="_CreateOrUpdate" />
        </div>
    </form>
</div>

@section scripts {
    <script src="/assets/js/entegro.category.js"></script>
    <script>
        $(function () {
            Entegro.category.init('edit', '/category/edit');
        });
    </script>
}
