@{
    ViewData["Title"] = "Varyantlar";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>
    <div class="card">
        <div class="card-header border-bottom">
            <h5 class="card-title">Filtreler</h5>
            <div class="d-flex justify-content-between align-items-center row pt-4 gap-6 gap-md-0 g-md-6">
                <div class="col-md-4 productFilterBrand"></div>
            </div>
        </div>
        <div class="card-datatable">
            <table id="ProductAttributeTable" class="table">
                <thead class="border-top">
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Adı</th>
                        <th>Görüntüleme Sırası</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="CreateOrUpdateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Modal Header -->
            <div class="modal-header p-0 position-relative" style="height: 80px;">
                <div class="d-flex justify-content-center align-items-center w-100 h-100">
                    <h5 class="modal-title m-0 title">Varyant Güncelle</h5>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-4 py-4">
                <div id="CreateOrUpdateModalContent">
                    <!-- Form partial buraya yüklenecek -->
                </div>
            </div>

        </div>
    </div>
</div>



@section Scripts {

    <script src="/assets/js/entegro.attribute.js" asp-append-version="true"></script>
    <script src="/assets/js/entegro.attribute.list.js" asp-append-version="true"></script>
    <script>
         $(function () {
            Entegro.Attribute.init();
            Entegro.Attribute.List.init();
        });
    </script>
}
