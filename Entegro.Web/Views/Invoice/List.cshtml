@{
    ViewData["Title"] = "Faturalar";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>
    <div class="card">
        <div class="row card-header flex-column flex-md-row border-bottom mx-0 px-3">
            <div class="d-md-flex justify-content-between align-items-center dt-layout-start col-md-auto me-auto mt-0">
                <h5 class="card-title mb-0 text-md-start text-center pb-md-0 pb-6">Filtreler</h5>
            </div>
            <div class="d-md-flex justify-content-between align-items-center dt-layout-end col-md-auto ms-auto mt-0"></div>
        </div>

        <div class="card-datatable table-responsive">
            <table id="InvoiceTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                <thead>
                    <tr>
                        <th></th>
                        <th>Fatura Numarası</th>
                        <th>Fatura Tarihi</th>
                        <th>Son Ödeme Günü</th>
                        <th>Toplam Miktar</th>
                        <th>Vergi Miktarı</th>
                        <th>Fatura Adresi</th>
                        <th>Nakliye Adresi</th>
                        <th>Müşteri</th>
                        <th>Müşteri E-Posta Adresi</th>
                        <th>Durumu</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/assets/js/entegro.invoice.list.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.invoice.list.init();
        });
    </script>
}