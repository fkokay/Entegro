@{
    ViewData["Title"] = "Dashboard";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="toast-container position-fixed top-0 end-0 p-3" style="--bs-toast-zindex:9999;">
        <div id="toast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto toast-title"></strong>
                <small class="toast-date"></small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-message">
            </div>
        </div>
    </div>
    <div class="row">
        <!-- View sales -->
        @await Component.InvokeAsync("Dashboard", new { dashboardType = "ViewSales" })
        <!-- View sales -->
        <!-- Statistics -->
        @await Component.InvokeAsync("Dashboard", new { dashboardType = "Statistics" })
        <!--/ Statistics -->
        <div class="col-xl-4 col-12">
            <div class="row">
                <!-- Expenses -->
                @* @await Component.InvokeAsync("Dashboard", new { dashboardType = "Expenses" }) *@
                <!--/ Expenses -->
                <!-- Profit last month -->
                @* @await Component.InvokeAsync("Dashboard", new { dashboardType = "Profit" }) *@
                <!--/ Profit last month -->
                <!-- Generated Leads -->
                @await Component.InvokeAsync("Dashboard", new { dashboardType = "GeneratedLeads" })
                <!--/ Generated Leads -->
            </div>
        </div>
        <!-- Revenue Report -->
        @await Component.InvokeAsync("Dashboard", new { dashboardType = "RevenueReport" })
        <!--/ Revenue Report -->
        <!-- Earning Reports -->
        @* @await Component.InvokeAsync("Dashboard", new { dashboardType = "EarningReports" }) *@
        <!--/ Earning Reports -->
        <!-- Popular Product -->
        @await Component.InvokeAsync("Dashboard", new { dashboardType = "PopularProduct" })
        <!--/ Popular Product -->
        <!-- Sales by Countries tabs-->
        @* @await Component.InvokeAsync("Dashboard", new { dashboardType = "SalesbyCountries" }) *@
        <!--/ Sales by Countries tabs -->
        <!-- Transactions -->
        @* @await Component.InvokeAsync("Dashboard", new { dashboardType = "Transactions" }) *@
        <!--/ Transactions -->
        <!-- Invoice table -->
        @await Component.InvokeAsync("Dashboard", new { dashboardType = "InvoiceTable" })
        <!-- /Invoice table -->
    </div>
</div>

@section Scripts {
    <script src="/assets/vendor/libs/apex-charts/apexcharts.js"></script>
    @* <script src="/assets/js/dashboards-ecommerce.js"></script> *@
    @* <script src="/assets/json/invoice-list.json"></script> *@

    <script src="/assets/js/entegro.dashboard.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.dashboard.init();
        });
    </script>


    <script>
      
        function getIntegrationLogo(value) {
          switch (value) {
            case "Smartstore": return "/assets/img/brandicons/smartstore.png";
            case "Trendyol": return "/assets/img/brandicons/trendyol.webp";
            case "N11": return "/assets/img/brandicons/n11.jpeg";
            case "Pazarama": return "/assets/img/brandicons/pazarama.png";
            case "Idefix": return "/assets/img/brandicons/idefix.png";
            case "CicekSepeti": return "/assets/img/brandicons/ciceksepeti.jpeg";
            case "Hepsiburada": return "/assets/img/brandicons/hepsiburada.png";
            default: return "/assets/img/icons/brands/default.png";
          }
        }

        var dt_salesproduct_table = $('.datatable-salesproduct');
        var dt_salesproduct;

        function initSalesProductTable(groupByType) {
          if ($.fn.DataTable.isDataTable('.datatable-salesproduct')) {
            dt_salesproduct.destroy();
            dt_salesproduct_table.empty();
            dt_salesproduct_table.append(`
              <thead>
                <tr>
                  <th></th>
                  <th>ID</th>
                  <th>Market Yeri / E-Ticaret</th>
                  <th>Ürün Adı</th>
                  <th>Mağaza</th>
                  <th>Toplam Satış</th>
                  <th>Dönem</th>
                </tr>
              </thead>
            `);
          }

          dt_salesproduct = dt_salesproduct_table.DataTable({
            ajax: {
              url: "/order/GetProductSalesByMarketplace?groupByType=" + groupByType,
              dataSrc: ""
            },
             columns: [
              { data: null, defaultContent: '' },
              { data: 'ProductId' },
              { data: 'IntegrationValue' },
              { data: 'ProductName' },
              { data: 'IntegrationSystemName' },
              { data: 'TotalQuantitySold' },
              { data: 'Period' },
            ],
                columnDefs: [
                   {
                     className: 'control',
                     responsivePriority: 2,
                     targets: 0,
                     render: function () {
                       return '';
                     }
                   },
                   {
                     targets: 1,
                     render: function (data, type, full) {
                       return `<a href="javascript:;"><span>#${full['ProductId']}</span></a>`;
                     }
                   },
                   {
                     targets: 2,
                     render: function (data, type, full) {
                       var logo = getIntegrationLogo(full['IntegrationValue']);
                       return `
                         <div class="d-flex align-items-center">
                           <img src="${logo}" alt="${full['IntegrationValue']}" class="me-2" style="width:24px; height:24px; border-radius:4px;">
                           <span>${full['IntegrationValue']}</span>
                         </div>`;
                     }
                   },
                   {
                     targets: 3,
                     render: function (data, type, full) {
                       return `<span>${full['ProductName']}</span>`;
                     }
                   },
                   {
                     targets: 4,
                     render: function (data, type, full) {
                       return `<span class="badge bg-label-info">${full['IntegrationSystemName']}</span>`;
                     }
                   },
                   {
                     targets: 5,
                     render: function (data, type, full) {
                       return `<strong>${full['TotalQuantitySold']}</strong>`;
                     }
                   },
                   {
                     targets: 6,
                     render: function (data, type, full) {
                       return full['Period'];
                     }
                   }
                 ],
        
            order: [[1, 'asc']],
            displayLength: 10,
            language: {
              sLengthMenu: '_MENU_',
              search: '',
              url: 'https://cdn.datatables.net/plug-ins/2.3.2/i18n/tr.json',
              searchPlaceholder: 'Ara...'
            },
            responsive: true
          });


          dt_salesproduct_table.on('draw.dt', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (el) {
              return new bootstrap.Tooltip(el, { boundary: document.body });
            });
          });
        }

       
        initSalesProductTable(1);

        $('#groupBySelect').on('change', function () {
          var val = $(this).val();
          initSalesProductTable(val);
        });
    </script>




}