@{
    ViewData["Title"] = "Dashboard";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="toast-container position-fixed top-0 end-0 p-3" style="--bs-toast-zindex:9999;">
        <div id="toast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto toast-title"></strong>
                <small class="toast-date"></small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-message">
            </div>
        </div>
    </div>
    <div class="row">
        <!-- View sales -->
        @await Component.InvokeAsync("Dashboard", new { dashboardType = "ViewSales" })
        <!-- View sales -->
        <!-- Statistics -->
        @await Component.InvokeAsync("Dashboard", new { dashboardType = "Statistics" })
        <!--/ Statistics -->
        <div class="col-xl-4 col-12">
            <div class="row">
                <!-- Expenses -->
                @* @await Component.InvokeAsync("Dashboard", new { dashboardType = "Expenses" }) *@
                <!--/ Expenses -->
                <!-- Generated Leads -->
                @await Component.InvokeAsync("Dashboard", new { dashboardType = "GeneratedLeads" })
                <!--/ Generated Leads -->
                <!-- Profit last month -->
                @await Component.InvokeAsync("Dashboard", new { dashboardType = "GetLast10OrdersWithItems" })
                <!--/ Profit last month -->
            </div>
        </div>
        <div class="col-12 col-xl-8 mb-4 col-lg-7">
            <!-- Revenue Report -->
            @await Component.InvokeAsync("Dashboard", new { dashboardType = "RevenueReport" })
            <!--/ Revenue Report -->
            <!-- Popular Product -->
            @await Component.InvokeAsync("Dashboard", new { dashboardType = "PopularProduct" })
            <!--/ Popular Product -->
            <!-- Invoice table -->
            @await Component.InvokeAsync("Dashboard", new { dashboardType = "InvoiceTable" })
            <!-- /Invoice table -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="/assets/vendor/libs/apex-charts/apexcharts.js"></script>
    @* <script src="/assets/js/dashboards-ecommerce.js"></script> *@
    @* <script src="/assets/json/invoice-list.json"></script> *@

    <script src="/assets/js/entegro.dashboard.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.dashboard.init();
        });
    </script>
}