@model ReturnRequestModel
@{
    ViewData["Title"] = "İade Talebi Bilgilerini Düzenle";
}

<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="Edit" id="returmRequest-form">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">@ViewData["Title"]</h4>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("List")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                    <button type="button" data-id="@Model.Id" class="btn btn-danger d-grid w-100 waves-effect waves-light  btn-delete">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-trash ti-xs me-1"></i> Sil
                        </span>
                    </button>
                </div>
                <button type="submit" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>
        <div class="card">
          
            <div class="card-body">
                <div class="row g-3 ">
                    <input type="hidden" value="@Model.Id" asp-for="Id" />
                    <input type="hidden" value="@Model.OrderItemId" asp-for="OrderItemId" />
                    <input type="hidden" value="@Model.CustomerId" asp-for="CustomerId" />

                    <div class="col-md-4">
                        <label class="form-label text-sm-start" asp-for="Id">Id</label>
                        @Html.TextBoxFor(m => m.Id, new { @class = "form-control", @disabled = "disabled" })
                    </div>

                    <div class="col-md-4">
                        <label class="form-label text-sm-start" asp-for="OrderItemId">Sipariş</label>
                        @Html.TextBoxFor(m => m.OrderItemId, new { @class = "form-control", @disabled = "disabled" })
                    </div>


                    <div class="col-md-4">
                        <label class="form-label text-sm-start" asp-for="CustomerId">Müşteri</label>
                        @Html.TextBoxFor(m => m.Customer.Name, new { @class = "form-control", @disabled = "disabled" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Barcode">Ürün</label>
                        @* @Html.TextBoxFor(m => m.prod, new { @class = "form-control" }) *@
                        <input type="text" value="MSI THIN 15 B13UC-3074XTR Intel Core i5 13420H 16GB 512GB SSD RTX3050 Freedos 15.6 FHD 144Hz Taşınabilir Bilgisayar" class="form-control" disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" asp-for="ReasonForReturn">İade Nedeni</label>
                        <select asp-for="ReasonForReturn" asp-items="ViewBag.ReasonForReturnType" class="select2 form-select" required></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" asp-for="ReturnRequestStatusId">İade Talebinin Durumu</label>
                        <select asp-for="ReturnRequestStatusId" asp-items="ViewBag.ReturnRequestStatus" class="select2 form-select" required></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" asp-for="RequestedAction">Talep</label>
                        <select asp-for="RequestedAction" asp-items="ViewBag.RequestedActionType" class="select2 form-select" required></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-sm-start" asp-for="Quantity">Miktar</label>
                        @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", @type = "number", step = "1", min = "0" })
                    </div>


                    <hr class="my-4 mx-n4">

                    <div class="col-md-4">
                        <label class="form-label text-sm-start" asp-for="CustomerComments">Müşteri Yorumları </label>
                        @Html.TextAreaFor(m => m.CustomerComments, new { @class = "form-control", @rows = "4" })
                    </div>

                    <div class="col-md-4">
                        <label class="form-label text-sm-start" asp-for="StaffNotes">Çalışan Notları</label>
                        @Html.TextAreaFor(m => m.StaffNotes, new { @class = "form-control", @rows = "4" })
                    </div>

                    <div class="col-md-4">
                        <label class="form-label text-sm-start" asp-for="AdminComment">Yönetici Yorumu</label>
                        @Html.TextAreaFor(m => m.AdminComment, new { @class = "form-control", @rows = "4" })
                    </div>
                   
                </div>
            </div>
        </div>
        
    </form>
</div>

@section Scripts {
    <script src="/assets/js/entegro.returnrequest.list.js" asp-append-version="true"></script>
    <script>
        $(function() {
             Entegro.returnrequest.list.deleteReturnRequest();
        });
    </script>
}
