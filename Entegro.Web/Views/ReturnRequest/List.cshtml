                        <th>İade Sebebi</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div> *@
</div>

@section Scripts {
    <script src="/assets/js/entegro.returnrequest.list.js" asp-append-version="true"></script>
    <script>
        $(function() {
            var returnRequestStatusId = @((ViewBag.ReturnRequestStatusId ?? 1));
             Entegro.returnrequest.list.initTab(returnRequestStatusId);
             Entegro.returnrequest.list.deleteReturnRequest();
        });
    </script>


    <script>
        $(document).ready(function () {

            $("#filterStartDate").on("change", function () {
                const startDate = $(this).val();
                if (startDate) {
                    $("#filterEndDate").attr("min", startDate);
                    const endDate = $("#filterEndDate").val();
                    if (endDate && endDate < startDate) {
                        $("#filterEndDate").val("");
                    }
                } else {

                    $("#filterEndDate").removeAttr("min");
                }
            });

            // Filtrele butonu
            $(document).off("click", "#btnFilter").on("click", "#btnFilter", function () {
                const table = $('#ReturnRequestTable').DataTable();
                table.ajax.reload();
            });

            // Temizle butonu
            $(document).off("click", "#btnClear").on("click", "#btnClear", function () {
                // Tüm filtre inputlarını temizle
                $("#filterCustomerName").val("");
                $("#filterOrderNo").val("");
                $("#filterReturnCode").val("");
                $("#filterBarcode").val("");
                $("#filterClaimReasonCode").val("");
                $("#filterStartDate").val("");
                $("#filterEndDate").val("");
                $("#filterEndDate").removeAttr("min"); // min değerini sıfırla

                const table = $('#ReturnRequestTable').DataTable();
                table.ajax.reload();
            });
        });
    </script>
}
