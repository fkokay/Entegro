@model ReturnListModel
@{
    ViewData["Title"] = "İade Talepleri";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>

    <div class="card">
        <div class="returnrequest-actions border-bottom p-4 d-flex">
            <button class="btn active" data-returnrequest-status="1">Tüm İadeler <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.AllQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-returnrequest-status="0">Talep Oluşturulan <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.CreatedQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-returnrequest-status="2">Kargoya Verilen <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">0</span></button>
            <div class="split"></div>
            <button class="btn" data-returnrequest-status="4">Aksiyon Bekleyen <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.WaitingInActionQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-returnrequest-status="6">Onaylanan <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.AcceptedQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-returnrequest-status="7">Reddedilen <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.RejectedQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-returnrequest-status="4">Analiz <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.InAnalysisQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-returnrequest-status="5">İhtilaflı <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.UnresolvedQuantity</span></button>
        </div>
        <div class="p-5">
            <div class="row">
                <div class="col-2 mb-2">
                    <label for="filterCustomerName" class="form-label">Müşteri Adı</label>
                    <input type="text" class="form-control" id="filterCustomerName" placeholder="Müşteri Adı" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterOrderNo" class="form-label">Sipariş No</label>
                    <input type="text" class="form-control" id="filterOrderNo" placeholder="Sipariş No" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterReturnCode" class="form-label">iade Kodu</label>
                    <input type="text" class="form-control" id="filterReturnCode" placeholder="İade Kodu" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterClaimReasonCode" class="form-label">iade Sebebi</label>
                    <input type="text" class="form-control" id="filterClaimReasonCode" placeholder="İade Kodu" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterBarcode" class="form-label">Barkod</label>
                    <input type="text" class="form-control" id="filterBarcode" placeholder="Barkod" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterStartDate" class="form-label">İade Başlangıç Tarihi</label>
                    <input type="date" class="form-control" id="filterStartDate" placeholder="Başlangıç Tarihi" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterEndDate" class="form-label">İade Bitiş Tarihi</label>
                    <input type="date" class="form-control" id="filterEndDate" placeholder="Bitiş Tarihi" />
                </div>
                <div class="col-2 mb-2 d-flex gap-2 align-items-end">
                    <button id="btnFilter" class="btn btn-primary w-100">Filtrele</button>
                    <button id="btnClear" class="btn btn-secondary w-100">Temizle</button>
                </div>
            </div>

        </div>

        <div class="card-datatable table-responsive border-top">
            <table id="ReturnRequestTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                <thead>
                    <tr>
                        <th></th>
                        <th>Id</th>
                        <th>Sipariş Kaynağı</th>
                        <th>Sipariş Bilgileri</th>
                        <th>Alıcı</th>
                        <th>Bilgiler</th>
                        <th>Kargo</th>
                        <th>Fatura</th>
                        <th>İade Sebebi</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<div class="modal fade" id="ProudctIntegrationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <form asp-action="/Order/CreateProductIntegration" method="post" id="CreateProductIntegrationForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="ProudctIntegrationModalLabel">Ürün Eşleştirme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-5">
                        <input type="hidden" id="IntegrationSystemId" name="IntegrationSystemId" />
                        <input type="hidden" id="OrderItemId" name="OrderItemId" />
                        <input type="hidden" id="IntegrationCode" name="IntegrationCode" />
                        <!-- Kategori Seçimi -->
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductIntegrationName">Trendyol Ürün Adı</label>
                            <input type="text" id="ProductIntegrationName" name="ProductIntegrationName" class="form-control" disabled />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductIntegrationSku">Trendyol Ürün Kodu</label>
                            <input type="text" id="ProductIntegrationSku" name="ProductIntegrationSku" class="form-control" disabled />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductId">Ürün</label>
                            <select id="ProductId" name="ProductId" class="select2 form-select"></select>
                        </div>
                        <div id="ProductVariantAttributeCombination" class="col-md-12" style="display:none;">
                            <label class="form-label text-sm-start" for="ProductVariantAttributeCombinationId">Varyant</label>
                            <select id="ProductVariantAttributeCombinationId" name="ProductVariantAttributeCombinationId" class="select2 form-select"></select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                    <button type="submit" class="btn btn-warning">Eşleştir</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="/assets/js/entegro.returnrequest.list.js" asp-append-version="true"></script>
    <script>
        $(function() {
            var returnRequestStatusId = @((ViewBag.ReturnRequestStatusId ?? 1));
             Entegro.returnrequest.list.initTab(returnRequestStatusId);
             Entegro.returnrequest.list.deleteReturnRequest();
        });
    </script>


    <script>
        $(document).ready(function () {

            $("#filterStartDate").on("change", function () {
                const startDate = $(this).val();
                if (startDate) {
                    $("#filterEndDate").attr("min", startDate);
                    const endDate = $("#filterEndDate").val();
                    if (endDate && endDate < startDate) {
                        $("#filterEndDate").val("");
                    }
                } else {

                    $("#filterEndDate").removeAttr("min");
                }
            });

            // Filtrele butonu
            $(document).off("click", "#btnFilter").on("click", "#btnFilter", function () {
                const table = $('#ReturnRequestTable').DataTable();
                table.ajax.reload();
            });

            // Temizle butonu
            $(document).off("click", "#btnClear").on("click", "#btnClear", function () {
                // Tüm filtre inputlarını temizle
                $("#filterCustomerName").val("");
                $("#filterOrderNo").val("");
                $("#filterReturnCode").val("");
                $("#filterBarcode").val("");
                $("#filterClaimReasonCode").val("");
                $("#filterStartDate").val("");
                $("#filterEndDate").val("");
                $("#filterEndDate").removeAttr("min"); // min değerini sıfırla

                const table = $('#ReturnRequestTable').DataTable();
                table.ajax.reload();
            });
        });
    </script>
}
