@model List<ProductCategoryModel>

<div class="row g-3 p-3">
    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-primary btn-sm" onclick="Entegro.product.ProductCategoryCreatePopup(@ViewBag.ProductId)">
            Ürün Kategorisi Ekle
        </button>
    </div>

    <table class="table table-bordered" id="productCategoryTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Kategori Yolu</th>
                <th>Sırası</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody class="table-border-bottom-3">
            @foreach (var item in Model)
            {
                <tr data-mapping-id="@item.Id">
                    <td>@item.Id</td>
                    <td>@item.CategoryBreadcrumb</td>
                    <td>@item.DisplayOrder</td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm btn-delete">
                            Sil
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
