@model SmartstoreProductIntegrationModel
<form id="integrationDialog" asp-action="CreateOrUpdateProductIntegrationSmartstore" asp-controller="Product">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="IntegrationSystemId" />
    <input type="hidden" asp-for="ProductVariantAttributeCombinationId" />
    <div class="row mb-5">
        <div class="d-flex justify-content-start align-items-center product-name">
            <div class="avatar-wrapper">
                <div class="avatar me-2 me-sm-4 rounded-2 bg-label-secondary">
                    <img src="@Model.ProductMainPicture" alt="" />
                </div>
            </div>
            <div class="d-flex flex-column">
                <h6 class="text-wrap mb-0">@Model.ProductName</h6>
                <small class="text-truncate d-none d-sm-block">@Model.ProductCode</small>
            </div>
        </div>
        <div class="col-12">
            <hr />
        </div>
        <div class="col-6 col-md-6 mb-2">
            <label class="form-label" for="IntegrationSystemName">Mağaza Adı</label>
            @Html.TextBoxFor(m => m.IntegrationSystemName, new { @class = "form-control", @readonly = "readonly", disabled = "disabled" })
        </div>
        <div class="col-6 col-md-6 mb-2">
            <label class="form-label" for="CommerceType">E-Ticaret Türü</label>
            @Html.TextBoxFor(m => m.CommerceType, new { @class = "form-control", @readonly = "readonly", disabled = "disabled" })
        </div>
    </div>

    <ul class="nav nav-pills" id="smartstore-integration-tabs" role="tablist">
        <li class="nav-item" role="presentation" style="margin-inline-end:.25rem;">
            <button type="button" class="nav-link waves-effect waves-light active" role="tab" data-bs-toggle="tab" data-bs-target="#form-tabs-integration" aria-controls="navs-form-tabs-integration" aria-selected="true">
                Entegrasyon Bilgileri
            </button>
        </li>
        <li class="nav-item" role="presentation" style="margin-inline-end:.25rem;">
            <button type="button" class="nav-link waves-effect waves-light" role="tab" data-bs-toggle="tab" data-bs-target="#form-tabs-general" aria-controls="navs-form-tabs-general" aria-selected="false">
                Genel Bilgiler
            </button>
        </li>
        <li class="nav-item" role="presentation" style="margin-inline-end:.25rem;">
            <button type="button" class="nav-link waves-effect waves-light" data-bs-toggle="tab" data-bs-target="#form-tabs-price" role="tab" aria-controls="navs-form-tabs-price" aria-selected="false">
                Fiyat
            </button>
        </li>
        <li class="nav-item" role="presentation" style="margin-inline-end:.25rem;">
            <button type="button" class="nav-link waves-effect waves-light" data-bs-toggle="tab" data-bs-target="#form-tabs-inventory" role="tab" aria-controls="navs-form-tabs-inventory" aria-selected="false">
                Envanter
            </button>
        </li>
    </ul>
    <div class="tab-content p-0 pt-5 pb-5" style="box-shadow:none;">
        <div class="tab-pane show active" id="form-tabs-integration" role="tabpanel">
            <div class="row">
                <div class="col-6 col-md-6 mb-2">
                    <label class="form-label" for="IntegrationCode">Entegrasyon Kodu</label>
                    <input type="text" asp-for="IntegrationCode" class="form-control" required />
                </div>
                <div class="col-6 col-md-6 mb-2">
                    <label class="form-label" for="Custom_ShowOnHomePage">Entegrasyon Aktif</label>
                    <div class="d-flex" style="height:38px;">
                        <label class="switch switch-lg">
                            @Html.CheckBoxFor(m => m.Active, new { @class = "switch-input" })
                            <span class="switch-toggle-slider">
                                <span class="switch-on">Evet</span>
                                <span class="switch-off">Hayır</span>
                            </span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="form-tabs-general" role="tabpanel">
            <div class="row">
                <div class="col-12 col-md-6 mb-2">
                    <label class="form-label" for="Custom_ShowOnHomePage">Ana sayfada göster</label>
                    <div class="d-flex" style="height:38px;">
                        <label class="switch switch-lg" data-toggler-for="#pnlHomePageDisplayOrder">
                            @Html.CheckBoxFor(m => m.Custom.ShowOnHomePage, new { @class = "switch-input", data_toggler_for = "#pnlHomePageDisplayOrder" })
                            <span class="switch-toggle-slider">
                                <span class="switch-on">Evet</span>
                                <span class="switch-off">Hayır</span>
                            </span>
                        </label>
                    </div>
                </div>
                <div class="col-12 col-md-6 mb-2" id="pnlHomePageDisplayOrder" style="display:none;">
                    <label class="form-label" for="Custom_HomePageDisplayOrder">Görüntüleme sırası</label>
                    <input type="number" asp-for="Custom.HomePageDisplayOrder" class="form-control" step="1" min="0" required />
                </div>
            </div>
        </div>
        <div class="tab-pane" id="form-tabs-price" role="tabpanel">
            <div class="row">
                <div class="col-12 col-md-12 mb-2">
                    <label class="form-label" for="price">Fiyat</label>
                    <input type="number" asp-for="Price" class="form-control" step="0.01" min="0" required />
                </div>
                <div class="col-12 col-md-12 mb-2">
                    <label class="form-label" for="price">Özel Fiyat</label>
                    <input type="number" asp-for="Custom.SpecialPrice" class="form-control" step="0.01" min="0" />
                </div>
                <div class="col-12 col-md-6 mb-2">
                    <label class="form-label" for="price">Özel Fiyat Başlangıç Tarihi</label>
                    <input type="datetime" asp-for="Custom.SpecialPriceStartDateTime" class="form-control" />
                </div>
                <div class="col-12 col-md-6 mb-2">
                    <label class="form-label" for="price">Özel Fiyat Bitiş Tarihi</label>
                    <input type="datetime" asp-for="Custom.SpecialPriceEndDateTime" class="form-control" />
                </div>
                <div class="col-12  col-md-6 mb-2">
                    <div class="form-check form-switch mb-2 mt-2">
                        <input class="form-check-input"
                               type="checkbox"
                               asp-for="ApplyAutoPrice" />
                        <label class="form-check-label" asp-for="ApplyAutoPrice">
                            Otomatik Fiyat Güncellemesi Uygulansın Mı?
                            <small class="text-danger d-block mt-1">
                                * Varyantlı ürünlerde, her bir varyantın fiyatı kendi maliyet değerine göre ayrı ayrı güncellenir.
                            </small>
                        </label>
                    </div>
                </div>
                <div id="autoPriceFields">
                    <div class="col-6 col-md-12">
                        <label class="form-label" for="percent">Maliyet Fiyatı</label>
                        <input type="number" asp-for="CostPrice" class="form-control" step="0.01" min="0" readonly />
                    </div>
                    <div class="col-6 col-md-12">
                        <label class="form-label" for="percent">Yüzde Kâr Oranı (%)</label>
                        <input type="number" asp-for="Percent" class="form-control" step="0.01" min="0" />
                    </div>
                    <div class="col-6 col-md-12">
                        <label class="form-label" for="commissionpercent">Komisyon (%)</label>
                        <input type="number" asp-for="CommissionPercent" class="form-control" step="0.01" min="0" />
                    </div>
                    <div class="col-6 col-md-12">
                        <label class="form-label" for="shippingfee">Kargo</label>
                        <input type="number" asp-for="ShippingFee" class="form-control" step="0.01" min="0" />
                    </div>
                    <div class="col-6 col-md-12">
                        <label class="form-label" for="extracost">Ek Maliyet</label>
                        <input type="number" asp-for="ExtraCost" class="form-control" step="0.01" min="0" />
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="form-tabs-inventory" role="tabpanel">
            <div class="row">
                <div class="col-12 col-md-6 mb-2">
                    <label class="form-label" for="Custom_ManageInventoryMethod">Stok Yönetimi</label>
                    <select asp-for="Custom.ManageInventoryMethod" class="form-select">
                        <option value="0">Stok Kontrolü Yok</option>
                        <option value="1">Stok Takibi Var</option>
                        <option value="2">Özelliklerle Birlikte Stok Takibi Var</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 mb-2" id="pnlStockQuantity" style="display:none;">
                    <label class="form-label" for="Custom_StockQunatity">Stok Miktarı</label>
                    <input type="number" asp-for="Custom.StockQunatity" class="form-control" step="1" min="0" required />
                </div>
                <div class="col-12 col-md-6 mb-2" id="pnlDisplayStockAvailability" style="display:none;">
                    <label class="form-label" for="Custom_DisplayStockAvailability">Stok Durumunu Göster</label>
                    <div class="d-flex" style="height:38px;">
                        <label class="switch switch-lg">
                            @Html.CheckBoxFor(m => m.Custom.DisplayStockAvailability, new { @class = "switch-input", data_toggler_for = "#pnlDisplayStockQuantity" })
                            <span class="switch-toggle-slider">
                                <span class="switch-on">Evet</span>
                                <span class="switch-off">Hayır</span>
                            </span>
                        </label>
                    </div>
                </div>
                <div class="col-12 col-md-6 mb-2" id="pnlDisplayStockQuantity" style="display:none;">
                    <label class="form-label" for="Custom_DisplayStockQuantity">Stok Miktarını Göster</label>
                    <div class="d-flex" style="height:38px;">
                        <label class="switch switch-lg">
                            @Html.CheckBoxFor(m => m.Custom.DisplayStockQuantity, new { @class = "switch-input" })
                            <span class="switch-toggle-slider">
                                <span class="switch-on">Evet</span>
                                <span class="switch-off">Hayır</span>
                            </span>
                        </label>
                    </div>
                </div>
                <div class="col-12 col-md-6 mb-2" id="pnlMinStockQuantity" style="display:none;">
                    <label class="form-label" for="Custom_MinStockQuantity">Minimum Stok miktarı</label>
                    <input type="number" asp-for="Custom.MinStockQuantity" class="form-control" step="1" min="0" required />
                </div>
                <div class="col-12 col-md-6 mb-2" id="pnlLowStockActivity">
                    <label class="form-label" for="Custom_LowStockActivityId">Stok Yönetimi</label>
                    <select asp-for="Custom.LowStockActivityId" class="form-select">
                        <option value="0">Hiçbir şey</option>
                        <option value="1">Satın al düğmesini devre dışı bırak</option>
                        <option value="2">Yayınlanmadı</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 text-center">
        <button type="submit" class="btn btn-primary me-sm-3 me-1" style="width:100px;">Kaydet</button>
        <button type="reset" class="btn btn-label-secondary @(Model.Id == 0 ? "" : "me-sm-3 me-1")" style="width:100px;" data-bs-dismiss="modal">İptal</button>
        @if (Model.Id > 0)
        {
            <button type="button" class="btn btn-danger" onclick="Entegro.product.list.deleteIntegration(@Model.Id)" style="width:100px;">Sil</button>
        }
    </div>
</form>


<script>
    (function () {
        var checkbox = document.getElementById("@Html.IdFor(m => m.ApplyAutoPrice)");
        var fields = document.getElementById("autoPriceFields");
        var originalPrice = "@Model.Price";
        var priceInput = document.getElementById("@Html.IdFor(m => m.Price)");
        var costInput = document.getElementById("@Html.IdFor(m => m.CostPrice)");
        var percentInput = document.getElementById("@Html.IdFor(m => m.Percent)");
        var commissionInput = document.getElementById("@Html.IdFor(m => m.CommissionPercent)");
        var shippingInput = document.getElementById("@Html.IdFor(m => m.ShippingFee)");
        var extraCostInput = document.getElementById("@Html.IdFor(m => m.ExtraCost)");

        if (!checkbox || !fields) return;

        function calculatePrice() {
            if (!checkbox.checked) return;

            var cost = parseFloat(costInput.value) || 0;
            var percent = parseFloat(percentInput.value) || 0;
            var commissionPercent = parseFloat(commissionInput.value) || 0;
            var shippingFee = parseFloat(shippingInput.value) || 0;
            var extraCost = parseFloat(extraCostInput.value) || 0;

            let result = cost * (1 + percent / 100);

            result += extraCost;
            result += shippingFee;

            if (commissionPercent > 0) {
                result = result / (1 - (commissionPercent / 100));
            }

            priceInput.value = result.toFixed(2);
        }


        function toggleAutoPriceFields() {
            if (checkbox.checked) {
                fields.style.display = "";
                calculatePrice();
            } else {
                fields.style.display = "none";

                priceInput.value = originalPrice;


                fields.querySelectorAll("input").forEach(function (x) {
                    if (x.id !== "@Html.IdFor(m => m.CostPrice)") {
                        x.value = "";
                    }
                });
            }
        }

        toggleAutoPriceFields();
        checkbox.addEventListener("change", toggleAutoPriceFields);

        [percentInput, commissionInput, shippingInput, extraCostInput].forEach(function (inp) {
            if (inp) inp.addEventListener("input", calculatePrice);
        });

    })();
</script>