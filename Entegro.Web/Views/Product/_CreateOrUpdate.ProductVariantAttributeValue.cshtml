@model ProductVariantAttributeValueModel


<form asp-action="CreateOrUpdateProductVariantAttributeValue" method="post" id="createOrUpdateProductVariantAttributeValueForm">
    <input type="hidden" value="@Model.Id" asp-for="Id" />
    <input type="hidden" value="@Model.ProductVariantAttributeId" asp-for="ProductVariantAttributeId" />

    <div class="row mb-3">
        <div class="col-md-12 mt-1">
            <label class="form-label text-sm-start" asp-for="Name">Opsiyon</label>
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @type = "text",@required="required" })
        </div>

        <div class="col-md-12 mt-1">
            <label class="form-label fw-semibold" asp-for="DisplayOrder">Görüntüleme Sırası</label>
            @Html.TextBoxFor(m => m.DisplayOrder, new {
            @class = "form-control",
                        @type = "number",
                        placeholder = "Sıra numarası giriniz"
                        })
        </div>

    </div>
    <div class="col-12 text-center pt-3">
        <button type="submit" class="btn btn-success px-4 me-2">
            <i class="bi bi-check-circle me-1"></i>Kaydet
        </button>
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i>Kapat
        </button>
    </div>
</form>
