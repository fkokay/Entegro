@model ProductModel

<div class="d-flex justify-content-between align-items-center mt-5">
    <h5 class="mb-0 card-title">Özellik kombinasyonları</h5>
    <div class="d-flex">
        <button type="button" class="btn btn-label-dark CreateCombination waves-effect me-3">
            Kombinasyon Ekle
        </button>
        <button type="button" class="btn btn-label-primary CreateAllCombinations waves-effect me-3">
            Tüm Kombinasyonları Oluştur
        </button>
        <button type="button" class="btn btn-label-danger DeleteAllCombinations waves-effect">
            Tüm Kombinasyonları Sil
        </button>
    </div>

</div>
<div class="row g-3 p-0">
    <div id="ProductVariantAttributeCombinationRepeater">
        <div data-repeater-list="ProductVariantAttributeCombinations">
            <div data-repeater-item class="repeater-wrapper pt-0 pt-md-4">
                <input type="hidden" name="Id" value="0" />
                <div class="d-flex border rounded position-relative pe-0">
                    <div class="row w-100 p-3">
                        <!-- Nested Attributes -->
                        <div class="ProductVariantAttributeSelectionRepeater">
                            <div data-repeater-list="ProductVariantAttributeSelections" class="row">
                                @foreach (var productVariantAttribute in Model.ProductVariantAttributes)
                                {
                                    <div data-repeater-item class="repeater-wrapper col-12 col-md-3" data-product-variant-attribute-id="@productVariantAttribute.Id">
                                        <input type="hidden" name="ProductVariantAttributeId" value="@productVariantAttribute.Id" />
                                        <div class="mb-md-0 mb-3">
                                            <p class="mb-2 repeater-title">@productVariantAttribute.ProductAttribute</p>
                                            <select name="ProductVariantAttributeValueId" class="form-select item-details mb-3">
                                                @foreach (var val in productVariantAttribute.ProductVariantAttributeValues)
                                                {
                                                    <option value="@val.Id">@val.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-12">
                            <p>Resimler</p>
                            <ul class="choice-box-group choice-box-group-xl mb-2" id="assigned-pictures">
                                @foreach (var item in Model.ProductMediaFiles)
                                {
                                    <li class="choice-box choice-box-mediafile">
                                        <label class="choice-box-label">
                                            <input type="checkbox" class="choice-box-control-native" name="AssignedPictureIds" value="@item.Id">
                                            <span class="choice-box-content">
                                                <img class="choice-box-element file-img" src="@item.MediaFile.Url">
                                            </span>
                                        </label>
                                    </li>
                                }
                            </ul>
                        </div>
                        <!-- Variant Fields -->
                        <div class="col-md-2">
                            <p>Stok Kodu</p>
                            <input name="StokCode" type="text" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <p>Üretici Kodu</p>
                            <input name="ManufacturerPartNumber" type="text" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <p>Gtin</p>
                            <input name="Gtin" type="text" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <p>Fiyat</p>
                            <input name="Price" type="number" class="form-control" value="0" step="0.01" />
                        </div>
                        <div class="col-md-2">
                            <p>Stok Miktarı</p>
                            <input name="StockQuantity" type="number" class="form-control" value="0" min="0" />
                        </div>
                    </div>
                    <div class="d-flex flex-column align-items-center justify-content-between border-start p-2">
                        <i class="icon-base ti ti-x icon-lg cursor-pointer" data-repeater-delete=""></i>
                    </div>
                </div>

            </div>
        </div>

        @if (Model.ProductVariantAttributes.Any())
        {
            <div class="col-12 mt-2 p-3">
                <button type="button" class="btn btn-primary" data-repeater-create>Yeni Varyant</button>
            </div>
        }
    </div>
</div>