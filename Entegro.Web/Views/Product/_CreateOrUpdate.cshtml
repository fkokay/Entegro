@model ProductModel


<div class="col-12 mb-lg-0 mb-4">
    <div class="card mb-3">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" id="product-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#form-tabs-general" type="button" role="tab">Genel Bilgiler</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#form-tabs-stock" type="button" role="tab">Envanter</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-variants-btn" data-bs-toggle="tab" data-bs-target="#form-tabs-variants" type="button" role="tab">
                        Varyantlar
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#form-tabs-seo" type="button" role="tab">Arama Motorları (SEO)</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#form-tabs-images"
                            data-url="@(Model.Id > 0 ? Url.Action("LoadTabImages", "Product", new { productId = Model.Id }) : "")" type="button" role="tab">
                        Resimler
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#form-tabs-categories" type="button" role="tab"
                            data-url="@(Model.Id > 0 ? Url.Action("LoadTabCategories", "Product", new { productId = Model.Id }) : "")">
                        Kategori Eşleştirmeleri
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#form-tabs-attributes" type="button" role="tab"
                            data-url="@(Model.Id > 0 ? Url.Action("LoadTabSpecificationAttribute", "Product", new { productId = Model.Id }) : "")">
                        Ürün Özellikleri
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content">
            <!-- Ürün Bilgisi -->
            <div class="tab-pane fade show active" id="form-tabs-general" role="tabpanel">
                <div class="row g-3 ">
                    <input type="hidden" value="@Model.Id" asp-for="Id" />
                    <input type="hidden" asp-for="Description" />

                    <!-- Ürün Adı -->
                    <div class="col-md-12">
                        <label class="form-label text-sm-start" for="Name">Ad</label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    </div>
                    <!-- Ürün Kodu -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Code">Ürün Kodu</label>
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control" })
                    </div>
                    <!-- Barkod -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Barcode">Barkod</label>
                        @Html.TextBoxFor(m => m.Barcode, new { @class = "form-control" })
                    </div>
                    <!-- Üretici Numarası-->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="ManufacturerPartNumber">Üretici Numarası</label>
                        @Html.TextBoxFor(m => m.ManufacturerPartNumber, new { @class = "form-control" })
                    </div>
                    <!-- Gtin-->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Gtin">Gtin</label>
                        @Html.TextBoxFor(m => m.Gtin, new { @class = "form-control" })
                    </div>
                    <!-- Marka -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="BrandId">Marka</label>
                        <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                            <option>Seçiniz</option>
                        </select>
                    </div>
                    <!--Yayınlandı mı-->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Published">Yayınlandı</label>
                        <div class="d-flex" style="height:38px;">
                            <label class="switch switch-lg">
                                @Html.CheckBoxFor(m => m.Published, new { @class = "switch-input" })
                                <span class="switch-toggle-slider">
                                    <span class="switch-on">Evet</span>
                                    <span class="switch-off">Hayır</span>
                                </span>
                            </label>
                        </div>
                    </div>
                    <hr class="my-4 mx-n4">

                    <!-- Fiyat -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Price">Liste Fiyat</label>
                        @Html.TextBoxFor(m => m.Price, new { @class = "form-control", @type = "number", step = "0.01" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Price">İndirimli Fiyat</label>
                        @Html.TextBoxFor(m => m.SalePrice, new { @class = "form-control", @type = "number", step = "0.01" })
                    </div>
                    <!-- Para Birimi -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Currency">Para Birimi</label>
                        <select asp-for="Currency" asp-items="ViewBag.Currencies" class="form-select"></select>
                    </div>
                    <!-- Kdv Dahil Mi -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="VatInc">KDV Dahil</label>
                        <div class="d-flex" style="height:38px;">
                            <label class="switch switch-lg">
                                @Html.CheckBoxFor(m => m.VatInc, new { @class = "switch-input" })
                                <span class="switch-toggle-slider">
                                    <span class="switch-on">Evet</span>
                                    <span class="switch-off">Hayır</span>
                                </span>
                            </label>
                        </div>
                    </div>
                    <!-- Kdv Oranı -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="VatRate">KDV Oranı (%)</label>
                        @Html.TextBoxFor(m => m.VatRate, new { @class = "form-control", @type = "number", step = "1" })
                    </div>
                    <hr class="my-4 mx-n4">
                    <!-- Birim -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Unit">Birim</label>
                        <select asp-for="Unit" asp-items="ViewBag.Units" class="form-select"></select>
                    </div>
                    <!-- Ağırlık -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Weight">Ağırlık (kg)</label>
                        @Html.TextBoxFor(m => m.Weight, new { @class = "form-control", @type = "number", step = "0.01" })
                    </div>
                    <!-- Uzunluk -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Length">Uzunluk (cm)</label>
                        @Html.TextBoxFor(m => m.Length, new { @class = "form-control", @type = "number", step = "0.01" })
                    </div>
                    <!-- Genişlik -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Width">Genişlik (cm)</label>
                        @Html.TextBoxFor(m => m.Width, new { @class = "form-control", @type = "number", step = "0.01" })
                    </div>
                    <!-- Yükseklik -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Height">Yükseklik (cm)</label>
                        @Html.TextBoxFor(m => m.Height, new { @class = "form-control", @type = "number", step = "0.01" })
                    </div>

                    <hr class="my-4 mx-n4">

                    <!-- Açıklama -->
                    <div class="col-md-12">
                        <label class="form-label text-sm-start">Açıklama</label>
                        <div id="full-editor">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stok -->
            <div class="tab-pane fade" id="form-tabs-stock" role="tabpanel">
                <div class="row g-3">
                    <!-- Stok Miktarı -->
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="StockQuantity">Stok Miktarı</label>
                        @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control", @type = "number", min = "0" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="MinStockQuantity">Minimum Stok Miktarı</label>
                        @Html.TextBoxFor(m => m.MinStockQuantity, new { @class = "form-control", @type = "number", min = "0" })
                    </div>
                </div>
            </div>

            <!-- Varyantlar -->
            <div class="tab-pane fade" id="form-tabs-variants" role="tabpanel" data-loaded="false">
                @if (Model.Id > 0)
                {
                    <div class="d-flex flex-column justify-content-center">
                        <h4 class="mb-3">Özellikler</h4>
                    </div>
                    <table id="AttributesTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Özellik</th>
                                <th>Kontrol Türü</th>
                                <th>Zorunlu</th>
                                <th>Opsiyonlar</th>
                                <th>Görüntülenme Sayısı</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                    </table>

                    <partial name="_CreateOrUpdate.Attributes" model="Model" />
                }
                else
                {
                    <div class="alert alert-danger">
                        Bu ürüne varyant eklemek için önce ürünü kaydetmeniz gerekmektedir.
                    </div>
                }
            </div>

            <!-- Arama Motorları (SEO) -->
            <div class="tab-pane fade" id="form-tabs-seo" role="tabpanel">
                <div class="row g-3">
                    <!-- Meta Başlık -->
                    <div class="col-md-12">
                        <label class="form-label text-sm-start" for="MetaTitle">Meta Başlık</label>
                        @Html.TextBoxFor(m => m.MetaTitle, new { @class = "form-control" })
                    </div>
                    <!-- Anahtar Kelimeler -->
                    <div class="col-md-12">
                        <label class="form-label text-sm-start" for="MetaKeywords">Anahtar Kelimeler</label>
                        @Html.TextBoxFor(m => m.MetaKeywords, new { @class = "form-control" })
                    </div>
                    <!-- Meta Açıklama -->
                    <div class="col-md-12">
                        <label class="form-label text-sm-start" for="MetaDescription">Meta Açıklama</label>
                        @Html.TextAreaFor(m => m.MetaDescription, new { @class = "form-control", rows = 3 })
                    </div>
                </div>
            </div>

            <!-- Resimler -->
            <div class="tab-pane fade" id="form-tabs-images" role="tabpanel">
                @if (Model.Id > 0)
                {
                    <div id="imageTabContent" class="p-3">
                        <div class="text-muted">Resimler yükleniyor...</div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        Bu ürüne resim yüklemek için önce ürünü kaydetmeniz gerekmektedir.
                    </div>
                }

            </div>

            <!--Kategori Eşleştirmeleri-->
            <div class="tab-pane fade" id="form-tabs-categories" role="tabpanel" data-loaded="false">
                @if (Model.Id > 0)
                {
                    <div class="p-4 text-center text-muted" id="productcategories-loading" style="display:none">
                        Yükleniyor...
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        Bu ürüne kategori eklemek için önce ürünü kaydetmeniz gerekmektedir.
                    </div>
                }
            </div>

            <!--Ürün Özellikleri-->
            <div class="tab-pane fade" id="form-tabs-attributes" role="tabpanel">
                @if (Model.Id > 0)
                {
                    <div class="p-4 text-center text-muted" id="productattributes-loading" style="display:none">
                        Yükleniyor...
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        Bu ürüne özellik eklemek için önce ürünü kaydetmeniz gerekmektedir.
                    </div>
                }
            </div>
        </div>
    </div>
</div>





