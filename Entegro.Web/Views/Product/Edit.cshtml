@using System.Text.Json
@model ProductModel
@{
    ViewData["Title"] = "Edit";
}

<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="Edit" id="product-form">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">Ürünü Bilgilerini Düzenle</h4>
                <p class="mb-0">@Model.Name</p>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("List")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                    <button type="button" id="btnDeleteProduct" class="btn btn-danger d-grid w-100 waves-effect waves-light">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-trash ti-xs me-1"></i> Sil
                        </span>
                    </button>
                </div>
                <button type="submit" id="SaveBtn" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>

        <div class="row">
            <partial name="_CreateOrUpdate" />
        </div>
    </form>
</div>


<div class="modal fade" id="ProductCategoryPopup" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Modal Header -->
            <div class="modal-header p-0 position-relative" style="height: 80px;">
                <div class="d-flex justify-content-center align-items-center w-100 h-100">
                    <h5 class="modal-title m-0">Ürün Kategorisi Ekle</h5>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-4 py-4">
                <div id="ProductCategoryPopupContent">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="createOrUpdateProductVariantAttributeModal" tabindex="-1" aria-labelledby="createOrUpdateProductVariantAttributeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Modal Header -->
            <div class="modal-header p-0 position-relative" style="height: 80px;">
                <div class="d-flex justify-content-center align-items-center w-100 h-100">
                    <h5 class="modal-title m-0">Yeni Ürün Varyantı Oluştur</h5>
                </div>
            </div>

            <!-- Modal Body (partial içeriği buraya yüklenecek) -->
            <div class="modal-body px-4 py-4" id="createOrUpdateProductVariantAttributeModalBody">
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="CrossSaleProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <form asp-action="/Product/CreateCrossSaleProduct" method="post" id="CrossSaleProductForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="CrossSaleProductModalLabel">Çapraz Satış Ürün Eşleştirme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-5">
                        <input type="hidden" id="ProductId1" name="ProductId1"  value="@Model.Id"/>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductId2">Ürün</label>
                            <select id="ProductId2" name="ProductId2" class="select2 form-select"></select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                    <button type="submit" class="btn btn-success">Eşleştir</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="RelatedProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <form asp-action="/Product/CreateRelatedProduct" method="post" id="RelatedProductForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="RelatedProductModalLabel">İlişkili Ürün Eşleştirme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-5">
                        <input type="hidden" id="ProductId1" name="ProductId1"  value="@Model.Id"/>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductId2">Ürün</label>
                            <select id="ProductId2Related" name="ProductId2" class="select2 form-select"></select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" name="DisplayOrder">Sıra</label>
                            <input type="number" min="0" class="form-control" id="DisplayOrderRelated" name="DisplayOrder" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                    <button type="submit" class="btn btn-success">Eşleştir</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="ProductSpecificationAttributeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <form asp-action="CreateProductSpecificationAttributeMapping" asp-controller="Product" method="post" id="ProductSpecificationAttributeForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="ProductSpecificationAttributeModalLabel">Özellik Değeri -Ürün Eşleştirme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-5">
                        <input type="hidden" id="ProductId" name="ProductId"  value="@Model.Id"/>

                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="SpecificationAttributeId">Özellik</label>
                            <select id="SpecificationAttributeId" name="SpecificationAttributeId" class="select2 form-select"></select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="SpecificationAttributeOptionId">Özellik Değeri</label>
                            <select id="SpecificationAttributeOptionId" name="SpecificationAttributeOptionId" class="select2 form-select"></select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" name="DisplayOrder">Sıra</label>
                            <input type="number" min="0" class="form-control" id="DisplayOrderRelated" name="DisplayOrder" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                    <button type="submit" class="btn btn-success">Eşleştir</button>
                </div>
            </form>
        </div>
    </div>
</div>






@section Scripts {
    <script src="/assets/js/entegro.product.js" asp-append-version="true"></script>
    <script>
        $(function () {
            const productId = @Html.Raw(Model.Id);
            window.ProductVariantAttributes = @Html.Raw(JsonSerializer.Serialize(Model.ProductVariantAttributes));
            window.ProductVariantAttributeCombinations = @Html.Raw(JsonSerializer.Serialize(Model.ProductVariantAttributeCombinations));

            Entegro.product.Init();
            Entegro.product.TabsInit(); 
            Entegro.product.DescriptionEditor();
            Entegro.product.ProductVariantAttributeCombinationRepeaterInit(window.ProductVariantAttributeCombinations);
            Entegro.product.Validation();
            Entegro.product.initCreateOrUpdateProductVariantAttributeModal();
            Entegro.product.initCreateOrUpdateProductVariantAttributeForm();
            Entegro.product.initDeleteAttributeHandler();
            Entegro.product.initViewVariantAttributeValues();
        });

    </script>
}
