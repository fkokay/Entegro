@model ProductCategoryModel

<div id="productCategoryForm" class="row g-4">
    @Html.HiddenFor(m => m.ProductId)

    <!-- Kategori Seçimi -->
    <div class="col-12">
        <label class="form-label fw-semibold" for="CategoryId">Kategori</label>
        <select asp-for="CategoryId" class="select2 form-select form-select-lg" required></select>
    </div>

    <!-- Görüntüleme Sırası -->
    <div class="col-12">
        <label class="form-label fw-semibold" for="DisplayOrder">Sıra</label>
        <input asp-for="DisplayOrder" type="number" class="form-control" placeholder="Sıra numarası giriniz" />
    </div>

    <!-- Butonlar -->
    <div class="col-12 text-center pt-3">
        <button type="button" id="btnSaveProductCategory" class="btn btn-success px-4 me-2">
            <i class="bi bi-check-circle me-1"></i> Kaydet
        </button>
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Kapat
        </button>
    </div>
</div>
