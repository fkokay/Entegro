@{
    ViewData["Title"] = "ProductVariantAttributeValueList";
}

<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="#" id="attributevalue-form">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">Özellik Değer Bilgilerini Düzenle</h4>
                <p class="mb-0">Özellik Değer Bilgilerini Düzenle</p>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("List")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                    <button type="button" id="btnDeleteProductVariantAttributeValue" class="btn btn-danger d-grid w-100 waves-effect waves-light">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-trash ti-xs me-1"></i> Sil
                        </span>
                    </button>
                </div>
                <button type="submit" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>

        <div class="row">
            <div class="flex-grow-1 container-p-y container-fluid">
                <div class="row card-header flex-column flex-md-row border-bottom mx-0 px-3">
                    <div class="d-md-flex justify-content-between align-items-center dt-layout-start col-md-auto me-auto mt-0">
                        <h5 class="card-title mb-0 text-md-start text-center pb-md-0 pb-6">Filtreler</h5>
                    </div>
                    <div class="d-md-flex justify-content-between align-items-center dt-layout-end col-md-auto ms-auto mt-0"></div>
                </div>
                <table id="AttributeValuesTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Id</th>
                            <th>Adı</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="/assets/js/entegro.productvariantattributevalue.list.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            const productVariantAttributeId = @Html.Raw(ViewBag.ProductVariantAttributeId ?? "0");
            
            Entegro.productvariantattributevalue.list.init(productVariantAttributeId);
        });
    </script>

}
