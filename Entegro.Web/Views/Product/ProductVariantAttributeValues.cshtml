@model ProductVariantAttributeValuePageModel
@{
    ViewData["Title"] = "ProductVariantAttributeValueList";
}

<div class="container-fluid flex-grow-1 container-p-y">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
        <div class="d-flex flex-column justify-content-center">
            <h4 class="mb-1">Özelliği Düzenle</h4>
            <p class="mb-0">Ürün: <b>@Model.Name</b></p>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-4">
            <div class="d-flex gap-4">
                <a href="@Url.Action("Edit", "Product", new { id = Model.ProductId })" class="btn btn-label-secondary d-grid w-100 waves-effect">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                    </span>
                </a>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="flex-grow-1 container-p-y container-fluid">
            <div class="card">
                <div class="card-header border-bottom">
                    <h5 class="card-title mb-0">Filtreler</h5>
                    <div class="row pt-4 gap-6 gap-md-0 g-md-6">
                    </div>
                </div>
                <div class="card-datatable">
                    <table id="AttributeValuesTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Adı</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="createOrUpdateProductVariantAttributeValueModal" tabindex="-1" aria-labelledby="createOrUpdateProductVariantAttributeValueModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple  modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-center">Yeni Varyant Değeri Oluştur</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="createOrUpdateProductVariantAttributeValueModalBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="/assets/js/entegro.productvariantattributevalue.list.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            const productVariantAttributeId = @Html.Raw(Model.ProductVariantAttributeId.ToString() ?? "0");
            Entegro.productvariantattributevalue.list.init(productVariantAttributeId);
            Entegro.productvariantattributevalue.list.initCreateOrUpdateProductVariantAttributeValueModal();
            Entegro.productvariantattributevalue.list.initCreateOrUpdateProductVariantAttributeValueForm();
        });
    </script>

}
