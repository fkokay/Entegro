@model List<ProductSpecificationAttributeViewModel>

<div class="row g-3 p-3">
    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-primary btn-sm" onclick="#">
            Ürüne Özellik Ekle
        </button>
    </div>

    <table class="table table-bordered" id="productSpecificationAttributeTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Ürün Özellik</th>
                <th>Sırası</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody class="table-border-bottom-3">
            @foreach (var item in Model)
            {
                <tr data-mapping-id="@item.Id">
                    <td>@item.Id</td>
                    <td>@item.SpecificationAttributeOption.Name</td>
                    <td>@item.DisplayOrder</td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm btn-delete">
                            Sil
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
