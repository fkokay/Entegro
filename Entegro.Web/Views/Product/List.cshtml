@using System.Text.Json
@{
    ViewData["Title"] = "Ürünler";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>
    <div class="card">
        <div class="card-header border-bottom">
            <h5 class="card-title">Filtreler</h5>
            <div class="row pt-4 gap-6 gap-md-0 g-md-6">
                <div class="col-md-2 productFilterCode"></div>
                <div class="col-md-2 productFilterName"></div>
                <div class="col-md-2 productFilterBarcode"></div>
                <div class="col-md-2 productFilterPublished"></div>
                <div class="col-md-2 productFilterBrand"></div>
            </div>
        </div>
        <div class="card-datatable">
            <table id="ProductTable" class="table">
                <thead class="border-top">
                    <tr>
                        <th></th>
                        <th></th>
                        <th>BrandId</th>
                        <th>Stok Kodu</th>
                        <th>Kodu</th>
                        <th>Ürün Adı</th>
                        <th>Liste Fiyatı</th>
                        <th>Stok Miktarı</th>
                        <th>Güncellenme Tarihi</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="addIntegration" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-edit-user modal-dialog-centered">
        <div class="modal-content p-0 p-md-0">
            <div class="modal-body">
                <div class="text-center mb-2">
                    <h3>Entegrasyon Bilgileri</h3>
                </div>
                <div id="integrationDialogContainer"></div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="CreateIfNotExistProductTrendyolModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <form id="CreateIfNotExistProductTrendyolForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="CreateIfNotExistProductTrendyolModalLabel">Ürün Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-5">
                        <input type="hidden" id="IntegrationSystemId"  />
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductIntegrationSku">Trendyol Ürün Barkodu</label>
                            <input type="text" id="ProductIntegrationSku" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                    <button type="submit" class="btn btn-warning">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script src="/assets/js/entegro.product.list.js" asp-append-version="true"></script>
    <script>
        $(function () {
            window.commerces = @Html.Raw(JsonSerializer.Serialize(ViewBag.Commerces));
            window.marketPlaces = @Html.Raw(JsonSerializer.Serialize(ViewBag.Marketplaces));

            Entegro.product.list.initList();
            Entegro.product.list.editIntegration();
           
        });
    </script>

    <script>
        $('#CreateIfNotExistProductTrendyolForm').on('submit', function (e) {
            e.preventDefault();

            var modal = $('#CreateIfNotExistProductTrendyolModal');

            var formData = {
                IntegrationSystemId: $('#IntegrationSystemId').val(),
                ProductIntegrationSku: $('#ProductIntegrationSku').val()
            };

            $.ajax({
                url: '/Product/CreateIfNotExistProductTrendyol',
                type: 'POST',
                data: JSON.stringify(formData),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                processData: false,
                success: function (response) {
                    modal.modal('hide');

                    if (response.success) {
                        toastr.success(response.message || "Ürün başarıyla eklendi ve eşleştirildi.");
                        setTimeout(function () {
                            location.reload();
                        }, 2000);
                    } else {
                        toastr.warning(response.message || "Bir hata oluştu. Lütfen tekrar deneyin.");
                    }
                },
                error: function (xhr, status, error) {
                    modal.modal('hide');
                    toastr.error("Sunucu hatası oluştu: " + error);
                }
            });
        });
    </script>

}