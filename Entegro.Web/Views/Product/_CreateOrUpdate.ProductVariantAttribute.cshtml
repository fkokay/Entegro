@model ProductVariantAttributeModel


<form asp-action="CreateOrUpdateProductVariantAttribute" method="post" id="createOrUpdateProductVariantAttributeForm">
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.ProductId)

    <div class="row g-4">
        <!-- Özellik -->
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="ProductAttributeId">Özellik</label>
            <select asp-for="ProductAttributeId" asp-items="ViewBag.ProductAttributes" class="select2 form-select" required></select>
        </div>

        <!-- Kontrol Türü -->
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="AttributeControlTypeId">Kontrol Türü</label>
            <select asp-for="AttributeControlTypeId" asp-items="ViewBag.FormControlTypes" class="select2 form-select" required></select>
        </div>

        <!-- Görüntüleme Sırası -->
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="DisplayOrder">Görüntüleme Sırası</label>
            @Html.TextBoxFor(m => m.DisplayOrder, new {
                @class = "form-control",
                @type = "number",
                placeholder = "Sıra numarası giriniz"
            })
        </div>

        <!-- Zorunlu Alan -->
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="IsRequried">Zorunlu</label>
            <div class="d-flex align-items-center" style="height: 38px;">
                <label class="switch switch-lg">
                    @Html.CheckBoxFor(m => m.IsRequried, new { @class = "switch-input" })
                    <span class="switch-toggle-slider">
                        <span class="switch-on">Evet</span>
                        <span class="switch-off">Hayır</span>
                    </span>
                </label>
            </div>
        </div>
    </div>

    <!-- Butonlar -->
    <div class="col-12 text-center pt-4">
        <button type="submit" class="btn btn-success px-4 me-2">
            <i class="bi bi-check-circle me-1"></i> Kaydet
        </button>
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Kapat
        </button>
    </div>
</form>


