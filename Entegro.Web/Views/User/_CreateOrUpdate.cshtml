@model UserModel

@Html.HiddenFor(m => m.Id)

<div class="col-lg-12 col-12 mb-lg-0 mb-4">
    <div class="card mb-3">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#form-tabs-general" role="tab" aria-selected="true">
                        Genel
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content">
            <!-- Personal Info -->
            <div class="tab-pane fade active show" id="form-tabs-general" role="tabpanel">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="FirstName">Ad</label>
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", @required = "required" })

                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="LastName">Soyadı</label>
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", @required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Email">Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @type = "email", @required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="Password">Şifre</label>
                        @Html.TextBoxFor(m => m.Password, new { @class = "form-control", @required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-sm-start" for="PhoneNumber">Telefon</label>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", @type = "phone", @required = "required" })
                    </div>
                    <div class="col-md-12">
                        <label class="form-label text-sm-start" for="Active">Aktif</label>
                        <label class="switch switch-lg">
                            @Html.CheckBoxFor(m => m.Active, new { @class = "switch-input" })
                            <span class="switch-toggle-slider">
                                <span class="switch-on"></span>
                                <span class="switch-off"></span>
                            </span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>