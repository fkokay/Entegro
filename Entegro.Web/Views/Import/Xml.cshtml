@model XmlImportProfileModel


<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="Analyze" asp-controller="Import" id="importFormXml">
        <input asp-for="Id" type="hidden" class="form-control" />
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">XML Kaynağı Oluştur</h4>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("List", "Import")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                </div>
                <button type="submit" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 col-12 mb-lg-0 mb-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">XML Kaynağı Oluştur</h5>
                    </div>
                    <div class="card-body">
                        <input type="hidden" id="mappingsInput" name="MappingsJson" />
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label text-sm-start" for="Name">Profil Adı</label>
                                <input asp-for="ProfileName" type="text" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-sm-start" for="Name">XML Kaynağı</label>
                                <input asp-for="MediaFileUrl" type="url" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">E-Ticaret Mağazaları</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Mağaza Adı</th>
                            <th>Platform</th>
                            <th>Yüzde Kâr (%)</th>
                            <th>Komisyon (%)</th>
                            <th>Kargo Ücreti</th>
                            <th>Ek Maliyet</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < Model.ECommerces.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" asp-for="ECommerces[i].Id" />
                                    <input type="hidden" asp-for="ECommerces[i].ApplyAutoPrice" />
                                    <span class="form-control-plaintext">@Model.ECommerces[i].Id</span>
                                </td>

                                <td>
                                    <input asp-for="ECommerces[i].Name"
                                           class="form-control"
                                           readonly />
                                </td>

                                <td>
                                    <input asp-for="ECommerces[i].Value"
                                           class="form-control"
                                           readonly />
                                </td>

                                <td>
                                    <input asp-for="ECommerces[i].ProfitRate"
                                           type="number" step="0.01"
                                           class="form-control" />
                                </td>

                                <td>
                                    <input asp-for="ECommerces[i].Commission"
                                           type="number" step="0.01"
                                           class="form-control" />
                                </td>

                                <td>
                                    <input asp-for="ECommerces[i].CargoPrice"
                                           type="number" step="0.01"
                                           class="form-control" />
                                </td>

                                <td>
                                    <input asp-for="ECommerces[i].ExtraCost"
                                           type="number" step="0.01"
                                           class="form-control" />
                                </td>
                            </tr>
                        }
                    </tbody>


                </table>
            </div>
        </div>
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">Pazaryeri Mağazaları</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Mağaza Adı</th>
                            <th>Platform</th>
                            <th>Yüzde Kâr (%)</th>
                            <th>Komisyon (%)</th>
                            <th>Kargo Ücreti</th>
                            <th>Ek Maliyet</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < Model.Marketplaces.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" asp-for="Marketplaces[i].Id" />
                                    <input type="hidden" asp-for="Marketplaces[i].ApplyAutoPrice" />
                                    <span class="form-control-plaintext">
                                        @Model.Marketplaces[i].Id
                                    </span>
                                </td>

                                <td>
                                    <input asp-for="Marketplaces[i].Name"
                                           class="form-control"
                                           readonly />
                                </td>

                                <td>
                                    <input asp-for="Marketplaces[i].Value"
                                           class="form-control"
                                           readonly />
                                </td>

                                <td>
                                    <input asp-for="Marketplaces[i].ProfitRate"
                                           type="number" step="0.01"
                                           class="form-control" />
                                </td>

                                <td>
                                    <input asp-for="Marketplaces[i].Commission"
                                           type="number" step="0.01"
                                           class="form-control" />
                                </td>

                                <td>
                                    <input asp-for="Marketplaces[i].CargoPrice"
                                           type="number" step="0.01"
                                           class="form-control" />
                                </td>

                                <td>
                                    <input asp-for="Marketplaces[i].ExtraCost"
                                           type="number" step="0.01"
                                           class="form-control" />
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </form>
</div>


@section Scripts {
    <script>
        document.getElementById("importFormXml").addEventListener("submit", function (e) {
            const profileNameInput = document.querySelector('input[name="ProfileName"]');
            const urlInput = document.querySelector('input[name="MediaFileUrl"]');


            if (!profileNameInput || !profileNameInput.value.trim()) {
                e.preventDefault();
                alert("Lütfen profil adı giriniz.");
                if (profileNameInput) {
                    profileNameInput.classList.add("is-invalid");
                    profileNameInput.focus();
                }
                return;
            } else {
                profileNameInput.classList.remove("is-invalid");
            }


            const urlValue = urlInput.value.trim();
            const urlPattern = /^(https?:\/\/)?([\w\-]+\.)+[\w\-]+(\/[\w\-._~:/?#[\]@@!$&'()*+,;=]*)?$/;

            if (!urlValue) {
                e.preventDefault();
                alert("Lütfen bir URL giriniz.");
                urlInput.classList.add("is-invalid");
                urlInput.focus();
                return;
            } else if (!urlPattern.test(urlValue)) {
                e.preventDefault();
                alert("Lütfen geçerli bir URL giriniz (örn: https://example.com).");
                urlInput.classList.add("is-invalid");
                urlInput.focus();
                return;
            } else {
                urlInput.classList.remove("is-invalid");
            }
        });
    </script>
}

