<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">İçe Aktar</h4>
    </div>
    <div class="row g-3 p-3">
        <div class="col-12">
            <div class="fu-container xl">
                <div class="fu-controls">
                    <div class="dropzone-container">
                        <div class="dropzone-target">
                            <div class="dropzone-file-info d-flex align-items-center">
                                <div class="fu-message text-truncate empty" title="Dosya yükle">
                                    Excel dosyası yükle (.xls, .xlsx)
                                </div>
                            </div>
                            <div id="upload" class="fu-fileupload"
                                 data-upload-url="/media/upload/?isTransient=False&path=document&entityType=document"
                                 data-type-filter="spreadsheet"
                                 data-accept=".xls,.xlsx"
                                 data-show-remove-after-upload="true">
                                <input type="hidden" id="upload-file" name="upload-file" />
                                <div class="fu-buttons"></div>
                            </div>
                        </div>
                    </div>
                    <div class="file-preview-template d-none">
                        <div class="fu-file-preview dz-file-preview shadow-sm">
                            <figure class="file-figure d-flex m-0 align-items-center justify-content-center file-thumb show loaded">
                                <i class="file-icon fas fa-file-excel fa-3x text-success"></i>
                            </figure>
                            <div class="fu-file-info-container d-flex flex-column w-100 h-100 justify-content-between">
                                <div class="fu-file-info h-100 w-100 d-flex position-absolute justify-content-center align-items-center">
                                    <div class="fu-file-info-name text-dark font-weight-medium text-center"></div>
                                </div>
                                <div class="fu-preview-control-menu w-100 d-flex flex-wrap justify-content-between px-2 pb-2 pt-0">
                                    <a href="#" class="fu-preview-control-remove delete-entity-picture btn btn-sm btn-danger" title="Dosyayı kaldır">
                                        <span class="fs-sm">Kaldır</span>
                                    </a>
                                </div>
                            </div>
                            <div class="fu-progress">
                                <div class="progress">
                                    <div class="progress-bar" role="progressbar" style="width: 0%" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="fu-progress">
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: 0%" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-6">
            <div id="preview" class="mt-3"></div>
        </div>
    </div>
</div>

@section scripts {
    <script>

        $(document).ready(function () {

                $("#upload").dropzoneWrapper({
                    url: $("#upload").data("upload-url"),
                    previewsContainer: "#preview",
                    maxFiles: 1,
                    maxFilesSize: 10240,
                    timeout: 300000,
                    acceptedFiles: ".xls,.xlsx",
                    showRemoveButton: false,
                    showRemoveButtonAfterUpload: true,
                    downloadEnabled: false,
                    success: function (response) {
                        if (response) {
                                if (response.media && response.media.id) {
                                     var mediaId = response.media.id;
                                     console.log(mediaId);
                                     window.location.href = '/import/MapColumns?mediaFileId=' + mediaId;
                                }

                        }
                    }
                });
            });
    </script>
}
