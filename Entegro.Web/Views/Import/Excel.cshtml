<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
        <div class="d-flex flex-column justify-content-center">
            <h4 class="mb-1">İçe Aktar</h4>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-4">
            <div class="d-flex gap-4">
                <a href="@Url.Action("List", "Import")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                    </span>
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        
        <div class="row g-3 p-3">
            <div class="col-12">
                <div id="ImportFileUploadContainer" class="form-group">
                    <input type="hidden" name="TempFileName">
                    <div class="dropzone-container">
                        <div class="dropzone-target">
                            <div class="dropzone-file-info d-flex align-items-center">
                                <div class="fu-message text-truncate empty" title="İçe aktarım dosyasını yükle...">
                                    İçe aktarım dosyasını yükle...
                                </div>

                                <a href="#" class="fu-remove remove btn btn-clear-dark btn-sm btn-no-border btn-icon rounded-circle" title="Dosyayı kaldır">
                                    <i class="fu-remove-icon fs-h6 p-0 text-danger">×</i>
                                </a>
                            </div>

                            <div id="ImportFileUploader" class="fu-fileupload"
                                 data-dialog-url="/media/fileconflictresolutiondialog/"
                                 data-assignment-url=""
                                 data-remove-url=""
                                 data-sort-url=""
                                 data-entity-id="0"
                                 data-type-filter=".csv,.xlsx,.txt,.tab"
                                 data-upload-url="/media/upload/?isTransient=False&path=document&entityType=document"
                                 data-accept=".csv,.xlsx,.txt,.tab"
                                 data-show-remove-after-upload="true">
                                <input type="hidden" id="ImportFileUploader-file" name="ImportFileUploader-file">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6">
                <div id="preview" class="mt-3"></div>
            </div>
        </div>
    </div>



</div>

@section scripts {
    <script data-origin="FileUploader">
        $(function () {
            window['onUploadCompleted'] = function (file, response) {
                if (!_.isEmpty(response.name)) {
                    $('#import-profile-dialog').find('input[name=TempFileName]').val(response.name);
                    $('#import-profile-dialog').find('.btn-primary').prop('disabled', false);
                }
                else if (!_.isEmpty(response.error)) {
                    $('#ImportFileList').html('<div class="alert alert-danger">' + response.error + '</div>').show();
                }
            }

            // Init dropzone
            $("#ImportFileUploader").dropzoneWrapper({
                onUploading: null,
                onUploadCompleted: onUploadCompleted,
                onAborted: null,
                onError: null,
                onFileRemove: null,
                onCompleted: null,
                onMediaSelected: null,
                maxFiles: 1,
                maxFilesSize: 102400,
                timeout: 300000,
                clickableElement: null,
                previewContainerId: "",
                showRemoveButton: true,
                showRemoveButtonAfterUpload: true,
                downloadEnabled: false,
                success: function (response) {
                    if (response) {
                        if (response.media && response.media.id) {
                             var mediaId = response.media.id;
                             console.log(mediaId);
                             window.location.href = '/import/MapColumns?mediaFileId=' + mediaId;
                        }
                    }
                }
            });
        });
    </script>
