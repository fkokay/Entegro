@model List<ProductIntegrationViewModel>
@{
    ViewData["Title"] = "BulkUpdatePrices";
    int selectedBrandId = ViewBag.SelectedBrandId ?? 0;
}


<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="SaveIntegrations" id="integration-form" method="post">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">

            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">Toplu Fiyat Güncelle</h4>
                <p class="mb-0">Toplu Fiyat Güncelle</p>

                <select asp-items="ViewBag.Brands" class="form-select" id="brandFilter">
                    <option value="0">Marka Seçiniz...</option>
                </select>
            </div>
            

         
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("BulkUpdatePrices")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                </div>
                <button type="submit" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <h5 class="card-header">Ürün Listesi</h5>
                    <div class="table-responsive text-nowrap">

                        @if (Model != null && Model.Any())
                        {
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Ürün</th>
                                        <th>Liste Fiyatı</th>
                                        <th>Satış Fiyatı</th>
                                        @foreach (var header in Model.First().IntegrationPrices.Keys)
                                        {
                                            <th>@header</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="table-border-bottom-0">
                                    @for (int i = 0; i < Model.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="hidden" name="[@(i)].ProductId" value="@Model[i].ProductId" />
                                                @Model[i].ProductName
                                            </td>
                                            <td>
                                                <input type="number" step="0.01"
                                                       name="[@(i)].Price"
                                                       value="@Model[i].Price"
                                                       class="form-control form-control-sm" />
                                            </td>
                                            <td>
                                                <input type="number" step="0.01"
                                                       name="[@(i)].SalePrice"
                                                       value="@Model[i].SalePrice"
                                                       class="form-control form-control-sm" />
                                            </td>

                                            @foreach (var kvp in Model[i].IntegrationPrices)
                                            {
                                                var header = kvp.Key;
                                                var value = kvp.Value;
                                                <td>
                                                    <input type="hidden"
                                                           name="[@(i)].IntegrationPrices[@(header)].IntegrationSystemId"
                                                           value="@value.IntegrationSystemId" />

                                                    <input type="number" step="0.01"
                                                           name="[@(i)].IntegrationPrices[@(header)].Price"
                                                           value="@value.Price"
                                                           class="form-control form-control-sm" />
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p>Görüntülenecek değer yok</p>
                        }

                    </div>
                </div>
            </div>
        </div>

    </form>

</div>
<nav aria-label="Sayfalama" class="d-flex justify-content-center mb-3">
    <ul class="pagination">
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("BulkUpdatePrices", new { page = ViewBag.CurrentPage - 1, brandId = selectedBrandId })">«</a>
        </li>

        <li class="page-item @(ViewBag.CurrentPage == 1 ? "active" : "")">
            <a class="page-link" href="@Url.Action("BulkUpdatePrices", new { page = 1, brandId = selectedBrandId })">1</a>
        </li>

        @if (ViewBag.CurrentPage > 3)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
        }

        @for (int i = Math.Max(2, ViewBag.CurrentPage - 1); i <= Math.Min(ViewBag.TotalPages - 1, ViewBag.CurrentPage + 1); i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" href="@Url.Action("BulkUpdatePrices", new { page = i, brandId = selectedBrandId })">@i</a>
            </li>
        }

        @if (ViewBag.CurrentPage < ViewBag.TotalPages - 2)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
        }

        @if (ViewBag.TotalPages > 1)
        {
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "active" : "")">
                <a class="page-link" href="@Url.Action("BulkUpdatePrices", new { page = ViewBag.TotalPages, brandId = selectedBrandId })">@ViewBag.TotalPages</a>
            </li>
        }

        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("BulkUpdatePrices", new { page = ViewBag.CurrentPage + 1, brandId = selectedBrandId })">»</a>
        </li>
    </ul>
</nav>


<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                Kayıt başarılı!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>
<div class="modal fade" id="loadingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg p-4 text-center" style="background: rgba(255, 255, 255, 0.95); border-radius: 1rem;">
            <div class="d-flex justify-content-center mb-3">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
            </div>
            <h5 class="mb-0 fw-semibold text-secondary">Veriler Kaydediliyor.Lütfen bekleyin...</h5>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        // Seçili brandId'yi otomatik olarak seç
        document.addEventListener('DOMContentLoaded', function () {
            const selectedBrand = '@ViewBag.SelectedBrandId';
            const brandFilter = document.getElementById('brandFilter');

            if (brandFilter && selectedBrand) {
                brandFilter.value = selectedBrand;
            }
        });

        // Marka değiştiğinde sayfayı brandId ve page=1 ile yenile
        document.getElementById('brandFilter')?.addEventListener('change', function () {
            const selectedBrandId = this.value;
            const newUrl = new URL(window.location.href);

            newUrl.searchParams.set('brandId', selectedBrandId);
            newUrl.searchParams.set('page', 1); // Marka değiştiğinde sayfa sıfırlanır

            window.location.href = newUrl.toString();
        });

        // Form değişiklik kontrolü
        let isFormChanged = false;
        const form = document.getElementById('integration-form');

        form.querySelectorAll('input').forEach(input => {
            input.addEventListener('change', () => {
                isFormChanged = true;
            });
        });

        form.addEventListener('submit', () => {
            isFormChanged = false;
        });

        // Sayfadan ayrılma uyarısı
        document.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function (e) {
                const href = this.getAttribute('href');

                if (!href || href.startsWith('#')) return;

                if (isFormChanged) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Uyarı',
                        text: 'Kaydedilmemiş değişiklikler var. Sayfadan ayrılmak istiyor musunuz?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Sayfadan Ayrıl',
                        cancelButtonText: 'Sayfada Kal'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = href;
                        }
                    });
                }
            });
        });

        // Form submit işlemi: loading modal + toast + AJAX
        document.getElementById('integration-form').addEventListener('submit', function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);

            const loadingModal = new bootstrap.Modal(document.getElementById('loadingModal'));
            loadingModal.show();

            fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                loadingModal.hide();

                if (data.success) {
                    const toastElement = document.getElementById('successToast');
                    const toast = new bootstrap.Toast(toastElement);
                    toast.show();
                    isFormChanged = false;
                } else {
                    alert("Kayıt başarısız!");
                }
            })
            .catch(error => {
                loadingModal.hide();
                console.error('Hata oluştu:', error);
                alert("Sunucu hatası oluştu.");
            });
        });
    </script>
}
