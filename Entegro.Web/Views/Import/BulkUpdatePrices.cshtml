@model List<ProductIntegrationViewModel>
@{
    ViewData["Title"] = "Toplu Fiyat Güncelleme";
    int selectedBrandId = ViewBag.SelectedBrandId ?? 0;
}
<style>
    .input-changed {
        border: 2px solid #ff9800 !important; /* turuncu çerçeve */
        border-radius: 4px;
        transition: border 0.3s ease;
    }

</style>

<div class="mt-6"></div>
<div class="container-fluid flex-grow-1 container-p-y mt-6">
    <form asp-action="SaveIntegrations" id="integration-form" method="post">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">

            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">Toplu Fiyat Güncelle</h4>
                <p class="mb-0">Toplu Fiyat Güncelle</p>
            </div>

            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("BulkUpdatePrices")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                </div>
                <button type="submit" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header border-bottom">
                        <h5 class="card-title mb-0">Filtreler</h5>
                        <div class="row pt-4 gap-6 gap-md-0 g-md-6">
                            <div class="col-md-4">
                                <div class="row g-2">
                                    <div class="col-8">
                                        <select asp-items="ViewBag.Brands" class="form-select select2" id="brandFilter">
                                            <option></option>
                                        </select>
                                    </div>
                                    <div class="col-4">
                                        <a asp-action="BulkUpdatePrices"
                                           asp-route-brandId="0"
                                           asp-route-page="1"
                                           class="btn btn-primary w-100">
                                            <i class="ti ti-database ti-xs me-1"></i> Sorgula
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Ürün Listesi</h5>
                        @if (selectedBrandId >= 0 && Model != null && Model.Any())
                        {
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-success btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#priceUpdateModal">
                                    <i class="ti ti-calculator ti-xs me-1"></i> Maliyet Fiyatına Göre Güncelle
                                </button>

                                <a href="@Url.Action("ExcelExport", "Import", new { brandId = selectedBrandId })"
                                   class="btn btn-info btn-sm">
                                    <i class="ti ti-file-spreadsheet ti-xs me-1"></i> Excele Aktar
                                </a>
                                <div class="d-flex gap-2">
                                    <input type="file" id="excelFile" class="d-none" accept=".xls,.xlsx" />
                                    <label for="excelFile" class="btn btn-warning btn-sm mb-0">
                                        <i class="ti ti-upload"></i> Excelden Yükle
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="table-responsive">

                        @if (selectedBrandId < 0)
                        {
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Ürün</th>
                                        <th>Marka</th>
                                        <th>Kategori</th>
                                        <th>Maliyet Fiyatı</th>
                                        <th>Liste Fiyatı</th>
                                        <th>Satış Fiyatı</th>
                                    </tr>
                                </thead>
                                <tbody class="table-border-bottom-0">
                                    <tr>
                                        <td colspan="6" style="text-align: center;">Görüntülenecek Kayıt Bulunamadı</td>
                                    </tr>
                                </tbody>
                            </table>
                        }
                        else
                        {
                            if (Model != null && Model.Any())
                            {
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Ürün</th>
                                            <th>Marka</th>
                                            <th>Kategori</th>
                                            <th>Maliyet Fiyatı</th>
                                            <th>Liste Fiyatı</th>
                                            <th>Satış Fiyatı</th>
                                            @foreach (var header in Model.First().IntegrationPrices.Keys)
                                            {
                                                <th>@header</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="table-border-bottom-0">
                                        @for (int i = 0; i < Model.Count; i++)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="[@(i)].ProductId" value="@Model[i].ProductId" />
                                                    <div>
                                                        <strong>@Model[i].ProductName</strong>
                                                    </div>
                                                    <div class="text-muted" style="font-size: 12px;">
                                                        <span><b>Kod:</b> @Model[i].ProductCode</span><br />
                                                    </div>
                                                    <input type="hidden"
                                                           name="[@(i)].IsChanged"
                                                           value="false"
                                                           class="is-changed-flag" />
                                                </td>
                                                <td>@Model[i].ProductBrand</td>
                                                <td>@Model[i].ProductCategory</td>
                                                <td>@Model[i].CostPrice</td>
                                                <td>
                                                    <input type="number" step="0.01"
                                                           name="[@(i)].Price"
                                                           value="@Model[i].Price"
                                                           class="form-control form-control-sm" />
                                                </td>
                                                <td>
                                                    <input type="number" step="0.01"
                                                           name="[@(i)].SalePrice"
                                                           value="@Model[i].SalePrice"
                                                           class="form-control form-control-sm" />
                                                </td>

                                                @foreach (var kvp in Model[i].IntegrationPrices)
                                                {
                                                    var header = kvp.Key;
                                                    var value = kvp.Value;
                                                    <td>
                                                        <input type="hidden"
                                                               name="[@(i)].IntegrationPrices[@(header)].IntegrationSystemId"
                                                               value="@value.IntegrationSystemId" />

                                                        <input type="number" step="0.01"
                                                               name="[@(i)].IntegrationPrices[@(header)].Price"
                                                               value="@value.Price"
                                                               class="form-control form-control-sm" />
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Ürün</th>
                                            <th>Marka</th>
                                            <th>Kategori</th>
                                            <th>Maliyet Fiyatı</th>
                                            <th>Liste Fiyatı</th>
                                            <th>Satış Fiyatı</th>
                                        </tr>
                                    </thead>
                                    <tbody class="table-border-bottom-0">
                                        <tr>
                                            <td colspan="6" style="text-align: center;">Görüntülenecek Kayıt Bulunamadı</td>
                                        </tr>
                                    </tbody>
                                </table>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

    </form>

</div>
<nav aria-label="Sayfalama" class="d-flex justify-content-center">
    <ul class="pagination">
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("BulkUpdatePrices", new { page = ViewBag.CurrentPage - 1, brandId = selectedBrandId })">«</a>
        </li>

        <li class="page-item @(ViewBag.CurrentPage == 1 ? "active" : "")">
            <a class="page-link" href="@Url.Action("BulkUpdatePrices", new { page = 1, brandId = selectedBrandId })">1</a>
        </li>

        @if (ViewBag.CurrentPage > 3)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
        }

        @for (int i = Math.Max(2, ViewBag.CurrentPage - 1); i <= Math.Min(ViewBag.TotalPages - 1, ViewBag.CurrentPage + 1); i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" href="@Url.Action("BulkUpdatePrices", new { page = i, brandId = selectedBrandId })">@i</a>
            </li>
        }

        @if (ViewBag.CurrentPage < ViewBag.TotalPages - 2)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
        }

        @if (ViewBag.TotalPages > 1)
        {
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "active" : "")">
                <a class="page-link" href="@Url.Action("BulkUpdatePrices", new { page = ViewBag.TotalPages, brandId = selectedBrandId })">@ViewBag.TotalPages</a>
            </li>
        }

        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("BulkUpdatePrices", new { page = ViewBag.CurrentPage + 1, brandId = selectedBrandId })">»</a>
        </li>
    </ul>
</nav>
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                Kayıt başarılı!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>
<div class="modal fade" id="priceUpdateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Header -->
            <div class="modal-header p-0 position-relative" style="height: 80px;">
                <div class="d-flex justify-content-center align-items-center w-100 h-100">
                    <h5 class="modal-title m-0">Toplu Fiyat Güncelle</h5>
                </div>
            </div>

            <!-- Body -->
            <div class="modal-body px-4 py-4">
                <form id="priceUpdateForm" class="row g-4" onsubmit="return false">

                    <!-- Card Container -->
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">

                                <!-- Yüzde Kâr Oranı -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="percentValue">
                                        Yüzde Kâr Oranı (%)
                                    </label>
                                    <input type="number" step="0.01" class="form-control" id="percentValue" value="10" required min="0" />
                                    <small class="text-muted">Ürün fiyatına uygulanacak kâr yüzdesi.</small>
                                </div>

                              
                                <!-- Komisyon, Kargo ve Ek Maliyet alanları yan yana -->
                                <div class="row mb-3">
                                    <!-- Komisyon -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="applyCommission">
                                            Komisyon (%)
                                        </label>
                                        <div class="d-flex align-items-center">
                                            <div class="form-check me-3">
                                                <input class="form-check-input" type="checkbox" id="applyCommission">
                                                <label class="form-check-label" for="applyCommission">Uygula</label>
                                            </div>
                                            <div id="commissionBox" class="flex-grow-1" style="display:none;">
                                                <input type="number" step="0.01" class="form-control" id="percentCommissionValue" value="10" min="0" placeholder="Komisyon %" />
                                            </div>
                                        </div>
                                        <small class="text-muted">İsteğe bağlı olarak komisyon oranı ekleyebilirsiniz.</small>
                                    </div>

                                    <!-- Kargo -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="applyShipping">
                                            Kargo
                                        </label>
                                        <div class="d-flex align-items-center">
                                            <div class="form-check me-3">
                                                <input class="form-check-input" type="checkbox" id="applyShipping">
                                                <label class="form-check-label" for="applyShipping">Uygula</label>
                                            </div>
                                            <div id="shippingBox" class="flex-grow-1" style="display:none;">
                                                <input type="number" step="0.01" class="form-control" id="shippingFee" value="10" min="0" placeholder="Kargo ücreti" />
                                            </div>
                                        </div>
                                        <small class="text-muted">İsteğe bağlı kargo ücreti eklenebilir.</small>
                                    </div>

                                    <!-- Ek Maliyet -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="applyExtraCost">
                                            Ek Maliyet
                                        </label>
                                        <div class="d-flex align-items-center">
                                            <div class="form-check me-3">
                                                <input class="form-check-input" type="checkbox" id="applyExtraCost">
                                                <label class="form-check-label" for="applyExtraCost">Uygula</label>
                                            </div>
                                            <div id="extraCostBox" class="flex-grow-1" style="display:none;">
                                                <input type="number" step="0.01" class="form-control" id="extraCostValue" value="0" min="0" placeholder="Ek maliyet (₺)" />
                                            </div>
                                        </div>
                                        <small class="text-muted">Ürüne sabit bir ek maliyet (₺) eklemek için kullanılır.</small>
                                    </div>
                                </div>


                                <hr />

                                <!-- Uygulanacak Sütunlar -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold d-block mb-2">Uygulanacak Sütunlar</label>
                                    <div class="row g-2">

                                        <!-- Liste fiyatı -->
                                        <div class="col-md-3 col-6">
                                            <div class="form-check">
                                                <input class="form-check-input apply-column" type="checkbox" value="Price" id="colPrice">
                                                <label class="form-check-label" for="colPrice">Liste Fiyatı</label>
                                            </div>
                                        </div>

                                        <!-- Satış fiyatı -->
                                        <div class="col-md-3 col-6">
                                            <div class="form-check">
                                                <input class="form-check-input apply-column" type="checkbox" value="SalePrice" id="colSalePrice">
                                                <label class="form-check-label" for="colSalePrice">Satış Fiyatı</label>
                                            </div>
                                        </div>

                                        <!-- Integration fiyatları -->
                                        @if (Model != null && Model.Any())
                                        {
                                            foreach (var header in Model.First().IntegrationPrices.Keys)
                                            {
                                                <div class="col-md-3 col-6">
                                                    <div class="form-check">
                                                        <input class="form-check-input apply-column" type="checkbox" value="@header" id="col_@header">
                                                        <label class="form-check-label" for="col_@header">@header</label>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>


                    <!-- Buttons -->
                    <div class="col-12 text-center pt-3">
                        <button type="button" id="applyPercentBtn" class="btn btn-success px-4 me-2">
                            <i class="bi bi-check-circle me-1"></i> Uygula
                        </button>
                        <button type="reset" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i> Kapat
                        </button>
                    </div>
                </form>
            </div>




        </div>
    </div>
</div>




@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="/assets/js/entegro.bulkupdateprices.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.bulkupdateprices.init("@selectedBrandId");
        });
    </script>

    <script>
        window.excelImportUrl = '@Url.Action("ExcelImport", "Import")';
    </script>
}

