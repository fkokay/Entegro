@model ExcelImportProfileModel
@{
    ViewData["Title"] = "İçe Aktar";
}

<div class="container-fluid flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">İçe Aktar</span></h4>
    <div class="row">
        <div class="col-xl-12 col-lg-7 col-md-7 order-1 order-md-0">
            <div class="card">
                <div class="card-body">
                    <form asp-action="ImportData" asp-controller="Import" method="post" id="importForm">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
                            <div class="d-flex flex-column justify-content-center">
                                <h4 class="mb-1">@ViewBag.Title</h4>
                            </div>

                            <div class="d-flex align-content-center flex-wrap gap-4">
                                <div class="d-flex gap-4">
                                    <a href="@Url.Action("List", "Import")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                                        <span class="d-flex justify-content-center text-nowrap">
                                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                                        </span>
                                    </a>
                                </div>
                                <button type="submit" class="btn btn-primary waves-effect waves-light">
                                    <span class="d-flex justify-content-center text-nowrap">
                                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                                    </span>
                                </button>
                            </div>
                        </div>
                        <input asp-for="MediaFileId" type="hidden" class="form-control" />
                        <div class="col-md-12 mt-3">
                            <div class="row">
                                <label class="col-sm-3 col-form-label text-sm-start" for="ProfileName">Profil Adı</label>
                                <div class="col-sm-9">
                                    <input asp-for="ProfileName" type="text" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <table class="table table-bordered mt-3">
                            <thead>
                                <tr>
                                    <th>Excel Kolonu</th>
                                    <th>İçe Aktarılsın mı?</th>
                                    <th>Veritabanı Kolonu</th>
                                    <th>Varsayılan(Default Değer)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.ColumnMappings.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="text" name="ColumnMappings[@i].ExcelHeader" value="@Model.ColumnMappings[i].ExcelHeader" readonly class="form-control" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" name="ColumnMappings[@i].IsImport" value="true" />
                                            <input type="hidden" name="ColumnMappings[@i].IsImport" value="false" />
                                        </td>
                                        <td>
                                            <select name="ColumnMappings[@i].DbColumn" class="select2 form-select" asp-items="ViewBag.DbColumns">
                                                <option value="">-- Seçiniz --</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" name="ColumnMappings[@i].DefaultValue" value="@Model.ColumnMappings[i].DefaultValue" class="form-control" />
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
   
    <style>

        .select2-container--default .select2-selection.is-invalid {
            border: 1px solid #dc3545 !important;
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, .25);
        }
    </style>

    <script src="/assets/js/entegro.mapcolumns.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.mapcolumns.init();
        });
    </script>
}



