@model List<ColumnMapping>
@{
    ViewData["Title"] = "İçe Aktar";
}
<div class="container-fluid flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Eşleştirme Yap</span></h4>
    <div class="row">

        <form asp-action="ImportData" asp-controller="Import" method="post" id="importForm">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Excel Kolonu</th>
                        <th>İçe Aktarılsın mı?</th>
                        <th>Veritabanı Kolonu</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>
                                <input type="text" name="[@i].ExcelHeader" value="@Model[i].ExcelHeader" readonly class="form-control" />
                            </td>
                            <td class="text-center">
                                <input type="checkbox" name="[@i].IsImport" value="true" />
                            </td>
                            <td>
                                <select name="[@i].DbColumn" class="form-control">
                                    <option value="">-- Seçiniz --</option>
                                    <option value="Name">Name</option>
                                    <option value="Stock">Stock</option>
                                    <option value="Barcode">Barcode</option>
                                    <option value="StockQuantity">StockQuantity</option>
                                    <option value="Status">Status</option>
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="submit" class="btn btn-success">İçe Aktar</button>
        </form>

        
        <div id="loadingModal" style="display:none; position:fixed; top:0; left:0;
    width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999;
    text-align:center; padding-top:200px;">
            <div class="spinner-border text-light" role="status" style="width:4rem; height:4rem;"></div>
            <h4 class="text-white mt-3">Lütfen bekleyiniz...</h4>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("importForm").addEventListener("submit", function (e) {
            let isValid = true;
            let hasAnyChecked = false;
            const rows = document.querySelectorAll("tbody tr");

            rows.forEach((row, index) => {
                const checkbox = row.querySelector(`input[name="[${index}].IsImport"]`);
                const select = row.querySelector(`select[name="[${index}].DbColumn"]`);

                if (checkbox.checked) {
                    hasAnyChecked = true;
                    if (select.value === "") {
                        isValid = false;
                        select.classList.add("is-invalid");
                    } else {
                        select.classList.remove("is-invalid");
                    }
                } else {
                    select.classList.remove("is-invalid");
                }
            });

            if (!hasAnyChecked) {
                e.preventDefault();
                alert("Lütfen en az bir satır için 'İçe Aktarılsın mı?' kutucuğunu işaretleyin.");
                return;
            }

            if (!isValid) {
                e.preventDefault();
                alert("İşaretlenen satırların veritabanı kolonu boş bırakılamaz.");
                return;
            }
            document.getElementById("loadingModal").style.display = "block";
        });
    </script>
}
