@model CreateXmlImportProfileModel
@{
    ViewData["Title"] = "XmlMapping";
    var paths = ViewBag.XmlPaths as List<string>;
    var variantPaths = paths.Where(x => x.StartsWith("variants->variant->0->")).ToList();
    var variantCount = paths.Where(p => p.StartsWith("variants->variant->")).Select(p =>
    {
        var parts = p.Split("->", StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 3 && int.TryParse(parts[2], out int index))
        {
            return index;
        }
        return -1;
    })
    .Where(index => index >= 0)
    .Distinct()
    .Count();

}
<div class="container-fluid flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold py-3 mb-0">
            <span class="text-muted fw-light">XML Kaynağı Oluştur</span>
        </h4>

        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#xmlStructureModal">
            XML Kaynağını İncele
        </button>
    </div>

    <div class="row">
        <div class="col-xl-12 col-lg-7 col-md-7 order-1 order-md-0">

            <form asp-action="XmlMapping" asp-controller="Import" method="post" onsubmit="return validateForm();">

                <input type="hidden" id="SelectedImagePaths" name="SelectedImagePaths" />
                <input type="hidden" id="SelectedAttributeSpecifications" name="SelectedAttributeSpecifications" />
                <input type="hidden" name="VariantCount" value="@variantCount" />
                <input type="hidden" asp-for="ProfileName"  />
                <input type="hidden" asp-for="MediaFileUrl" />
                <div class="card">

                    <!--Genel Bilgiler-->
                    <h5 class="card-header">Genel Bilgiler</h5>
                    <div class="card-body" id="genelBilgiler">

                        <div class="row">
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Name" class="form-label">Ürün Adı *</label>
                                <select asp-for="CreateXmlProduct.Name" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Brand" class="form-label">Marka</label>
                                <select asp-for="CreateXmlProduct.Brand" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Barcode" class="form-label">Barkod *</label>
                                <select asp-for="CreateXmlProduct.Barcode" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.ManufacturerPartNumber" class="form-label">Üretici Numarası</label>
                                <select asp-for="CreateXmlProduct.ManufacturerPartNumber" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Gtin" class="form-label">Gtin </label>
                                <select asp-for="CreateXmlProduct.Gtin" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Height" class="form-label">Ağırlık </label>
                                <select asp-for="CreateXmlProduct.Height" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Unit" class="form-label">Birim </label>
                                <select asp-for="CreateXmlProduct.Unit" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Description" class="form-label">Açıklama </label>
                                <select asp-for=CreateXmlProduct.Description class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>

                    </div>


                    <!--Stok Bilgileri-->
                    <hr />
                    <h5 class="card-header">Stok Bilgiler</h5>
                    <div class="card-body" id="stokBilgileri">
                        <div class="row">
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Code" class="form-label">Stok Kodu *</label>
                                <select asp-for="CreateXmlProduct.Code" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.StockQuantity" class="form-label">Stok Adedi *</label>
                                <select asp-for="CreateXmlProduct.StockQuantity" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>

                    </div>


                    <!--Fiyat Bilgileri-->
                    <hr />
                    <h5 class="card-header">Fiyat Bilgileri</h5>
                    <div class="card-body" id="fiyatBilgileri">
                        <div class="row">
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Price" class="form-label">Mağaza Satış Fiyatı *</label>
                                <select asp-for="CreateXmlProduct.Price" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mt-1">
                                <label for="piyasaFiyat" class="form-label">Piyasa Satış Fiyatı *</label>
                                <select id="piyasaFiyat" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Currency" class="form-label">Para Birimi</label>
                                <select asp-for="CreateXmlProduct.Currency" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.VatInc" class="form-label">KDV Dahil</label>
                                <select asp-for="CreateXmlProduct.VatInc" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    <option value="0">Hayır</option>
                                    <option value="1">Evet</option>
                                </select>
                            </div>

                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.VatRate" class="form-label">KDV Oranı</label>
                                <select asp-for="CreateXmlProduct.VatRate" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>


                            <!-- Fiyat Artışı Alanları -->
                            <div class="col-md-12 mt-3">
                                <label class="form-label">Fiyat Artışı</label>

                                <!-- Fiyat Artışı Uygula -->
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           asp-for="CreateXmlProduct.ApplyPriceAdjustment"
                                           value="uygula"
                                           id="fiyatArtisiUygula" />
                                    <label class="form-check-label" for="fiyatArtisiUygula">
                                        Fiyat Artışı Uygula
                                    </label>
                                </div>

                                <!-- Fiyat Artışı Uygulanmadan Devam Et -->
                                <div class="form-check mt-2">
                                    <input class="form-check-input"
                                           type="radio"
                                           asp-for="CreateXmlProduct.ApplyPriceAdjustment"
                                           value="devam"
                                           id="fiyatArtisiUygulama" checked />
                                    <label class="form-check-label" for="fiyatArtisiUygulama">
                                        Fiyat Artışı Uygulamadan Devam Et
                                    </label>
                                </div>

                                <!-- İşlem Türü Alanları -->
                                <div id="islemTuruAlanlari" class="row mt-3" style="display: none;">
                                    <div class="col-md-6">
                                        <label asp-for="CreateXmlProduct.PriceAdjustmentType" class="form-label">İşlem Türü *</label>
                                        <select asp-for="CreateXmlProduct.PriceAdjustmentType" class="form-select">
                                            <option value="">Seçiniz</option>
                                            <option value="yuzde">Yüzde</option>
                                            <option value="sabit">Sabit</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="CreateXmlProduct.PriceAdjustmentAmount" class="form-label">İşlem Tutarı *</label>
                                        <input asp-for="CreateXmlProduct.PriceAdjustmentAmount" class="form-control" placeholder="Örn. 30" />
                                    </div>

                                    <div class="col-md-12 mt-2">
                                        <label asp-for="CreateXmlProduct.OptionalExtraAmount" class="form-label">Opsiyonel Ek Tutar</label>
                                        <input asp-for="CreateXmlProduct.OptionalExtraAmount" class="form-control" placeholder="Örn. 30" />
                                        <small class="form-text text-muted">Para birimi XML kaynağındaki para birimi ile aynıdır.</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Bitiş -->
                        </div>
                    </div>

                    <!--Ürün Görselleri-->
                    <hr />
                    <h5 class="card-header">Ürün Görselleri</h5>
                    <div class="card-body" id="urunGorselleri">
                        <div class="row">
                            <div class="col-md-6">
                                <label asp-for="CreateXmlProduct.Images" class="form-label">Ürün Görselleri (birden fazla seçilebilir)</label>
                                <select asp-for="CreateXmlProduct.Images" class="form-select select2" multiple="multiple">
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!--Kategoriler-->
                    <hr />
                    <h5 class="card-header">Kategoriler</h5>
                    <div class="card-body" id="categories">
                        <div class="row">
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.Categories" class="form-label">Kategoriler</label>
                                <select asp-for="CreateXmlProduct.Categories" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>



                    <!--Varyantlar-->
                    <hr />
                    <h5 class="card-header">Varyantlar</h5>
                    <div class="card-body" id="variantBody">
                        <div class="row">
                            <!-- Varyantlı Ürün mü? seçeneği -->
                            <div class="col-md-6 mt-1">
                                <label class="form-label">Varyantlı Ürün mü?</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="CreateXmlProduct.IsVariantProduct" id="variantYes" value="yes">
                                    <label class="form-check-label" for="variantYes">Evet</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="CreateXmlProduct.IsVariantProduct" id="variantNo" value="no" checked>
                                    <label class="form-check-label" for="variantNo">Hayır</label>
                                </div>
                            </div>
                        </div>

                        <!-- Diğer varyant alanlarını kapsayan row -->
                        <div class="row" id="variantFieldsRow" style="display: none;">
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.AttributeStockCode" class="form-label">Varyant Ürün Kodu</label>
                                <select asp-for="CreateXmlProduct.AttributeStockCode" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in variantPaths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.AttributeManufacturerPartNumber" class="form-label">Varyant Üretici Numarası</label>
                                <select asp-for="CreateXmlProduct.AttributeManufacturerPartNumber" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in variantPaths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.AttributeGtin" class="form-label">Varyant Gtin </label>
                                <select asp-for="CreateXmlProduct.AttributeGtin" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in variantPaths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.AttributePrice" class="form-label">Varyant Fiyat </label>
                                <select asp-for="CreateXmlProduct.AttributePrice" class="form-select select2" id="variantPrice">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.AttributeStockQuantity" class="form-label">Varyant Stok Miktarı </label>
                                <select asp-for="CreateXmlProduct.AttributeStockQuantity" class="form-select select2" id="variantStockQuantity">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in variantPaths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.AttributeSpecifications" class="form-label">Varyant Stok Özellikler (birden fazla seçilebilir)</label>
                                <select asp-for="CreateXmlProduct.AttributeSpecifications" class="form-select select2" multiple="multiple">
                                    @foreach (var item in variantPaths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!--Arama Motorları-->
                    <hr />
                    <h5 class="card-header">Arama Motorları</h5>
                    <div class="card-body" id="searchEngine">
                        <div class="row">
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.MetaTitle" class="form-label">Meta Başlık</label>
                                <select asp-for="CreateXmlProduct.MetaTitle" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.MetaKeywords" class="form-label">Anahtar Kelimeler</label>
                                <select asp-for="CreateXmlProduct.MetaKeywords" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="CreateXmlProduct.MetaDescription" class="form-label">Meta Açıklama</label>
                                <select asp-for="CreateXmlProduct.MetaDescription" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>


                    <div class="text-center mb-3">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>


<div class="modal fade" id="xmlStructureModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3 class="mb-2">XML</h3>
                    <p class="text-muted">XML kaynağındaki ürün konumundaki ürünlerden yalnızca biri gösterilir.</p>
                </div>
                <pre>@Html.Raw(System.Net.WebUtility.HtmlEncode(ViewBag.PreviewXml))</pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {


    <script>
          $(document).ready(function () {
              $('.select2').select2({
                  placeholder: "Bir seçenek seçin",
                  allowClear: true,
                  width: '100%'
              });
          });

            function validateForm() {
            // Genel Bilgiler
            const barcode = $('[name="CreateXmlProduct.Barcode"]').val();
            const productName = $('[name="CreateXmlProduct.Name"]').val();

            if (!barcode) {
                alert("Lütfen Genel Bilgiler bölümündeki Barkod alanını doldurun.");
                return false;
            }

            if (!productName) {
                alert("Lütfen Genel Bilgiler bölümündeki Ürün Adı alanını doldurun.");
                return false;
            }

            // Stok Bilgileri
            const stockCode = $('[name="CreateXmlProduct.Code"]').val();
            const stockQuantity = $('[name="CreateXmlProduct.StockQuantity"]').val();

            if (!stockCode || !stockQuantity) {
                alert("Lütfen Stok Bilgileri bölümündeki Stok Kodu ve Stok Adedi alanlarını doldurun.");
                return false;
            }

            // Fiyat Bilgileri
            const price = $('[name="CreateXmlProduct.Price"]').val();
            const marketPrice = $('#piyasaFiyat').val();

            if (!price) {
                alert("Lütfen Fiyat Bilgileri bölümündeki Mağaza Satış Fiyatı alanını doldurun.");
                return false;
            }

            if (!marketPrice) {
                alert("Lütfen Fiyat Bilgileri bölümündeki Piyasa Satış Fiyatı alanını doldurun.");
                return false;
            }

            // Fiyat Artışı Kontrolü
            const applyPriceAdjustment = $('[name="CreateXmlProduct.ApplyPriceAdjustment"]:checked').val();
            if (applyPriceAdjustment === "uygula") {
                const priceAdjustmentType = $('[name="CreateXmlProduct.PriceAdjustmentType"]').val();
                const priceAdjustmentAmount = $('[name="CreateXmlProduct.PriceAdjustmentAmount"]').val();

                if (!priceAdjustmentType || !priceAdjustmentAmount) {
                    alert("Lütfen Fiyat Artışı işlem türü ve işlem tutarı alanlarını doldurun.");
                    return false;
                }
            }

            // Varyantlı Ürün Kontrolü
            const isVariantProduct = $('input[name="CreateXmlProduct.IsVariantProduct"]:checked').val();
            if (isVariantProduct === "yes") {
                const variantPrice = $('[name="CreateXmlProduct.AttributePrice"]').val();
                const variantStockQty = $('[name="CreateXmlProduct.AttributeStockQuantity"]').val();

                if (!variantPrice || !variantStockQty) {
                    alert("Lütfen Varyant Fiyat ve Varyant Stok Miktarı alanlarını doldurun.");
                    return false;
                }
            }

            // Ürün Görselleri
            const selectedImages = $('[name="CreateXmlProduct.Images"]').val();
            $('[name="SelectedImagePaths"]').val(selectedImages && selectedImages.length > 0 ? selectedImages.join(',') : '');

            // Varyant Özellikleri (birden fazla seçilebilir)
            const selectedAttributeSpecifications = $('[name="CreateXmlProduct.AttributeSpecifications"]').val();
            $('[name="SelectedAttributeSpecifications"]').val(selectedAttributeSpecifications && selectedAttributeSpecifications.length > 0 ? selectedAttributeSpecifications.join(',') : '');

            return true;
        }


    </script>

    <script>
         document.addEventListener("DOMContentLoaded", function () {
            const islemTuruAlanlari = document.getElementById("islemTuruAlanlari");
            const islemTuru = document.querySelector('[name="CreateXmlProduct.PriceAdjustmentType"]');
            const islemTutari = document.querySelector('[name="CreateXmlProduct.PriceAdjustmentAmount"]');

            const fiyatArtisiRadioButtons = document.querySelectorAll('input[name="CreateXmlProduct.ApplyPriceAdjustment"]');

            function toggleIslemTuru() {
                const selectedValue = document.querySelector('input[name="CreateXmlProduct.ApplyPriceAdjustment"]:checked')?.value;

                if (selectedValue === "uygula") {
                    islemTuruAlanlari.style.display = "flex";
                    islemTuru?.setAttribute("required", "required");
                    islemTutari?.setAttribute("required", "required");
                } else {
                    islemTuruAlanlari.style.display = "none";
                    islemTuru?.removeAttribute("required");
                    islemTutari?.removeAttribute("required");
                }
            }

            toggleIslemTuru();

            fiyatArtisiRadioButtons.forEach(radio => {
                radio.addEventListener("change", toggleIslemTuru);
            });
        });


    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const variantFieldsRow = document.getElementById("variantFieldsRow");
            const variantRadios = document.querySelectorAll('input[name="CreateXmlProduct.IsVariantProduct"]');
            const attrStockQuantity = document.getElementById("variantStockQuantity");
            const attrPrice = document.getElementById("variantPrice");

            function toggleVariantFields() {
                const selected = document.querySelector('input[name="CreateXmlProduct.IsVariantProduct"]:checked').value;

                if (selected === "yes") {
                    variantFieldsRow.style.display = "flex";
                    attrStockQuantity?.setAttribute("required", "required");
                    attrPrice?.setAttribute("required", "required");
                } else {
                    variantFieldsRow.style.display = "none";
                    attrStockQuantity?.removeAttribute("required");
                    attrPrice?.removeAttribute("required");
                }
            }

            // Sayfa yüklendiğinde başlat
            toggleVariantFields();

            variantRadios.forEach(radio => {
                radio.addEventListener("change", toggleVariantFields);
            });
        });

    </script>


}
