@model XmlImportProfileViewModel
@{
    ViewData["Title"] = "XmlMapping";

    var variantPaths = Model.Paths.Where(x => x.StartsWith("variants->variant->0->")).ToList();
    var variantCount = Model.Paths.Where(p => p.StartsWith("variants->variant->")).Select(p =>
    {
        var parts = p.Split("->", StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 3 && int.TryParse(parts[2], out int index))
        {
            return index;
        }
        return -1;
    })
    .Where(index => index >= 0)
    .Distinct()
    .Count();

}
<div class="container-fluid flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold py-3 mb-0">
            <span class="text-muted fw-light">XML Kaynağı Oluştur</span>
        </h4>

        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#xmlStructureModal">
            XML Kaynağını İncele
        </button>
    </div>

    <div class="row">
        <div class="col-xl-12 col-lg-7 col-md-7 order-1 order-md-0">

            <form asp-action="XmlMappingAdd" asp-controller="Import" method="post" onsubmit="return validateForm();">

                <input type="hidden" id="SelectedImagePaths" name="SelectedImagePaths" />
                <input type="hidden" id="SelectedAttributeSpecifications" name="SelectedAttributeSpecifications" />
                <input type="hidden" name="VariantCount" value="@variantCount"/>
                <input type="hidden" asp-for="MediaFileUrl" />
                <div class="card">

                    <!--Genel Bilgiler-->
                    <h5 class="card-header">Genel Bilgiler</h5>
                    <div class="card-body" id="genelBilgiler">

                        <div class="row">
                            <div class="col-md-6 mt-1">
                                <label for="Name" class="form-label">Ürün Adı *</label>
                                <select asp-for="Name" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="Brand" class="form-label">Marka</label>
                                <select asp-for="Brand" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="Barcode" class="form-label">Barkod *</label>
                                <select asp-for="Barcode" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="ManufacturerPartNumber" class="form-label">Üretici Numarası</label>
                                <select asp-for="ManufacturerPartNumber" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="Gtin" class="form-label">Gtin </label>
                                <select asp-for="Gtin" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="Height" class="form-label">Ağırlık </label>
                                <select asp-for="Height" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="Unit" class="form-label">Birim </label>
                                <select asp-for="Unit" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="Description" class="form-label">Açıklama </label>
                                <select asp-for=Description class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>

                    </div>


                    <!--Stok Bilgileri-->
                    <hr />
                    <h5 class="card-header">Stok Bilgiler</h5>
                    <div class="card-body" id="stokBilgileri">
                        <div class="row">
                            <div class="col-md-6 mt-1">
                                <label asp-for="Code" class="form-label">Stok Kodu *</label>
                                <select asp-for="Code" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="StockQuantity" class="form-label">Stok Adedi *</label>
                                <select asp-for="StockQuantity" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>

                    </div>


                    <!--Fiyat Bilgileri-->
                    <hr />
                    <h5 class="card-header">Fiyat Bilgileri</h5>
                    <div class="card-body" id="fiyatBilgileri">
                        <div class="row">
                            <div class="col-md-6 mt-1">
                                <label asp-for="Price" class="form-label">Mağaza Satış Fiyatı *</label>
                                <select asp-for="Price" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mt-1">
                                <label for="piyasaFiyat" class="form-label">Piyasa Satış Fiyatı *</label>
                                <select id="piyasaFiyat" class="form-select select2" required>
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mt-1">
                                <label asp-for="Currency" class="form-label">Para Birimi</label>
                                <select asp-for="Currency" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mt-1">
                                <label asp-for="VatInc" class="form-label">KDV Dahil</label>
                                <select asp-for="VatInc" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    <option value="0">Hayır</option>
                                    <option value="1">Evet</option>
                                </select>
                            </div>

                            <div class="col-md-6 mt-1">
                                <label asp-for="VatRate" class="form-label">KDV Oranı</label>
                                <select asp-for="VatRate" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>


                            <!-- Fiyat Artışı Alanları -->
                            <div class="col-md-12 mt-3">
                                <label class="form-label">Fiyat Artışı</label>

                                <!-- Fiyat Artışı Uygula -->
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           asp-for="ApplyPriceAdjustment"
                                           value="uygula"
                                           id="fiyatArtisiUygula" />
                                    <label class="form-check-label" for="fiyatArtisiUygula">
                                        Fiyat Artışı Uygula
                                    </label>
                                </div>

                                <!-- Fiyat Artışı Uygulanmadan Devam Et -->
                                <div class="form-check mt-2">
                                    <input class="form-check-input"
                                           type="radio"
                                           asp-for="ApplyPriceAdjustment"
                                           value="devam"
                                           id="fiyatArtisiUygulama" checked/>
                                    <label class="form-check-label" for="fiyatArtisiUygulama">
                                        Fiyat Artışı Uygulamadan Devam Et
                                    </label>
                                </div>

                                <!-- İşlem Türü Alanları -->
                                <div id="islemTuruAlanlari" class="row mt-3" style="display: none;">
                                    <div class="col-md-6">
                                        <label asp-for="PriceAdjustmentType" class="form-label">İşlem Türü *</label>
                                        <select asp-for="PriceAdjustmentType" class="form-select">
                                            <option value="">Seçiniz</option>
                                            <option value="yuzde">Yüzde</option>
                                            <option value="sabit">Sabit</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="PriceAdjustmentAmount" class="form-label">İşlem Tutarı *</label>
                                        <input asp-for="PriceAdjustmentAmount" class="form-control" placeholder="Örn. 30" />
                                    </div>

                                    <div class="col-md-12 mt-2">
                                        <label asp-for="OptionalExtraAmount" class="form-label">Opsiyonel Ek Tutar</label>
                                        <input asp-for="OptionalExtraAmount" class="form-control" placeholder="Örn. 30" />
                                        <small class="form-text text-muted">Para birimi XML kaynağındaki para birimi ile aynıdır.</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Bitiş -->
                        </div>
                    </div>

                    <!--Ürün Görselleri-->
                    <hr />
                    <h5 class="card-header">Ürün Görselleri</h5>
                    <div class="card-body" id="urunGorselleri">
                        <div class="row">
                            <div class="col-md-6">
                                <label asp-for="Images" class="form-label">Ürün Görselleri (birden fazla seçilebilir)</label>
                                <select asp-for="Images" class="form-select select2" multiple="multiple">
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!--Kategoriler-->
                    <hr />
                    <h5 class="card-header">Kategoriler</h5>
                    <div class="card-body" id="categories">
                        <div class="row">
                            <div class="col-md-6 mt-1">
                                <label asp-for="Categories" class="form-label">Kategoriler</label>
                                <select asp-for="Categories" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>



                    <!--Varyantlar-->
                    <hr />
                    <h5 class="card-header">Varyantlar</h5>
                    <div class="card-body" id="variantBody">
                        <div class="row">
                            <!-- Varyantlı Ürün mü? seçeneği -->
                            <div class="col-md-6 mt-1">
                                <label class="form-label">Varyantlı Ürün mü?</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="IsVariantProduct" id="variantYes" value="yes">
                                    <label class="form-check-label" for="variantYes">Evet</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="IsVariantProduct" id="variantNo" value="no" checked>
                                    <label class="form-check-label" for="variantNo">Hayır</label>
                                </div>
                            </div>
                        </div>

                        <!-- Diğer varyant alanlarını kapsayan row -->
                        <div class="row" id="variantFieldsRow" style="display: none;">
                            <div class="col-md-6 mt-1">
                                <label asp-for="AttributeStockCode" class="form-label">Varyant Ürün Kodu</label>
                                <select asp-for="AttributeStockCode" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in variantPaths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="AttributeManufacturerPartNumber" class="form-label">Varyant Üretici Numarası</label>
                                <select asp-for="AttributeManufacturerPartNumber" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in variantPaths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="AttributeGtin" class="form-label">Varyant Gtin </label>
                                <select asp-for="AttributeGtin" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in variantPaths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="AttributePrice" class="form-label">Varyant Fiyat </label>
                                <select asp-for="AttributePrice" class="form-select select2" id="variantPrice">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="AttributeStockQuantity" class="form-label">Varyant Stok Miktarı </label>
                                <select asp-for="AttributeStockQuantity" class="form-select select2" id="variantStockQuantity">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in variantPaths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="AttributeSpecifications" class="form-label">Varyant Stok Özellikler (birden fazla seçilebilir)</label>
                                <select asp-for="AttributeSpecifications" class="form-select select2" multiple="multiple">
                                    @foreach (var item in variantPaths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>




                    <!--Arama Motorları-->
                    <hr />
                    <h5 class="card-header">Arama Motorları</h5>
                    <div class="card-body" id="searchEngine">
                        <div class="row">
                            <div class="col-md-6 mt-1">
                                <label asp-for="MetaTitle" class="form-label">Meta Başlık</label>
                                <select asp-for="MetaTitle" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="MetaKeywords" class="form-label">Anahtar Kelimeler</label>
                                <select asp-for="MetaKeywords" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mt-1">
                                <label asp-for="MetaDescription" class="form-label">Meta Açıklama</label>
                                <select asp-for="MetaDescription" class="form-select select2">
                                    <option value="">Seçiniz</option>
                                    @foreach (var item in Model.Paths)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>


                    <div class="text-center mb-3">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>


<div class="modal fade" id="xmlStructureModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3 class="mb-2">XML</h3>
                    <p class="text-muted">XML kaynağındaki ürün konumundaki ürünlerden yalnızca biri gösterilir.</p>
                </div>
                <pre>@Html.Raw(System.Net.WebUtility.HtmlEncode(Model.PreviewXml))</pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {


    <script>
        $(document).ready(function () {
            $('.select2').select2({
                placeholder: "Bir seçenek seçin",
                allowClear: true,
                width: '100%'
            });
        });

     function validateForm() {
            let isValid = true;

            if (!$('#Barcode').val()) {
                alert("Lütfen Genel Bilgiler bölümündeki alanları doldurun.");
                return false;
            }

            if (!$('#Code').val() || !$('#StockQuantity').val()) {
                alert("Lütfen Stok Bilgileri bölümündeki alanları doldurun.");
                return false;
            }

            if (!$('#Price').val()) {
                alert("Lütfen Fiyat Bilgileri bölümündeki alanları doldurun.");
                return false;
            }

            // Eğer fiyat artışı uygulanıyorsa işlem türü ve işlem tutarı kontrolü yap
                const applyPriceAdjustment = $('input[name="ApplyPriceAdjustment"]:checked').val();

             if (applyPriceAdjustment === "uygula") {
                 if (!$('[name="PriceAdjustmentType"]').val() || !$('[name="PriceAdjustmentAmount"]').val()) {
                     alert("Lütfen işlem türü ve işlem tutarı alanlarını doldurun.");
                     return false;
                 }
             }
                const isVariantProduct = $('input[name="IsVariantProduct"]:checked').val();
                if (isVariantProduct === "yes") {
                    const variantPrice = $('[name="AttributePrice"]').val();
                    const variantStockQty = $('[name="AttributeStockQuantity"]').val();

                    if (!variantPrice || !variantStockQty) {
                        alert("Lütfen Varyant Fiyat ve Varyant Stok Miktarı alanlarını doldurun.");
                        return false;
                    }
                }


            // Seçilen görselleri işle
            var selectedImages = $('#Images').val();
            $('#SelectedImagePaths').val(selectedImages && selectedImages.length > 0 ? selectedImages.join(',') : '');
            
            
            // Seçilen özellikleri işle
            var selectedAttributeSpecifications = $('#AttributeSpecifications').val();
            $('#SelectedAttributeSpecifications').val(selectedAttributeSpecifications && selectedAttributeSpecifications.length > 0 ? selectedAttributeSpecifications.join(',') : '');

            return true;
        }

    </script>

    <script>
     document.addEventListener("DOMContentLoaded", function () {
        const islemTuruAlanlari = document.getElementById("islemTuruAlanlari");
        const islemTuru = document.querySelector('[name="PriceAdjustmentType"]');
        const islemTutari = document.querySelector('[name="PriceAdjustmentAmount"]');
    
        const fiyatArtisiRadioButtons = document.querySelectorAll('input[name="ApplyPriceAdjustment"]');
    
        function toggleIslemTuru() {
            const selectedValue = document.querySelector('input[name="ApplyPriceAdjustment"]:checked')?.value;
    
            if (selectedValue === "uygula") {
                islemTuruAlanlari.style.display = "flex";
                islemTuru?.setAttribute("required", "required");
                islemTutari?.setAttribute("required", "required");
            } else {
                islemTuruAlanlari.style.display = "none";
                islemTuru?.removeAttribute("required");
                islemTutari?.removeAttribute("required");
            }
        }
    
        toggleIslemTuru();
    
        fiyatArtisiRadioButtons.forEach(radio => {
            radio.addEventListener("change", toggleIslemTuru);
        });
    });

    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const variantFieldsRow = document.getElementById("variantFieldsRow");
            const variantRadios = document.querySelectorAll('input[name="IsVariantProduct"]');
            const attrStockQuantity = document.getElementById("variantStockQuantity");
            const attrPrice = document.getElementById("variantPrice");

            function toggleVariantFields() {
                const selected = document.querySelector('input[name="IsVariantProduct"]:checked').value;

                if (selected === "yes") {
                    variantFieldsRow.style.display = "flex";
                    attrStockQuantity?.setAttribute("required", "required");
                    attrPrice?.setAttribute("required", "required");
                } else {
                    variantFieldsRow.style.display = "none";
                    attrStockQuantity?.removeAttribute("required");
                    attrPrice?.removeAttribute("required");
                }
            }

            // Sayfa yüklendiğinde başlat
            toggleVariantFields();

            variantRadios.forEach(radio => {
                radio.addEventListener("change", toggleVariantFields);
            });
        });
    </script>


}
