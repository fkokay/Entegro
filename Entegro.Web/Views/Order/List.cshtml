@model OrderListModel
@{
    ViewData["Title"] = "Siparişler";
}
<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>
    <div class="card">
        <div class="order-actions border-bottom p-4 d-flex">
            <button class="btn active" data-order-status="1">Paketlenecek <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.ToBePackedQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="2">Gönderime Hazır <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.ReadyToShipQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="3">Kargoda <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.ShippedQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="4">Teslim Edildi <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.DeliveredQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="5">Teslim Edilemedi <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.UnDeliverdQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="6">Ödemesi Bekleniyor <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.PaymentAwaitingQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="7">İptal Edildi <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.CancalledQuantity</span></button>
        </div>
        <div class="p-5">
            <div class="row">
                <div class="col-2 mb-2">
                    <label for="filterCustomerName" class="form-label">Müşteri Adı</label>
                    <input type="text" class="form-control" id="filterCustomerName" placeholder="Müşteri Adı" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterOrderNo" class="form-label">Sipariş No</label>
                    <input type="text" class="form-control" id="filterOrderNo" placeholder="Sipariş No" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterPackageNo" class="form-label">Paket No</label>
                    <input type="text" class="form-control" id="filterPackageNo" placeholder="Paket No" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterBarcode" class="form-label">Barkod</label>
                    <input type="text" class="form-control" id="filterBarcode" placeholder="Barkod" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterCargoCode" class="form-label">Kargo Kodu</label>
                    <input type="text" class="form-control" id="filterCargoCode" placeholder="Kargo Kodu" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterProduct" class="form-label">Ürün Adı / Model Kodu</label>
                    <input type="text" class="form-control" id="filterProduct" placeholder="Ürün Adı / Model Kodu" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterStartDate" class="form-label">Sipariş Başlangıç Tarihi</label>
                    <input type="date" class="form-control" id="filterStartDate" placeholder="Başlangıç Tarihi" />
                </div>
                <div class="col-2 mb-2">
                    <label for="filterEndDate" class="form-label">Sipariş Bitiş Tarihi</label>
                    <input type="date" class="form-control" id="filterEndDate" placeholder="Bitiş Tarihi" />
                </div>
                <div class="col-2 mb-2 d-flex gap-2 align-items-end">
                    <button id="btnFilter" class="btn btn-primary w-100">Filtrele</button>
                    <button id="btnClear" class="btn btn-secondary w-100">Temizle</button>
                </div>
            </div>

        </div>

        <div class="card-datatable table-responsive border-top">
            <table id="OrderTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                <thead>
                    <tr>
                        <th></th>
                        <th>Id</th>
                        <th>Sipariş Kaynağı</th>
                        <th>Sipariş Bilgileri</th>
                        <th>Alıcı</th>
                        <th>Bilgiler</th>
                        <th>Kargo</th>
                        <th>Fatura</th>
                        <th>Ödeme</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="OrderPackageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-header">
                <h5 class="modal-title" id="OrderPackageModalLabel">Paket Hazırlama</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                <button type="button" class="btn btn-warning orderpackage-save">Paketi Onayla</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ProudctIntegrationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <form asp-action="/Order/CreateProductIntegration" method="post" id="CreateProductIntegrationForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="ProudctIntegrationModalLabel">Ürün Eşleştirme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-5">
                        <input type="hidden" id="IntegrationSystemId" name="IntegrationSystemId" />
                        <input type="hidden" id="OrderItemId" name="OrderItemId" />
                        <input type="hidden" id="IntegrationCode" name="IntegrationCode" />
                        <!-- Kategori Seçimi -->
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductIntegrationName">Trendyol Ürün Adı</label>
                            <input type="text" id="ProductIntegrationName" name="ProductIntegrationName" class="form-control" disabled />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductIntegrationSku">Trendyol Ürün Kodu</label>
                            <input type="text" id="ProductIntegrationSku" name="ProductIntegrationSku" class="form-control" disabled />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductId">Ürün</label>
                            <select id="ProductId" name="ProductId" class="select2 form-select"></select>
                        </div>
                        <div id="ProductVariantAttributeCombination" class="col-md-12" style="display:none;">
                            <label class="form-label text-sm-start" for="ProductVariantAttributeCombinationId">Varyant</label>
                            <select id="ProductVariantAttributeCombinationId" name="ProductVariantAttributeCombinationId" class="select2 form-select"></select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                    <button type="submit" class="btn btn-warning">Eşleştir</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="OrderPrintModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-header">
                <h5 class="modal-title" id="OrderPrintModalLabel">Etiketi yazdır</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                <button type="button" class="btn btn-warning proudctintegration-save">Yazdır</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="orderAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" id="orderAddressModalContent">
        </div>
    </div>
</div>

<div class="modal fade" id="invoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow-lg" id="invoiceModalContent">
        </div>
    </div>
</div>



<!-- Kargo Firması Değiştir Butonu -->
<div class="modal fade" id="changeCargoModal" tabindex="-1" aria-labelledby="changeCargoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="changeCargoModalLabel">Paket Kargo Firması Değiştirme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="shipmentPackageNumber">

                <p class="text-muted mb-3">Paketi hangi firma ile göndermek istiyorsunuz?</p>

                <h6 class="fw-semibold mb-3 text-primary">Standart Kargo Firmaları (0–30 desi)</h6>
                <div class="row row-cols-2 row-cols-md-3 g-3">
                    <div class="col">
                        <input type="radio" class="btn-check" name="cargoProvider" id="YKMP" value="YKMP" autocomplete="off">
                        <label class="btn btn-outline-secondary w-100" for="YKMP">
                            <img src="https://cdn.dsmcdn.com/seller-center/oms/nexus/cargo-provider/4.png" class="img-fluid mb-2" style="height:24px">
                        </label>
                    </div>
                    <div class="col">
                        <input type="radio" class="btn-check" name="cargoProvider" id="SURATMP" value="SURATMP" autocomplete="off">
                        <label class="btn btn-outline-secondary w-100" for="SURATMP">
                            <img src="https://cdn.dsmcdn.com/seller-center/oms/nexus/cargo-provider/9.png" class="img-fluid mb-2" style="height:24px">
                        </label>
                    </div>
                    <div class="col">
                        <input type="radio" class="btn-check" name="cargoProvider" id="PTTMP" value="PTTMP" autocomplete="off">
                        <label class="btn btn-outline-secondary w-100" for="PTTMP">
                            <img src="https://cdn.dsmcdn.com/seller-center/oms/nexus/cargo-provider/19.png" class="img-fluid mb-2" style="height:24px">
                        </label>
                    </div>
                    <div class="col">
                        <input type="radio" class="btn-check" name="cargoProvider" id="KOLAYGELSIN" value="SENDEOMP" autocomplete="off">
                        <label class="btn btn-outline-secondary w-100" for="KOLAYGELSIN">
                            <img src="https://cdn.dsmcdn.com/seller-center/oms/nexus/cargo-provider/38.png" class="img-fluid mb-2" style="height:24px">
                        </label>
                    </div>
                    <div class="col">
                        <input type="radio" class="btn-check" name="cargoProvider" id="ARASMP" value="ARASMP" autocomplete="off">
                        <label class="btn btn-outline-secondary w-100" for="ARASMP">
                            <img src="https://cdn.dsmcdn.com/seller-center/oms/nexus/cargo-provider/7.png" class="img-fluid mb-2" style="height:24px">
                        </label>
                    </div>
                    <div class="col">
                        <input type="radio" class="btn-check" name="cargoProvider" id="MNG" value="MNGMP" autocomplete="off">
                        <label class="btn btn-outline-secondary w-100" for="MNG">
                            <img src="https://cdn.dsmcdn.com/seller-center/oms/nexus/cargo-provider/10.png" class="img-fluid mb-2" style="height:24px">
                        </label>
                    </div>
                </div>

                <hr class="my-4">
                <h6 class="fw-semibold mb-3 text-danger">Ağır & Hacimli Kargo Firmaları (30+ desi)</h6>
                <div class="row row-cols-2 row-cols-md-3 g-3">
                    <div class="col">
                        <input type="radio" class="btn-check" name="cargoProvider" id="HOROZMP" value="HOROZMP" autocomplete="off">
                        <label class="btn btn-outline-secondary w-100" for="HOROZMP">
                            <img src="https://cdn.dsmcdn.com/seller-center/oms/nexus/cargo-provider/6.png" class="img-fluid mb-2" style="height:24px">
                        </label>
                    </div>
                    <div class="col">
                        <input type="radio" class="btn-check" name="cargoProvider" id="BORMP" value="BORMP" autocomplete="off">
                        <label class="btn btn-outline-secondary w-100" for="BORMP">
                            <img src="https://cdn.dsmcdn.com/seller-center/oms/nexus/cargo-provider/30.png" class="img-fluid mb-2" style="height:24px">
                        </label>
                    </div>
                    <div class="col">
                        <input type="radio" class="btn-check" name="cargoProvider" id="CEVAMP" value="CEVAMP" autocomplete="off">
                        <label class="btn btn-outline-secondary w-100" for="CEVAMP">
                            <img src="https://cdn.dsmcdn.com/seller-center/oms/nexus/cargo-provider/20.png" class="img-fluid mb-2" style="height:24px">
                        </label>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" id="changeCargoBtn" class="btn btn-success">İşlemi Yap</button>
            </div>
        </div>
    </div>
</div>




@section Scripts {
    <script src="/assets/js/entegro.order.list.js" asp-append-version="true"></script>
    <script>
        $(function () {

            var orderStatusId = @((ViewBag.OrderStatusId ?? 1));
            Entegro.order.OrderList.initTab(orderStatusId);
            Entegro.order.OrderList.submitChangeCargoForm();


        });
    </script>

    <script>
        $(document).ready(function () {

            $("#filterStartDate").on("change", function () {
                const startDate = $(this).val();
                if (startDate) {

                    $("#filterEndDate").attr("min", startDate);

                    const endDate = $("#filterEndDate").val();
                    if (endDate && endDate < startDate) {
                        $("#filterEndDate").val("");
                    }
                } else {

                    $("#filterEndDate").removeAttr("min");
                }
            });

            // Filtrele butonu
            $(document).off("click", "#btnFilter").on("click", "#btnFilter", function () {
                const table = $('#OrderTable').DataTable();
                table.ajax.reload();
            });

            // Temizle butonu
            $(document).off("click", "#btnClear").on("click", "#btnClear", function () {
                // Tüm filtre inputlarını temizle
                $("#filterCustomerName").val("");
                $("#filterOrderNo").val("");
                $("#filterPackageNo").val("");
                $("#filterBarcode").val("");
                $("#filterCargoCode").val("");
                $("#filterProduct").val("");
                $("#filterStartDate").val("");
                $("#filterEndDate").val("");
                $("#filterEndDate").removeAttr("min"); // min değerini sıfırla

                const table = $('#OrderTable').DataTable();
                table.ajax.reload();
            });
        });
    </script>

}
