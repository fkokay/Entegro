@{
    ViewData["Title"] = "Siparişler";
}

<div class="flex-grow-1 container-p-y container-fluid">
   <div class="card">
        <div class="order-actions border-bottom p-4 d-flex">
            <button class="btn">Paketlenecek</button>
            <div class="split"></div>
            <button class="btn">Gönderime Hazır</button>
            <div class="split"></div>
            <button class="btn">Kargoda</button>
            <div class="split"></div>
            <button class="btn">Teslim Edildi</button>
            <div class="split"></div>
            <button class="btn">Teslim Edilemedi</button>
            <div class="split"></div>
            <button class="btn">Ödemesi Bekleniyor</button>
            <div class="split"></div>
            <button class="btn">İptal Edildi</button>
       </div>
       <div class="p-5">
            <div class="row">
                <div class="col-2 mb-2">
                    <input type="text" class="form-control" placeholder="Müşteri Adı" />
                </div>
                <div class="col-2 mb-2">
                    <input type="text" class="form-control" placeholder="Sipariş No" />
                </div>
                <div class="col-2 mb-2">
                    <input type="text" class="form-control" placeholder="Paket No" />
                </div>
                <div class="col-2 mb-2">
                    <input type="text" class="form-control" placeholder="Barkod" />
                </div>
                <div class="col-2 mb-2">
                    <input type="text" class="form-control" placeholder="Kargo Kodu" />
                </div>
                <div class="col-2 mb-2">
                    <input type="text" class="form-control" placeholder="Sipariş Başlangıç Tarihi" />
                </div>
                <div class="col-2 mb-2">
                    <input type="text" class="form-control" placeholder="Sipariş Bitiş Tarihi" />
                </div>
                <div class="col-2 mb-2">
                    <input type="text" class="form-control" placeholder="Ürün Adı/Model Kodu" />
                </div>
            </div>
       </div>
   </div>
</div>

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="card">
        <div class="row card-header flex-column flex-md-row border-bottom mx-0 px-3">
            <div class="d-md-flex justify-content-between align-items-center dt-layout-start col-md-auto me-auto mt-0">
                <h5 class="card-title mb-0 text-md-start text-center pb-md-0 pb-6">Siparişler</h5>
            </div>
            <div class="d-md-flex justify-content-between align-items-center dt-layout-end col-md-auto ms-auto mt-0">
               
            </div>
        </div>

        <div class="card-datatable table-responsive">
            <table id="OrderTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                <thead>
                    <tr>
                        <th></th> 
                        <th>Id</th> 
                        <th>Sipariş Kaynağı</th>
                        <th>Sipariş Bilgileri</th>
                        <th>Alıcı</th>
                        <th>Bilgiler</th>
                        <th>Kargo Bilgileri</th>
                        <th>Fatura Bilgileri</th>
                        <th>Ödeme Bilgileri</th>
                        <th></th> 
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>


@section Scripts {
    <script src="/assets/js/entegro.order.list.js" asp-append-version="true"></script>
    <script>
        $(function () {
            Entegro.order.OrderList.init();
        });

    </script>
}
