@model OrderListModel
@{
    ViewData["Title"] = "Siparişler";
}
<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>
    <div class="card">
        <div class="order-actions border-bottom p-4 d-flex">
            <button class="btn active" data-order-status="1">Paketlenecek <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.ToBePackedQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="2">Gönderime Hazır <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.ToBePackedQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="3">Kargoda <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.ShippedQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="4">Teslim Edildi <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.DeliveredQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="5">Teslim Edilemedi <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.UnDeliverdQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="6">Ödemesi Bekleniyor <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.PaymentAwaitingQuantity</span></button>
            <div class="split"></div>
            <button class="btn" data-order-status="7">İptal Edildi <span class="badge badge-center rounded-pill badge-outline-secondary ms-4">@Model.CancalledQuantity</span></button>
        </div>
        <div class="p-5">
            <div class="row">
                <div class="row">
                    <div class="col-2 mb-2">
                        <input type="text" class="form-control" id="filterCustomerName" placeholder="Müşteri Adı" />
                    </div>
                    <div class="col-2 mb-2">
                        <input type="text" class="form-control" id="filterOrderNo" placeholder="Sipariş No" />
                    </div>
                    <div class="col-2 mb-2">
                        <input type="text" class="form-control" id="filterPackageNo" placeholder="Paket No" />
                    </div>
                    <div class="col-2 mb-2">
                        <input type="text" class="form-control" id="filterBarcode" placeholder="Barkod" />
                    </div>
                    <div class="col-2 mb-2">
                        <input type="text" class="form-control" id="filterCargoCode" placeholder="Kargo Kodu" />
                    </div>
                    <div class="col-2 mb-2">
                        <input type="text" class="form-control" id="filterStartDate" placeholder="Sipariş Başlangıç Tarihi" />
                    </div>
                    <div class="col-2 mb-2">
                        <input type="text" class="form-control" id="filterEndDate" placeholder="Sipariş Bitiş Tarihi" />
                    </div>
                    <div class="col-2 mb-2">
                        <input type="text" class="form-control" id="filterProduct" placeholder="Ürün Adı/Model Kodu" />
                    </div>
                    <div class="col-2">
                        <button id="btnFilter" class="btn btn-primary w-100">Filtrele</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-datatable table-responsive border-top">
            <table id="OrderTable" class="dt-fixedheader table table-bordered dataTable dtr-column">
                <thead>
                    <tr>
                        <th></th>
                        <th>Id</th>
                        <th>Sipariş Kaynağı</th>
                        <th>Sipariş Bilgileri</th>
                        <th>Alıcı</th>
                        <th>Bilgiler</th>
                        <th>Kargo</th>
                        <th>Fatura</th>
                        <th>Ödeme</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="OrderPackageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-header">
                <h5 class="modal-title" id="OrderPackageModalLabel">Paket Hazırlama</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                <button type="button" class="btn btn-warning orderpackage-save">Paketi Onayla</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ProudctIntegrationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <form asp-action="/Order/CreateProductIntegration" method="post" id="CreateProductIntegrationForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="ProudctIntegrationModalLabel">Ürün Eşleştirme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-5">
                        <input type="hidden" id="IntegrationSystemId" name="IntegrationSystemId" />
                        <input type="hidden" id="OrderItemId" name="OrderItemId" />
                        <input type="hidden" id="IntegrationCode" name="IntegrationCode" />
                        <!-- Kategori Seçimi -->
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductIntegrationName">Trendyol Ürün Adı</label>
                            <input type="text" id="ProductIntegrationName" name="ProductIntegrationName" class="form-control" disabled />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductIntegrationSku">Trendyol Ürün Kodu</label>
                            <input type="text" id="ProductIntegrationSku" name="ProductIntegrationSku" class="form-control" disabled />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-sm-start" for="ProductId">Ürün</label>
                            <select id="ProductId" name="ProductId" class="select2 form-select"></select>
                        </div>
                        <div id="ProductVariantAttributeCombination" class="col-md-12" style="display:none;">
                            <label class="form-label text-sm-start" for="ProductVariantAttributeCombinationId">Varyant</label>
                            <select id="ProductVariantAttributeCombinationId" name="ProductVariantAttributeCombinationId" class="select2 form-select"></select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                    <button type="submit" class="btn btn-warning">Eşleştir</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="OrderPrintModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-header">
                <h5 class="modal-title" id="OrderPrintModalLabel">Etiketi yazdır</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Kapat">Vazgeç</button>
                <button type="button" class="btn btn-warning proudctintegration-save">Yazdır</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/assets/js/entegro.order.list.js" asp-append-version="true"></script>
    <script>
        $(function () {

            var orderStatusId = @((ViewBag.OrderStatusId ?? 1));
            Entegro.order.OrderList.initTab(orderStatusId);

        });
    </script>

    <script>
        $(document).off("click", "#btnFilter").on("click", "#btnFilter", function () {
            const table = $('#OrderTable').DataTable();

           
            const filters = {
                "Customer.Name": $("#filterCustomerName").val() || "",
                "OrderNo": $("#filterOrderNo").val() || "",
                "PackageNo": $("#filterPackageNo").val() || "",
                "Barcode": $("#filterBarcode").val() || "",
                "CargoCode": $("#filterCargoCode").val() || "",
                "StartDate": $("#filterStartDate").val() || "",
                "EndDate": $("#filterEndDate").val() || "",
                "ProductName": $("#filterProduct").val() || ""
            };

            table.columns().every(function () {
                const column = this;
                const columnName = column.dataSrc();

                if (filters[columnName] !== undefined) {
                    column.search(filters[columnName], false, false);
                }
            });
            table.draw();
        });
    </script>

}
