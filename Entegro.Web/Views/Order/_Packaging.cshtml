@model OrderViewModel

<form id="PackagingForm" action="/Order/PackagingSave" method="post">
    <div class="row g-3 mb-5">
        <!-- Kategori Seçimi -->
        <div class="col-md-12">
            <div class="row">
                <label class="col-sm-3 col-form-label text-sm-start" for="ShippingMethod">Kargo Firması</label>
                <div class="col-sm-9">
                    <input type="text" name="Carrier" value="@Model.ShippingMethod" class="form-control" />
                </div>
            </div>
        </div>
    </div>
    <div class="packaging">
        @{
            int index = 0;
            foreach (var item in Model.OrderItems)
            {
                <input type="hidden" name="OrderPackages[@index].OrderId" value="@item.OrderId" />
                <input type="hidden" name="OrderPackages[@index].OrderItemId" value="@item.Id" />
                <input type="hidden" name="OrderPackages[@index].IsPackage" value="true" />
                <div class="packaging-items">
                    <div class="packaging-items-checkbox">
                        <div class="form-check form-check-lg mt-4">
                            <input class="form-check-input" type="checkbox" value="" id="defaultCheck1">
                        </div>
                    </div>
                    <div>
                        <div class="d-flex mb-4 packaging-item-management">
                            <button class="btn btn-outline-secondary waves-effect package-remove" disabled>Paketten Çıkar</button>
                            <div class="split"></div>
                            <div class="d-flex align-items-center me-4">
                                <span class="me-2">Gönderim Adedi :</span>

                                <div class="quantity-change-action">
                                    <input type="hidden" name="OrderPackages[@index].Quantity" value="@item.Quantity" />
                                    <button class="btn-minus" @(item.Quantity > 1 ? "" : "disabled") type="button"></button>
                                    <span data-max-quantity="@item.Quantity">@item.Quantity</span>
                                    <button class="btn-plus" disabled type="button"></button>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex">
                            <div class="position-relative">
                                <img src="@item.Product.PictureUrl" class="packaging-item-image" />
                                <span class="badge-quantity">@item.Quantity</span>
                            </div>
                            <div class="packaging-item-details">
                                <div class="packaging-item-name">@item.Product.Name</div>
                                <div class="packaging-item-info d-flex">
                                    <div>
                                        <div class="packaging-item-info-title">Stok Kodu</div>
                                        <div class="packaging-item-info-value">@item.Product.Code</div>
                                    </div>
                                    <div>
                                        <div class="packaging-item-info-title">Satış Fiyatı</div>
                                        <div class="packaging-item-info-value">@item.UnitPrice.ToString("n2") TL</div>
                                    </div>
                                    <div>
                                        <div class="packaging-item-info-title">Liste Fiyatı</div>
                                        <div class="packaging-item-info-value">@item.Product.Price.ToString("n2") TL</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                index++;
            }
        }
    </div>
</form>