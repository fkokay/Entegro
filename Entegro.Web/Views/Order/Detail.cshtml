@model OrderViewModel
@{
    ViewData["Title"] = "Detail";
}

<div class="container-fluid flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Siparş Detayları /</span> Sipariş #@Model.OrderNumber</h4>
    <div class="row">
        <div class="col-xl-9 col-lg-7 col-md-7 order-1 order-md-0">
            <div class="card mb-4">
                <h5 class="card-header">Sipariş Detayları</h5>
                <div class="table-responsive text-nowrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>Birim Fiyat</th>
                                <th>Miktar</th>
                                <th>İndirim</th>
                                <th>KDV Oranı</th>
                                <th>Fiyat</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex justify-content-start align-items-center product-name">
                                            <div class="avatar-wrapper">
                                                <div class="avatar me-2 me-sm-4 rounded-2 bg-label-secondary">
                                                    <img src="@item.Product?.PictureUrl?" class="rounded">
                                                </div>
                                            </div>
                                            <div class="d-flex flex-column">
                                                <h6 class="text-nowrap mb-0">@item.Product?.Name</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.UnitPrice ₺</td>
                                    <td>
                                        @item.Quantity
                                    </td>
                                    <td>@item.DiscountAmount</td>
                                    <td>@item.TaxRate</td>
                                    <td>@item.Price ₺</td>
                                </tr>

                            }


                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" class="text-end"><strong>Toplam Tutar:</strong></td>
                                <td colspan="2"><strong>@Model.CalculateTotalAmount ₺</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <!-- /Project table -->
            <!-- Activity Timeline -->

            <div class="card mb-4">
                <h5 class="card-header">Sipariş Notları</h5>
                <div class="card-body pb-0">
                    <ul class="timeline mb-0">
                        @if (Model.OrderNotes.Any())
                        {
                            @foreach (var note in Model.OrderNotes)
                            {
                                <li class="timeline-item timeline-item-transparent">
                                    <span class="timeline-point timeline-point-primary"></span>
                                    <div class="timeline-event">
                                        <div class="timeline-header mb-1">
                                            <h6 class="mb-0">@note.Note</h6>
                                            <small class="text-muted">@note.CreatedOnUtc</small>
                                        </div>
                                    </div>
                                </li>

                            }
                        }
                        else
                        {
                            <li class="timeline-item timeline-item-transparent">
                                <span class="timeline-point timeline-point-primary"></span>
                                <div class="timeline-event">
                                    <div class="timeline-header mb-1">
                                        <small class="text-muted">Sipariş Notu Yok</small>
                                    </div>
                                </div>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-5 col-md-5 order-0 order-md-1">
            <!-- User Card -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="user-avatar-section">
                        <div class="d-flex justify-content-start align-items-center">
                           
                        </div>
                        <div class="d-flex align-items-center flex-column">
                            <div class="avatar-wrapper">
                                <div class="avatar avatar-lg me-2">
                                    <span class="avatar-initial rounded-circle bg-label-info">@Model.Customer.Name.Substring(0, 1)</span>
                                </div>
                            </div>
                           @*  <img class="img-fluid rounded mb-3 pt-1 mt-4"
                                 src="~/assets/img/avatars/15.png"
                                 height="100"
                                 width="100"
                                 alt="User avatar" /> *@
                            <div class="user-info text-center">
                                <h4 class="mb-2">@Model.Customer.Name</h4>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-center flex-wrap mt-3 pt-3 pb-4 border-bottom">
                        <div class="d-flex align-items-start me-4 mt-3 gap-2">
                            <span class="badge bg-label-success p-2 rounded"><i class="ti ti-basket ti-sm"></i></span>
                            <div>
                                <p class="mb-0 fw-semibold">@Model.OrderItems.Count() Sipariş</p>
                                <small>Alındı</small>
                            </div>
                        </div>
                    </div>
                    <p class="mt-4 small text-uppercase text-muted">İletişim</p>
                    <div class="info-container">
                        <ul class="list-unstyled">
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Email:</span>
                                <span>@Model.Customer.Email</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Telefon:</span>
                                <span>@Model.Customer.PhoneNumber</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>


            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="badge bg-label-primary">Sipariş Adresi</span>
                    </div>
                    <div class="info-container mt-3">
                        <ul class="list-unstyled">
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Ad Soyad:</span>
                                <span>@Model.ShippingAddress?.FirstName @Model.ShippingAddress?.LastName</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Telefon:</span>
                                <span>@Model.ShippingAddress?.PhoneNumber</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Şirket Adı:</span>
                                <span>@Model.ShippingAddress?.Company</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Adres 1:</span>
                                <span>@Model.ShippingAddress?.Address1</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Adres 2:</span>
                                <span>@Model.ShippingAddress?.Address2</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Telefon Numarası:</span>
                                <span>@Model.ShippingAddress?.PhoneNumber</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Vergi Dairesi:</span>
                                <span>@Model.ShippingAddress?.TaxOffice</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Vergi Daire Numarası:</span>
                                <span>@Model.ShippingAddress?.TaxOfficeNumber</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Posta Kodu:</span>
                                <span>@Model.ShippingAddress?.ZipPostalCode</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="badge bg-label-primary">Fatura Adresi</span>
                    </div>

                    <div class="info-container mt-3">
                        <ul class="list-unstyled">
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Ad Soyad:</span>
                                <span>@Model.BillingAddress?.FirstName @Model.BillingAddress?.LastName</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Telefon:</span>
                                <span>@Model.BillingAddress?.PhoneNumber</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Şirket Adı:</span>
                                <span>@Model.BillingAddress?.Company</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Adres 1:</span>
                                <span>@Model.BillingAddress?.Address1</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Adres 2:</span>
                                <span>@Model.BillingAddress?.Address2</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Telefon Numarası:</span>
                                <span>@Model.BillingAddress?.PhoneNumber</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Vergi Dairesi:</span>
                                <span>@Model.BillingAddress?.TaxOffice</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Vergi Daire Numarası:</span>
                                <span>@Model.BillingAddress?.TaxOfficeNumber</span>
                            </li>
                            <li class="mb-2 pt-1">
                                <span class="fw-semibold me-1">Posta Kodu:</span>
                                <span>@Model.BillingAddress?.ZipPostalCode</span>
                            </li>
                        </ul>
                    </div>
                   

                </div>
            </div>
        </div>
    </div>
</div>

