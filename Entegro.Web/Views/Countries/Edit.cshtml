@model CountryModel
@{
    ViewData["Title"] = "Ülke Bilgilerini Düzenle - " + Model.Name;
}

<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="Edit" id="country-form">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-6 row-gap-4">
            <div class="d-flex flex-column justify-content-center">
                <h4 class="mb-1">Ülke bilgilerini düzenle</h4>
                <p class="mb-0">Ülke bilgilerini düzenle</p>
            </div>
            <div class="d-flex align-content-center flex-wrap gap-4">
                <div class="d-flex gap-4">
                    <a href="@Url.Action("List")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-circle-x ti-xs me-1"></i> Vazgeç
                        </span>
                    </a>
                    <button type="button" id="btnDeleteCountry" data-id="@Model.Id" class="btn btn-danger d-grid w-100 waves-effect waves-light">
                        <span class="d-flex justify-content-center text-nowrap">
                            <i class="ti ti-trash ti-xs me-1"></i> Sil
                        </span>
                    </button>
                </div>
                <button type="submit" class="btn btn-primary waves-effect waves-light">
                    <span class="d-flex justify-content-center text-nowrap">
                        <i class="ti ti-device-floppy ti-xs me-1"></i> Kaydet
                    </span>
                </button>
            </div>
        </div>
        <div class="row">
            <partial name="_CreateOrUpdate" />
        </div>
    </form>
</div>

<div class="modal fade" id="viewTownsModal" tabindex="-1" aria-labelledby="viewTownsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3 class="mb-2" id="viewTownsModalLabel">İlçeler</h3>
                </div>
            </div>
            <div class="modal-body">
                <div id="townsModalContent">
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Yükleniyor...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="createOrUpdateTownModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Modal Header -->
            <div class="modal-header p-0 position-relative" style="height: 80px;">
                <div class="d-flex justify-content-center align-items-center w-100 h-100">
                    <h5 class="modal-title m-0">İlçe Bilgileri</h5>
                </div>
              
            </div>

            <div class="modal-body px-4 py-4" id="createOrUpdateTownModalBody">
                <!-- Form buraya yüklenecek -->
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="createOrUpdateCityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Modal Header -->
            <div class="modal-header p-0 position-relative" style="height: 80px;">
                <div class="d-flex justify-content-center align-items-center w-100 h-100">
                    <h5 class="modal-title m-0">Şehir Bilgileri</h5>
                </div>
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-4 py-4" id="createOrUpdateCityModalBody">
               
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="createOrUpdateDistrictModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <!-- Modal Header -->
            <div class="modal-header p-0 position-relative" style="height: 80px;">
                <div class="d-flex justify-content-center align-items-center w-100 h-100">
                    <h5 class="modal-title m-0">Mahalle Bilgileri</h5>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-4 py-4" id="createOrUpdateDistrictModalBody">
                <!-- Form buraya yüklenecek -->
            </div>
        </div>
    </div>
</div>



@section Scripts {

    <script src="/assets/js/entegro.country.js" asp-append-version="true"></script>
    <script>
        $(function () {
             Entegro.country.initValidation('#country-form', {
                url: '@Url.Action("Edit", "Countries")',
                successRedirect: '@Url.Action("List", "Countries")',
                successMessage: 'Ülke başarıyla güncellendi.'
            });

            Entegro.country.initDelete('#btnDeleteCountry',
                '@Url.Action("Delete", "Countries")',
                '@Url.Action("List", "Countries")',
                '@Model.Id'
            );

            Entegro.country.initIsPublishedCheckbox();
            Entegro.country.initCityDelete('.delete-city-button');
            Entegro.country.initTownViewModal('#viewTownsModal', '#townsModalContent');
            Entegro.country.initTownDeleteInModal('#viewTownsModal');
            Entegro.country.initTownCreateOrUpdateInModal('#createOrUpdateTownModal');
            Entegro.country.initCityCreateOrUpdateInModal('#createOrUpdateCityModal');
            Entegro.country.initDistrictCreateOrUpdateInModal('#createOrUpdateDistrictModal');
        });
    </script>



}