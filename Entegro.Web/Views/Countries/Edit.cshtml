@model CountryModel
@{
    ViewData["Title"] = "Ülke Bilgilerini Düzenle - " + Model.Name;
}

<div class="container-fluid flex-grow-1 container-p-y">
    <form asp-action="Edit" id="country-form">
        <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Ayarlar/</span><span class="text-muted fw-light">Ülkeler /</span> Ülke Bilgilerini Düzenle</h4>

        <div class="row">
            <partial name="_CreateOrUpdate" />
            <div class="col-lg-3 col-12 invoice-actions">
                <div class="card mb-4">
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary d-grid w-100 mb-2 waves-effect waves-light">
                            <span class="d-flex align-items-center justify-content-center text-nowrap"><i class="ti ti-check ti-xs me-1"></i>Kaydet</span>
                        </button>
                        @if (Model.Id > 0)
                        {
                            <button type="button"
                                    id="btnDeleteCountry"
                                    data-id="@Model.Id"
                                    class="btn btn-danger d-grid w-100 mb-2 waves-effect waves-light">
                                <span class="d-flex align-items-center justify-content-center text-nowrap">
                                    <i class="ti ti-trash ti-xs me-1"></i>Sil
                                </span>
                            </button>
                        }
                        <a href="@Url.Action("List")" class="btn btn-label-secondary d-grid w-100 waves-effect">
                            <span class="d-flex align-items-center justify-content-center text-nowrap"><i class="ti ti-cancel ti-xs me-1"></i>Vazgeç</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>


<div class="modal fade" id="viewTownsModal" tabindex="-1" aria-labelledby="viewTownsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3 class="mb-2" id="viewTownsModalLabel">İlçeler</h3>
                </div>
                <div id="townsModalContent">
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Yükleniyor...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="createOrUpdateTownModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="createOrUpdateCityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-simple modal-edit-user modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script src="/assets/js/entegro.country.js" asp-append-version="true"></script>
    <script>
        $(function () {
             Entegro.country.initValidation('#country-form', {
                url: '@Url.Action("Edit", "Countries")',
                successRedirect: '@Url.Action("List", "Countries")',
                successMessage: 'Ülke başarıyla güncellendi.'
            });

            Entegro.country.initDelete('#btnDeleteCountry',
                '@Url.Action("Delete", "Countries")',
                '@Url.Action("List", "Countries")',
                '@Model.Id'
            );

            Entegro.country.initIsPublishedCheckbox();
            Entegro.country.initCityDelete('.delete-city-button');
            Entegro.country.initTownViewModal('#viewTownsModal', '#townsModalContent');
            Entegro.country.initTownDeleteInModal('#viewTownsModal');
            Entegro.country.initTownCreateOrUpdateInModal('#createOrUpdateTownModal');
            Entegro.country.initCityCreateOrUpdateInModal('#createOrUpdateCityModal');
        });
    </script>



}