@model CountryModel

@Html.HiddenFor(m => m.Id)

<div class="col-lg-9 col-12 mb-lg-0 mb-4">
    <div class="card mb-3">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#form-tabs-general" role="tab" aria-selected="true">
                        Genel
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#form-tabs-city" role="tab" aria-selected="false" tabindex="-1">
                        Şehirler
                    </button>
                </li>
            </ul>
        </div>
        <div class="tab-content">
            <div class="tab-pane fade active show" id="form-tabs-general" role="tabpanel">
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="row">
                            <label class="col-sm-3 col-form-label text-sm-start" for="formtabs-first-name">Ad</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control",@required="required" })
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="row">
                            <label class="col-sm-3 col-form-label text-sm-start" for="formtabs-first-name">Sıra</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", @type = "number", min = "0" })
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="row">
                            <label class="col-sm-3 col-form-label text-sm-start" for="Published">Yayınlandı</label>
                            <div class="col-sm-9">
                                <label class="switch switch-lg">
                                    @Html.CheckBoxFor(m => m.Published, new { @class = "switch-input" })
                                    <span class="switch-toggle-slider">
                                        <span class="switch-on"></span>
                                        <span class="switch-off"></span>
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="form-tabs-city" role="tabpanel">

               
                @if (Model.Id>0)
                {
                    <div class="row g-3 p-3">
                        <div class="col-12">
                            <div class="card">
                                <h5 class="card-header">Şehirler</h5>
                                <div class="table-responsive text-nowrap">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Şehir Adı</th>
                                                <th>Yayınlandı</th>
                                                <th>İşlemler</th>
                                                <th>Diğer İşlemler</th>
                                            </tr>
                                        </thead>
                                        <tbody class="table-border-bottom-0">
                                            @foreach (var city in Model.Cities)
                                            {
                                                <tr>
                                                    <td>@city.Id</td>
                                                    <td>@city.Name</td>
                                                    <td class="@(city.Published ? "text-success" : "text-danger")">
                                                        @(city.Published ? "Yayında" : "Yayında Değil")
                                                    </td>
                                                    <td>
                                                        <button type="button"
                                                                class="btn btn-sm btn-primary btn-createorupdate-city"
                                                                data-city-id="@city.Id"
                                                                data-createorupdate-url="@Url.Action("CreateOrUpdateCity", "City", new { id = city.Id, countryId = Model.Id })"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#createOrUpdateCityModal">
                                                            <span class="d-flex justify-content-center text-nowrap">
                                                                <i class="ti ti-edit ti-xs me-1"></i> Güncelle
                                                            </span>
                                                        </button>

                                                        <button type="button"
                                                                class="btn btn-danger delete-city-button btn-sm"
                                                                data-city-id="@city.Id"
                                                                data-delete-url="@Url.Action("DeleteCity", "City")">
                                                            <span class="d-flex justify-content-center text-nowrap">
                                                                <i class="ti ti-trash ti-xs me-1"></i> Sil
                                                            </span>
                                                        </button>
                                                    </td>
                                                    <td>
                                                        <button type="button"
                                                                class="btn btn-sm btn-warning btn-createorupdate-town"
                                                                data-town-id="0"
                                                                data-createorupdate-url="@Url.Action("CreateOrUpdateTown", "Town", new { id = 0, cityId = city.Id })"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#createOrUpdateTownModal">
                                                            <span class="d-flex justify-content-center text-nowrap">
                                                                <i class="ti ti-plus ti-xs me-1"></i> İlçe Ekle
                                                            </span>
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-info view-towns-button btn-sm"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#viewTownsModal"
                                                                data-city-id="@city.Id"
                                                                data-url="@Url.Action("GetTowns", "Town", new { cityId = city.Id })">
                                                            <span class="d-flex justify-content-center text-nowrap">
                                                                <i class="ti ti-eye ti-xs me-1"></i> İlçeleri Gör
                                                            </span>
                                                        </button>
                                                    </td>

                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="text-end mt-3">
                                <button type="button"
                                        class="btn btn-sm btn-warning btn-createorupdate-city"
                                        data-city-id="0"
                                        data-createorupdate-url="@Url.Action("CreateOrUpdateCity", "City", new { id = 0, countryId = Model.Id })"
                                        data-bs-toggle="modal"
                                        data-bs-target="#createOrUpdateCityModal">
                                    <span class="d-flex justify-content-center text-nowrap">
                                        <i class="ti ti-plus ti-xs me-1"></i> Şehir Ekle
                                    </span>
                                </button>

                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        Bu ülkeye şehir eklemek için önce ülkeyi kaydetmeniz gerekmektedir.
                    </div>
                }
            </div>
        </div>
    </div>
</div>


