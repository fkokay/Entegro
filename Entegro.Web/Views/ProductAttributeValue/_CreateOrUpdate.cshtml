@model ProductAttributeValueModel


<form id="ProductAttributeValueForm" class="row g-3" onsubmit="return false;">
    @Html.HiddenFor(m => m.Id)

    <!-- ProductAttributeId -->
    <div class="col-12 mb-3">
        <label class="form-label" for="ProductAttributeId">Varyant Adı <span class="text-danger">*</span></label>
        <select asp-for="ProductAttributeId" asp-items="ViewBag.ProductAttributes" class="form-select">
            <option value="">Lütfen bir varyant seçiniz</option>
        </select>
    </div>

    <!-- Name -->
    <div class="col-12 mb-3">
        <label class="form-label" for="Name">
            Ad <span class="text-danger">*</span>
        </label>
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Örn: Renk" })
    </div>

    <!-- DisplayOrder -->
    <div class="col-12 mb-3">
        <label class="form-label" for="DisplayOrder">
            Gösterim Sırası <span class="text-danger">*</span>
        </label>
        @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", @type = "number" })
    </div>

    <div class="col-12 text-center">
        <button type="submit" class="btn btn-primary me-sm-3 me-1">Kaydet</button>
        <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="modal">Vazgeç</button>
    </div>
</form>

