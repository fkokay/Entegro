@model ProductAttributeValueModel


<form id="ProductAttributeValueForm" class="row g-3" onsubmit="return false;">
    @Html.HiddenFor(m => m.Id)

    <!-- ProductAttributeId -->
    <div class="col-12 mb-3">
        <label class="form-label" for="ProductAttributeId">
            Varyant Adı <span class="text-danger">*</span>
        </label>
        <select asp-for="ProductAttributeId" asp-items="ViewBag.ProductAttributes" class="form-select" required>
            <option value="">Lütfen bir varyant seçiniz</option>
        </select>
    </div>

    <!-- Name -->
    <div class="col-12 mb-3">
        <label class="form-label" for="Name">
            Ad <span class="text-danger">*</span>
        </label>
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Örn: Siyah", required = "required" })
    </div>

    <!-- DisplayOrder -->
    <div class="col-12 mb-3">
        <label class="form-label" for="DisplayOrder">
            Gösterim Sırası <span class="text-danger">*</span>
        </label>
        @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", @type = "number", required = "required" })
    </div>

    <div class="col-12 text-center">
        <button type="submit" class="btn btn-success me-sm-3 me-1">
            <i class="bi bi-check-circle me-1"></i> Kaydet
        </button>
        <button type="reset" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Vazgeç
        </button>
    </div>
</form>

