@using Entegro.Web.Models.Catalog.Attributes
@model ProductAttributeValueViewModel

<div class="col-lg-9 col-12 mb-lg-0 mb-4">
    <div class="card mb-3">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" id="attributeValue-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#attributeValue-general" type="button" role="tab">Varyant Değeri</button>
                </li>
            </ul>
        </div>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="attributeValue-general" role="tabpanel">
                <div class="row g-3 p-3">
                    @Html.HiddenFor(m => m.Id)

                    <!-- ProductAttributeId -->
                    <div class="col-md-12">
                        <div class="row">
                            <label class="col-sm-3 col-form-label text-sm-start" for="ProductAttributeId">Varyant Adı</label>
                            <div class="col-sm-9">
                                @Html.DropDownListFor(m => m.ProductAttributeId,
                                                                new SelectList(ViewBag.ProductAttributes, "Value", "Text", Model.ProductAttributeId),
                                                                "Varyant adı seçin...",
                                                                new { @class = "form-select", @id = "ProductAttributeId" })
                            </div>
                        </div>
                    </div>

                    <!-- Name -->
                    <div class="col-md-12">
                        <div class="row">
                            <label class="col-sm-3 col-form-label text-sm-start" for="Name">Değer Adı</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @id = "Name", placeholder = "Örn: Kırmızı" })
                            </div>
                        </div>
                    </div>

                    <!-- DisplayOrder -->
                    <div class="col-md-12">
                        <div class="row">
                            <label class="col-sm-3 col-form-label text-sm-start" for="DisplayOrder">Gösterim Sırası</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", @id = "DisplayOrder", type = "number", placeholder = "0" })
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
