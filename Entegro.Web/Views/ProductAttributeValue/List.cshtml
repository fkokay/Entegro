@{
    ViewData["Title"] = "Varyant Değerleri";
}

<div class="flex-grow-1 container-p-y container-fluid">
    <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-3">@ViewData["Title"]</h4>
    </div>
    <div class="card">
        <div class="card-header border-bottom">
            <h5 class="card-title">Filtreler</h5>
            <div class="d-flex justify-content-between align-items-center row pt-4 gap-6 gap-md-0 g-md-6">
                <div class="col-md-4 productFilterBrand"></div>
            </div>
        </div>
        <div class="card-datatable">
            <table id="ProductAttributeValueTable" class="table">
                <thead class="border-top">
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Varyant Adı</th>
                        <th>Değeri</th>
                        <th>Görüntüleme Sırası</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>



@await Html.PartialAsync("_ProductAttributeValueFormPartial")
@section Scripts {
    
    <script src="/assets/js/entegro.attributevalue.js"></script>
    <script src="/assets/js/entegro.attributevalue.list.js"></script>
    <script>
        $(function () {
            Entegro.AttributeValue.List.init();
            Entegro.AttributeValue.Form.init();
        });
    </script>

}
